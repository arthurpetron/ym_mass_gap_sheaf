/-
# Finite Gaussian realization of explicit rational linear coordinates

An explicit rational transform from independent finite Gaussian noise
coordinates to physical coordinates determines literal linear polynomials in
the existing `RatPoly` carrier.  This leaf proves that their second moments
under the existing finite product-Gaussian polynomial functional are exactly
the transform Gram entries.  The same statement is recorded for arbitrary
finite physical rows, and square positivity is inherited from the checked
finite Gaussian Gram theorem.

This is an algebraic polynomial-coordinate realization.  It constructs no
Lebesgue density, Jacobian, sigma algebra, probability measure, or continuum
Gaussian law, and it proves no comparison with the original interacting law.

# Axiom gate

No `Classical`, choice, `sorry`/`admit`, `native_decide`, or custom axiom.
-/

import YMGap.Continuum.SU2QuaternionFiniteGaussianCoordinatePullback
import YMGap.Continuum.Z4FiniteCylinderQuadraticStability

namespace YMGap.Continuum.SU2QuaternionFiniteGaussianLinearCoordinateRealization

set_option autoImplicit false

open YMGap.Constructive
open YMGap.Continuum.RingNormaliser
open YMGap.Continuum.SU2FiniteTrivalentPacketGraphFullSupportNorm
open YMGap.Continuum.SU2QuaternionPolynomialHaarCarrier
open YMGap.Continuum.SU2QuaternionRatPolyDifferential
open YMGap.Continuum.SU2QuaternionFiniteProductGaussianPositivity
open YMGap.Continuum.SU2QuaternionFiniteProductGaussianIBP
open YMGap.Continuum.SU2QuaternionFiniteGaussianRowGram
open YMGap.Continuum.SU2QuaternionFiniteGaussianCoordinatePullback
open YMGap.Continuum.Z4FiniteCylinderQuadraticStability

local infix:50 " ≈ " => Q'.eqv

private theorem qListSum_map_eq_listQSum {A : Type} (value : A → Q') :
    ∀ items : List A,
      qListSum (items.map value) = listQSum value items
  | [] => rfl
  | _ :: items => by
      simp only [List.map, qListSum, listQSum]
      rw [qListSum_map_eq_listQSum value items]

/-- Literal polynomial representing one physical coordinate as a finite
rational linear combination of independent noise coordinates. -/
def finiteGaussianLinearCoordinate (noiseSize : Nat)
    (transform : Nat → Nat → Q') (physicalIndex : Nat) : RatPoly :=
  finiteLinearRow noiseSize (transform physicalIndex)

/-- Literal polynomial representing an arbitrary finite physical row after
pullback through the same rational coordinate transform. -/
def finiteGaussianLinearObservable (physicalSize noiseSize : Nat)
    (transform : Nat → Nat → Q') (physicalRow : Nat → Q') : RatPoly :=
  finiteLinearRow noiseSize
    (pulledRow physicalSize transform physicalRow)

/-- Finite bilinear form generated by an explicitly supplied physical
covariance matrix. -/
def finiteMatrixBilinear (physicalSize : Nat)
    (matrix : Nat → Nat → Q') (leftRow rightRow : Nat → Q') : Q' :=
  qListSum ((List.range physicalSize).map fun left =>
    qListSum ((List.range physicalSize).map fun right =>
      (leftRow left * rightRow right) * matrix left right))

/-- Coefficient-weighted aggregate of entrywise covariance error envelopes. -/
def physicalCovarianceBilinearResidualEnvelope (physicalSize : Nat)
    (entryEnvelope : Nat → Nat → Q')
    (leftRow rightRow : Nat → Q') : Q' :=
  qListSum ((List.range physicalSize).map fun left =>
    qListSum ((List.range physicalSize).map fun right =>
      Q'.abs (leftRow left * rightRow right) * entryEnvelope left right))

/-- The scalar factor appearing in the checked three-color quadratic radial
pair covariance identity. -/
def factor6RadialPairExpression (mixed : Q') : Q' :=
  6 * (mixed * mixed)

/-- Explicit propagated error for the factor-6 quadratic radial denominator. -/
def factor6RadialPairResidualEnvelope
    (stagedMixed exactMixed mixedError : Q') : Q' :=
  6 * (Q'.abs stagedMixed * mixedError +
    Q'.abs exactMixed * mixedError)

/-- The scalar factor appearing in the checked three-color sixth-order radial
covariance identity. -/
def factor60RadialExpression (diagonal mixed : Q') : Q' :=
  60 * diagonal * (mixed * mixed)

/-- Explicit propagated error for the factor-60 radial expression. -/
def factor60RadialResidualEnvelope
    (stagedDiagonal stagedMixed exactMixed diagonalError mixedError : Q') : Q' :=
  60 *
    (Q'.abs stagedDiagonal *
        (Q'.abs stagedMixed * mixedError +
          Q'.abs exactMixed * mixedError) +
      Q'.abs (exactMixed * exactMixed) * diagonalError)

/-- Constructive product-difference bound with no sign or external magnitude
assumptions. -/
theorem rationalProductDifference_abs_le (a b c d : Q') :
    Q'.abs (a * b + -(c * d)) ≤
      Q'.abs a * Q'.abs (b + -d) +
        Q'.abs d * Q'.abs (a + -c) := by
  refine Q'.le_trans' _ _ _
    (Q'.le_of_eqv
      (ExpNeg.abs_eqv_congr (CReal.mul_sub_decomp a b c d))) ?_
  exact Q'.le_trans' _ _ _ (ExpNeg.abs_add_le _ _)
    (Q'.add_le_add
      (ExpNeg.abs_mul_le a (b + -d))
      (ExpNeg.abs_mul_le d (a + -c)))

/-- A mixed-bilinear error controls the factor-6 quadratic radial
denominator. -/
theorem factor6RadialPairExpression_error
    (stagedMixed exactMixed mixedError : Q')
    (hmixed : Q'.abs (stagedMixed + -exactMixed) ≤ mixedError) :
    Q'.abs
        (factor6RadialPairExpression stagedMixed +
          -factor6RadialPairExpression exactMixed) ≤
      factor6RadialPairResidualEnvelope stagedMixed exactMixed mixedError := by
  have hsquare :
      Q'.abs
          (stagedMixed * stagedMixed +
            -(exactMixed * exactMixed)) ≤
        Q'.abs stagedMixed * mixedError +
          Q'.abs exactMixed * mixedError := by
    refine Q'.le_trans' _ _ _
      (rationalProductDifference_abs_le
        stagedMixed stagedMixed exactMixed exactMixed) ?_
    exact Q'.add_le_add
      (Q'.mul_le_mul_of_nonneg_left _ _ (Q'.abs stagedMixed)
        hmixed (Q'.abs_nonneg stagedMixed))
      (Q'.mul_le_mul_of_nonneg_left _ _ (Q'.abs exactMixed)
        hmixed (Q'.abs_nonneg exactMixed))
  have hscale := abs_common_mul_sub_le 6
    (stagedMixed * stagedMixed) (exactMixed * exactMixed)
    (Q'.abs stagedMixed * mixedError +
      Q'.abs exactMixed * mixedError) hsquare
  refine Q'.le_trans' _ _ _ hscale ?_
  unfold factor6RadialPairResidualEnvelope
  rw [ExpNeg.abs_of_nonneg (by decide : (0 : Q') ≤ 6)]
  exact Q'.le_refl' _

/-- The factor-60 sixth-order target is ten times the diagonal covariance
times the factor-6 quadratic denominator. This is the division-free
normalization identity. -/
theorem factor60RadialExpression_eq_ten_mul_factor6
    (diagonal mixed : Q') :
    factor60RadialExpression diagonal mixed ≈
      10 * diagonal * factor6RadialPairExpression mixed := by
  unfold factor60RadialExpression factor6RadialPairExpression
  exact poly_identity_of_normal_eq
    (.mul (.mul (.const 60) (.var 0)) (.mul (.var 1) (.var 1)))
    (.mul (.mul (.const 10) (.var 0))
      (.mul (.const 6) (.mul (.var 1) (.var 1))))
    (by decide) (fun | 0 => diagonal | _ => mixed)

/-- Positive mixed covariance gives a strictly positive factor-6 denominator. -/
theorem factor6RadialPairExpression_pos
    (mixed : Q') (hmixed : (0 : Q') < mixed) :
    (0 : Q') < factor6RadialPairExpression mixed := by
  unfold factor6RadialPairExpression
  exact Q'.mul_pos (by decide) (Q'.mul_pos hmixed hmixed)

/-- A positive lower bound on the mixed covariance yields an explicit squared
floor for the factor-6 denominator. -/
theorem factor6RadialPairExpression_floor
    (mixed floor : Q') (hfloor : (0 : Q') < floor)
    (hfloorMixed : floor ≤ mixed) :
    6 * (floor * floor) ≤ factor6RadialPairExpression mixed := by
  have hmixed : (0 : Q') < mixed := Q'.pos_of_lt_of_le hfloor hfloorMixed
  have hsquare : floor * floor ≤ mixed * mixed :=
    Q'.mul_le_mul_of_nonneg hfloorMixed hfloorMixed
      (Q'.le_of_lt hmixed) (Q'.le_of_lt hfloor)
  unfold factor6RadialPairExpression
  exact Q'.mul_le_mul_of_nonneg_left _ _ 6 hsquare (by decide)

/-- Separate diagonal and mixed bilinear errors control the nonlinear
factor-60 radial expression. -/
theorem factor60RadialExpression_error
    (stagedDiagonal exactDiagonal stagedMixed exactMixed
      diagonalError mixedError : Q')
    (hdiagonal :
      Q'.abs (stagedDiagonal + -exactDiagonal) ≤ diagonalError)
    (hmixed : Q'.abs (stagedMixed + -exactMixed) ≤ mixedError) :
    Q'.abs
        (factor60RadialExpression stagedDiagonal stagedMixed +
          -factor60RadialExpression exactDiagonal exactMixed) ≤
      factor60RadialResidualEnvelope
        stagedDiagonal stagedMixed exactMixed diagonalError mixedError := by
  have hsquare :
      Q'.abs
          (stagedMixed * stagedMixed +
            -(exactMixed * exactMixed)) ≤
        Q'.abs stagedMixed * mixedError +
          Q'.abs exactMixed * mixedError := by
    refine Q'.le_trans' _ _ _
      (rationalProductDifference_abs_le
        stagedMixed stagedMixed exactMixed exactMixed) ?_
    exact Q'.add_le_add
      (Q'.mul_le_mul_of_nonneg_left _ _ (Q'.abs stagedMixed)
        hmixed (Q'.abs_nonneg stagedMixed))
      (Q'.mul_le_mul_of_nonneg_left _ _ (Q'.abs exactMixed)
        hmixed (Q'.abs_nonneg exactMixed))
  have hproduct :
      Q'.abs
          (stagedDiagonal * (stagedMixed * stagedMixed) +
            -(exactDiagonal * (exactMixed * exactMixed))) ≤
        Q'.abs stagedDiagonal *
            (Q'.abs stagedMixed * mixedError +
              Q'.abs exactMixed * mixedError) +
          Q'.abs (exactMixed * exactMixed) * diagonalError := by
    refine Q'.le_trans' _ _ _
      (rationalProductDifference_abs_le stagedDiagonal
        (stagedMixed * stagedMixed) exactDiagonal
        (exactMixed * exactMixed)) ?_
    exact Q'.add_le_add
      (Q'.mul_le_mul_of_nonneg_left _ _ (Q'.abs stagedDiagonal)
        hsquare (Q'.abs_nonneg stagedDiagonal))
      (Q'.mul_le_mul_of_nonneg_left _ _
        (Q'.abs (exactMixed * exactMixed))
        hdiagonal (Q'.abs_nonneg (exactMixed * exactMixed)))
  have hscale := abs_common_mul_sub_le 60
    (stagedDiagonal * (stagedMixed * stagedMixed))
    (exactDiagonal * (exactMixed * exactMixed))
    (Q'.abs stagedDiagonal *
        (Q'.abs stagedMixed * mixedError +
          Q'.abs exactMixed * mixedError) +
      Q'.abs (exactMixed * exactMixed) * diagonalError)
    hproduct
  have hfactor :
      factor60RadialExpression stagedDiagonal stagedMixed +
          -factor60RadialExpression exactDiagonal exactMixed ≈
        60 * (stagedDiagonal * (stagedMixed * stagedMixed)) +
          -(60 * (exactDiagonal * (exactMixed * exactMixed))) := by
    exact Q'.add_eqv_congr'
      (Q'.mul_assoc_eqv 60 stagedDiagonal (stagedMixed * stagedMixed))
      (Q'.neg_eqv_congr _ _
        (Q'.mul_assoc_eqv 60 exactDiagonal (exactMixed * exactMixed)))
  refine Q'.le_trans' _ _ _
    (Q'.le_of_eqv (ExpNeg.abs_eqv_congr hfactor)) ?_
  refine Q'.le_trans' _ _ _ hscale ?_
  unfold factor60RadialResidualEnvelope
  rw [ExpNeg.abs_of_nonneg (by decide : (0 : Q') ≤ 60)]
  exact Q'.le_refl' _

/-- The existing finite product-Gaussian functional gives the explicit
physical coordinate polynomials exactly the transform Gram covariance. -/
theorem finiteProductGaussian_linearCoordinate_pair
    (noiseSize : Nat) (transform : Nat → Nat → Q') (left right : Nat) :
    finiteProductGaussian noiseSize
        (polyMul
          (finiteGaussianLinearCoordinate noiseSize transform left)
          (finiteGaussianLinearCoordinate noiseSize transform right)) ≈
      factorCovariance noiseSize transform left right := by
  change
    finiteProductGaussian noiseSize
        (polyMul
          (finiteLinearRow noiseSize (transform left))
          (finiteLinearRow noiseSize (transform right))) ≈
      finiteRowGram noiseSize (transform left) (transform right)
  exact finiteProductGaussian_row_pair noiseSize
    (transform left) (transform right)

/-- Arbitrary finite physical rows have exactly the covariance bilinear form
induced by the same explicit transform. -/
theorem finiteProductGaussian_linearObservable_pair
    (physicalSize noiseSize : Nat) (transform : Nat → Nat → Q')
    (leftRow rightRow : Nat → Q') :
    finiteProductGaussian noiseSize
        (polyMul
          (finiteGaussianLinearObservable physicalSize noiseSize
            transform leftRow)
          (finiteGaussianLinearObservable physicalSize noiseSize
            transform rightRow)) ≈
      physicalCovarianceBilinear physicalSize noiseSize
        transform leftRow rightRow := by
  exact Q'.eqv_trans _ _ _
    (finiteProductGaussian_row_pair noiseSize
      (pulledRow physicalSize transform leftRow)
      (pulledRow physicalSize transform rightRow))
    (finiteRowGram_pulledRow physicalSize noiseSize
      transform leftRow rightRow)

/-- Entrywise covariance-factor errors propagate to the induced physical
bilinear form before any Gaussian-polynomial presentation is chosen. -/
theorem physicalCovarianceBilinear_error
    (physicalSize noiseSize : Nat) (transform : Nat → Nat → Q')
    (matrix entryEnvelope : Nat → Nat → Q')
    (leftRow rightRow : Nat → Q')
    (herror : ∀ left right,
      left < physicalSize → right < physicalSize →
      Q'.abs
          (factorCovariance noiseSize transform left right +
            -matrix left right) ≤
        entryEnvelope left right) :
    Q'.abs
        (physicalCovarianceBilinear physicalSize noiseSize
            transform leftRow rightRow +
          -finiteMatrixBilinear physicalSize matrix leftRow rightRow) ≤
      physicalCovarianceBilinearResidualEnvelope physicalSize
        entryEnvelope leftRow rightRow := by
  unfold physicalCovarianceBilinear finiteMatrixBilinear
    physicalCovarianceBilinearResidualEnvelope
  simp only [qListSum_map_eq_listQSum]
  refine Q'.le_trans' _ _ _
    (abs_listQSum_sub_le
      (fun left => listQSum
        (fun right =>
          (leftRow left * rightRow right) *
            factorCovariance noiseSize transform left right)
        (List.range physicalSize))
      (fun left => listQSum
        (fun right =>
          (leftRow left * rightRow right) * matrix left right)
        (List.range physicalSize))
      (List.range physicalSize)) ?_
  apply listQSum_mono
  intro left hleft
  refine Q'.le_trans' _ _ _
    (abs_listQSum_sub_le
      (fun right =>
        (leftRow left * rightRow right) *
          factorCovariance noiseSize transform left right)
      (fun right =>
        (leftRow left * rightRow right) * matrix left right)
      (List.range physicalSize)) ?_
  apply listQSum_mono
  intro right hright
  exact abs_common_mul_sub_le
    (leftRow left * rightRow right)
    (factorCovariance noiseSize transform left right)
    (matrix left right) (entryEnvelope left right)
    (herror left right
      (List.mem_range.mp hleft) (List.mem_range.mp hright))

/-- Pointwise covariance-factor errors propagate to the actual finite
Gaussian polynomial pair moment with the literal coefficient-weighted finite
sum of entry envelopes. -/
theorem finiteProductGaussian_linearObservable_pair_error
    (physicalSize noiseSize : Nat) (transform : Nat → Nat → Q')
    (matrix entryEnvelope : Nat → Nat → Q')
    (leftRow rightRow : Nat → Q')
    (herror : ∀ left right,
      left < physicalSize → right < physicalSize →
      Q'.abs
          (factorCovariance noiseSize transform left right +
            -matrix left right) ≤
        entryEnvelope left right) :
    Q'.abs
        (finiteProductGaussian noiseSize
            (polyMul
              (finiteGaussianLinearObservable physicalSize noiseSize
                transform leftRow)
              (finiteGaussianLinearObservable physicalSize noiseSize
                transform rightRow)) +
          -finiteMatrixBilinear physicalSize matrix leftRow rightRow) ≤
      physicalCovarianceBilinearResidualEnvelope physicalSize
        entryEnvelope leftRow rightRow := by
  have hmoment := finiteProductGaussian_linearObservable_pair
    physicalSize noiseSize transform leftRow rightRow
  refine Q'.le_trans' _ _ _
    (Q'.le_of_eqv
      (ExpNeg.abs_eqv_congr
        (Q'.add_eqv_congr_right _ _ _ hmoment))) ?_
  exact physicalCovarianceBilinear_error physicalSize noiseSize
    transform matrix entryEnvelope leftRow rightRow herror

/-- Every explicit pulled physical row is nonnegative on its literal square
under the existing finite product-Gaussian functional. -/
theorem finiteProductGaussian_linearObservable_square_nonneg
    (physicalSize noiseSize : Nat) (transform : Nat → Nat → Q')
    (physicalRow : Nat → Q') :
    (0 : Q') ≤
      finiteProductGaussian noiseSize
        (polyMul
          (finiteGaussianLinearObservable physicalSize noiseSize
            transform physicalRow)
          (finiteGaussianLinearObservable physicalSize noiseSize
            transform physicalRow)) := by
  exact finiteProductGaussian_square_nonneg noiseSize
    (finiteGaussianLinearObservable physicalSize noiseSize
      transform physicalRow)

