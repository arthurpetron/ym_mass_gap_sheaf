import YMGap.Continuum.BF4PhysicalSpinCubeOffRayResidualCompletedGap

namespace YMGap.Continuum.BF4PhysicalDynamicSpinCubeOffRayResidualFamily

set_option maxRecDepth 1000000
set_option maxHeartbeats 10000000
set_option autoImplicit false

open YMGap.Constructive
open YMGap.Continuum
open YMGap.Continuum.BF4PhysicalBoundaryCutoffTwoFullSectorDirichletGluing
open YMGap.Continuum.BF4PhysicalCutoffVacuumSectorCylinderCompletedGap
open YMGap.Continuum.BF4PhysicalDynamicVacuumRootStrengthPhysicalBand
open YMGap.Continuum.BF4PhysicalDynamicVacuumSectorCompletedFamily
open YMGap.Continuum.BF4PhysicalFiniteVacuumSectorUniformMassFloor
open YMGap.Continuum.BF4PhysicalSpinCubeOffRayResidualFlowCapacity
open YMGap.Continuum.BF4PhysicalSpinCubeOffRayResidualFrontier
open YMGap.Continuum.BF4PhysicalSpinCubeRayCofinalReturnFloor
open YMGap.Continuum.PhysicalSeparatorLinearTail
open YMGap.Continuum.PhysicalSeparatorLogRate

local infix:50 " ≈ " => Q'.eqv

/-! ## 1. The viable local analytic family -/

/-- Scale-wise local residual coercivity data.  Every field refers to the
same nome and physical spacing later used by the completed transfer. -/
structure DynamicSpinCubeOffRayResidualCoercivityFamily : Type 1 where
  nome : Nat → Q'
  nome_pos : ∀ scale, (0 : Q') < nome scale
  nome_lt_one : ∀ scale, nome scale < (1 : Q')
  transferSpacing : PhysicalSpacing
  transferSpacingToZero : SpacingToZero transferSpacing
  rayCapacity : ∀ scale,
    FixedNomeCofinalSpinCubeRayCapacity (nome_pos scale)
  residualCoercivity : ∀ scale,
    FixedNomeCofinalSpinCubeOffRayResidualCoercivity
      (nome_pos scale) (rayCapacity scale)

namespace DynamicSpinCubeOffRayResidualCoercivityFamily

/-- The actual completed strict contraction produced at one physical scale. -/
def completedGapAt
    (family : DynamicSpinCubeOffRayResidualCoercivityFamily)
    (scale : Nat) :
    CentralPhysicalVacuumSectorCylinderCompletedStrictContractionData
      (family.nome_pos scale) (family.nome_lt_one scale) 0 :=
  YMGap.Continuum.BF4PhysicalSpinCubeOffRayResidualCompletedGap.FixedNomeCofinalSpinCubeOffRayResidualCoercivity.toCompletedStrictContractionData
    (family.nome_pos scale) (family.nome_lt_one scale)
    (family.residualCoercivity scale)

/-- Erase the finite producer only after it has constructed the actual
completed carrier and transfer at every scale. -/
def toCompletedFamily
    (family : DynamicSpinCubeOffRayResidualCoercivityFamily) :
    DynamicVacuumSectorCompletedFamily 0 where
  nome := family.nome
  nome_pos := family.nome_pos
  nome_lt_one := family.nome_lt_one
  transferSpacing := family.transferSpacing
  transferSpacingToZero := family.transferSpacingToZero
  completedGap := family.completedGapAt

/-- The exact local Poincare strength at one scale. -/
def strength
    (family : DynamicSpinCubeOffRayResidualCoercivityFamily)
    (scale : Nat) : Q' :=
  cutoffTwoDirichletGluingStrength
    (HalfPow.half * (family.rayCapacity scale).delta)
    (centralPhysicalFiniteVacuumSectorUniformMassFloor
      (family.nome scale)
      (Q'.le_of_lt (family.nome_pos scale)) 0)

theorem strength_pos
    (family : DynamicSpinCubeOffRayResidualCoercivityFamily)
    (scale : Nat) :
    (0 : Q') < family.strength scale :=
  cutoffTwoDirichletGluingStrength_pos
    (FixedNomeCofinalSpinCubeOffRayResidualCoercivity.sharedFloor_pos
      (family.residualCoercivity scale))
    (centralPhysicalFiniteVacuumSectorUniformMassFloor_pos
      (family.nome scale)
      (Q'.le_of_lt (family.nome_pos scale)) 0)

/-- The rate in the common completed family is definitionally generated by
the local ray/residual coercivity floor and the explicit sector-mass floor. -/
theorem completedGapAt_rate_eq
    (family : DynamicSpinCubeOffRayResidualCoercivityFamily)
    (scale : Nat) :
    (family.completedGapAt scale).rate =
      cutoffTwoDirichletGluingRate
        (HalfPow.half * (family.rayCapacity scale).delta)
        (centralPhysicalFiniteVacuumSectorUniformMassFloor
          (family.nome scale)
          (Q'.le_of_lt (family.nome_pos scale)) 0)
        (FixedNomeCofinalSpinCubeOffRayResidualCoercivity.sharedFloor_pos
          (family.residualCoercivity scale))
        (centralPhysicalFiniteVacuumSectorUniformMassFloor_pos
          (family.nome scale)
          (Q'.le_of_lt (family.nome_pos scale)) 0) := rfl

/-- Exact normalized-strength identity for the actual completed local-route
transfer. -/
theorem latticeMargin_eqv_strengthRatio
    (family : DynamicSpinCubeOffRayResidualCoercivityFamily)
    (scale : Nat) :
    family.toCompletedFamily.latticeMargin scale ≈
      Q'.divPos (family.strength scale) (1 + family.strength scale)
        (Q'.pos_add_nonneg (by decide)
          (Q'.le_of_lt (family.strength_pos scale))) := by
  unfold DynamicVacuumSectorCompletedFamily.latticeMargin
  change (1 - (family.completedGapAt scale).rate) ≈ _
  rw [completedGapAt_rate_eq family scale]
  exact cutoffTwoDirichletGluingMargin_eqv_strengthRatio
    (HalfPow.half * (family.rayCapacity scale).delta)
    (centralPhysicalFiniteVacuumSectorUniformMassFloor
      (family.nome scale)
      (Q'.le_of_lt (family.nome_pos scale)) 0)
    (FixedNomeCofinalSpinCubeOffRayResidualCoercivity.sharedFloor_pos
      (family.residualCoercivity scale))
    (centralPhysicalFiniteVacuumSectorUniformMassFloor_pos
      (family.nome scale)
      (Q'.le_of_lt (family.nome_pos scale)) 0)

def toNormalizedStrengthLaw
    (family : DynamicSpinCubeOffRayResidualCoercivityFamily) :
    DynamicVacuumSectorNormalizedStrengthLaw family.toCompletedFamily where
  strength := family.strength
  strength_pos := family.strength_pos
  margin_eqv := family.latticeMargin_eqv_strengthRatio

/-- The sole scalar scaling certificate needed after the dynamic local family
is built. -/
abbrev StrengthBand
    (family : DynamicSpinCubeOffRayResidualCoercivityFamily) : Type 1 :=
  DynamicVacuumSectorStrengthBand family.toNormalizedStrengthLaw

def physicalRateBand
    {family : DynamicSpinCubeOffRayResidualCoercivityFamily}
    (band : family.StrengthBand) :
    DynamicVacuumSectorPhysicalRateBand family.toCompletedFamily :=
  band.toPhysicalRateBand

def toContinuumGapTheorem
    {family : DynamicSpinCubeOffRayResidualCoercivityFamily}
    (band : family.StrengthBand) :
    SharpContinuumObligation.ContinuumGapTheorem :=
  band.toContinuumGapTheorem

end DynamicSpinCubeOffRayResidualCoercivityFamily

/-! ## 2. Stronger dynamic pointwise flow capacity feeds the same path -/

structure DynamicSpinCubeOffRayResidualFlowCapacityFamily : Type 1 where
  nome : Nat → Q'
  nome_pos : ∀ scale, (0 : Q') < nome scale
  nome_lt_one : ∀ scale, nome scale < (1 : Q')
  transferSpacing : PhysicalSpacing
  transferSpacingToZero : SpacingToZero transferSpacing
  rayCapacity : ∀ scale,
    FixedNomeCofinalSpinCubeRayCapacity (nome_pos scale)
  residualFlowCapacity : ∀ scale,
    FixedNomeCofinalSpinCubeOffRayResidualFlowCapacity
      (nome_pos scale) (rayCapacity scale)

namespace DynamicSpinCubeOffRayResidualFlowCapacityFamily

def toResidualCoercivityFamily
    (family : DynamicSpinCubeOffRayResidualFlowCapacityFamily) :
    DynamicSpinCubeOffRayResidualCoercivityFamily where
  nome := family.nome
  nome_pos := family.nome_pos
  nome_lt_one := family.nome_lt_one
  transferSpacing := family.transferSpacing
  transferSpacingToZero := family.transferSpacingToZero
  rayCapacity := family.rayCapacity
  residualCoercivity := fun scale =>
    FixedNomeCofinalSpinCubeOffRayResidualFlowCapacity.toCofinalResidualCoercivity
      (family.residualFlowCapacity scale)

def toCompletedFamily
    (family : DynamicSpinCubeOffRayResidualFlowCapacityFamily) :
    DynamicVacuumSectorCompletedFamily 0 :=
  family.toResidualCoercivityFamily.toCompletedFamily

def toNormalizedStrengthLaw
    (family : DynamicSpinCubeOffRayResidualFlowCapacityFamily) :
    DynamicVacuumSectorNormalizedStrengthLaw family.toCompletedFamily :=
  family.toResidualCoercivityFamily.toNormalizedStrengthLaw

end DynamicSpinCubeOffRayResidualFlowCapacityFamily

end YMGap.Continuum.BF4PhysicalDynamicSpinCubeOffRayResidualFamily

