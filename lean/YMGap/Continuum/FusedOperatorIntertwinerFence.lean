/-
`FusedOperatorIntertwinerFence` audits the missing operator RG map between
consecutive corrected fused transfer models.

A nonzero intertwiner between one-dimensional diagonal operators forces their
eigenvalues to agree.  The consecutive endpoint operators at the quadratic
cutoffs `Ncut(0)=4` and `Ncut(1)=9` have distinct, exactly derived eigenvalues,
so no positive rank-one block-spin embedding can intertwine them.  This is a
spectrum obstruction, not a missing scalar estimate.

The minimal viable enrichment is also constructed: a two-mode diagonal fine
operator retains the old fused eigenmode as the embedded head mode and carries
the new fused eigenmode as an orthogonal second mode.  Thus exact operator
intertwining is possible only after retaining an RG memory/shell mode.  A
further compression or Schur-complement estimate relating the new mode to the
physical spacing is still required; the rank-one carrier cannot express it.
-/

import YMGap.Continuum.CorrectedCarrierOperatorBridge

namespace YMGap.Continuum.FusedOperatorIntertwinerFence

open YMGap.Constructive
open YMGap.Constructive.RationalTail
open YMGap.Continuum
open YMGap.Continuum.CompactTransferGNS
open YMGap.Continuum.CorrectedCarrierOperatorBridge
open YMGap.Continuum.FusedPeterWeylNormalization
open YMGap.Continuum.QuadraticCutoffSchedule

local infix:50 " ≈ " => Q'.eqv

/-! ## 1. Rank-one intertwiners force spectral equality -/

/-- Complete scalar form of a positive map between one-dimensional eigenspaces:
`scale * lamIn = lamOut * scale`.  Positivity excludes the zero map. -/
structure PositiveRankOneIntertwiner (lamIn lamOut : Q') : Type where
  scale : Q'
  scale_pos : (0 : Q') < scale
  intertwines : scale * lamIn ≈ lamOut * scale

/-- A positive rank-one intertwiner can exist only when the two eigenvalues
are equal. -/
theorem positive_rankOne_intertwiner_forces_eigen_eq
    {lamIn lamOut : Q'} (I : PositiveRankOneIntertwiner lamIn lamOut) :
    lamIn ≈ lamOut := by
  apply Q'.mul_left_cancel_of_pos I.scale_pos
  exact Q'.eqv_trans _ _ _ I.intertwines (Q'.mul_comm_eqv lamOut I.scale)

/-- The two consecutive quadratic-cutoff endpoint fused rates are distinct.
All character sums reduce in the kernel; no numerical estimate is used. -/
theorem endpoint_consecutive_fused_eigenvalues_ne :
    ¬ (lamPW (1 : Q') (Ncut 0) 1 ≈ lamPW (1 : Q') (Ncut 1) 1) := by
  decide

/-- Hence there is no positive rank-one operator intertwiner between the
consecutive endpoint `fusedChannelOp` models. -/
theorem no_endpoint_consecutive_rankOne_intertwiner :
    PositiveRankOneIntertwiner
      (lamPW (1 : Q') (Ncut 0) 1)
      (lamPW (1 : Q') (Ncut 1) 1) -> False := by
  intro I
  exact endpoint_consecutive_fused_eigenvalues_ne
    (positive_rankOne_intertwiner_forces_eigen_eq I)

/-- The obstruction stated directly using the eigenvalues of the constructed
operator models. -/
theorem no_endpoint_consecutive_model_intertwiner :
    PositiveRankOneIntertwiner
      ((fusedChannelModel (w := (1 : Q')) (by decide) (by decide) (Ncut 0) 0).lam 0)
      ((fusedChannelModel (w := (1 : Q')) (by decide) (by decide) (Ncut 1) 0).lam 0) -> False := by
  simpa [fusedChannel_model_lam] using no_endpoint_consecutive_rankOne_intertwiner

/-! ## 2. Minimal two-mode enrichment -/

/-- The enriched fine spectrum: mode zero remembers the incoming fused rate,
while mode one carries the genuinely new outgoing fused rate. -/
def enrichedStepLam (w : Q') (k : Nat) : QSeq := fun i =>
  if i = 0 then lamPW w (Ncut k) 1 else lamPW w (Ncut (k + 1)) 1

/-- The two-mode enriched fine transfer operator. -/
def enrichedFusedStepOp (w : Q') (k : Nat) : FiniteOp :=
  diagOp (enrichedStepLam w k) 2

/-- The embedded head mode has exactly the incoming fused eigenvalue. -/
theorem enriched_head_eigen (w : Q') (k : Nat) :
    ((enrichedFusedStepOp w k).apply (basis 0) 0) ≈
      lamPW w (Ncut k) 1 := by
  refine Q'.eqv_trans _ _ _ (diagOp_eigen (enrichedStepLam w k) 2 0 (by decide)) ?_
  unfold enrichedStepLam
  rw [if_pos rfl]
  exact Q'.eqv_refl _

/-- The added shell mode has exactly the outgoing fused eigenvalue. -/
theorem enriched_shell_eigen (w : Q') (k : Nat) :
    ((enrichedFusedStepOp w k).apply (basis 1) 1) ≈
      lamPW w (Ncut (k + 1)) 1 := by
  refine Q'.eqv_trans _ _ _ (diagOp_eigen (enrichedStepLam w k) 2 1 (by decide)) ?_
  unfold enrichedStepLam
  rw [if_neg (by omega : ¬ (1 = 0))]
  exact Q'.eqv_refl _

/-- The coarse rank-one operator embeds exactly as the head eigenspace of the
enriched fine operator.  Since a one-dimensional domain is generated by this
basis vector, this is the nonzero basis-level intertwining that the rank-one
fine carrier could not supply. -/
theorem enriched_head_intertwines_coarse (w : Q') (k : Nat) :
    ((enrichedFusedStepOp w k).apply (basis 0) 0) ≈
      ((fusedChannelOp w (Ncut k) 1).apply (basis 0) 0) := by
  exact Q'.eqv_trans _ _ _ (enriched_head_eigen w k)
    (Q'.eqv_symm
      (diagOp_eigen (fusedChannelLam w (Ncut k) 1) 1 0 (by decide)))

/-- At the endpoint the retained head and new shell modes are genuinely
distinct.  The enrichment is not a duplicated or vacuous mode. -/
theorem endpoint_enriched_modes_distinct :
    ¬ (((enrichedFusedStepOp (1 : Q') 0).apply (basis 0) 0) ≈
      ((enrichedFusedStepOp (1 : Q') 0).apply (basis 1) 1)) := by
  intro h
  apply endpoint_consecutive_fused_eigenvalues_ne
  exact Q'.eqv_trans _ _ _ (Q'.eqv_symm (enriched_head_eigen 1 0))
    (Q'.eqv_trans _ _ _ h (enriched_shell_eigen 1 0))

end YMGap.Continuum.FusedOperatorIntertwinerFence

