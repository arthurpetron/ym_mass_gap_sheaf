/-
# Edge-order independence of the actual finite-graph norms

The pointwise projected and transferred summands are already independent of
the order in which graph edges are listed.  The remaining issue is that the
complete bounded labellings are generated by a nested Cartesian enumeration
whose syntactic order follows that list.

This file proves a constructive finite Fubini theorem for that enumeration.
Adjacent edge enumerations commute by the exact finite-sum swap identity and
the commutation of distinct coordinate updates; repeated edge identifiers
are handled separately by reflexivity.  Induction on `List.Perm` then gives
full edge-order invariance of the Cartesian sum and hence of both actual
finite-graph norms.

Honest scope: this eliminates a graph-presentation artifact at fixed finite
cutoff.  It does not add edges, enlarge volume, or take a limit.
-/

import YMGap.Continuum.SU2FiniteTrivalentPacketGraphPresentationCompatibility

namespace YMGap.Continuum.SU2FiniteTrivalentPacketGraphEdgeOrderNorm

set_option maxHeartbeats 1000000
set_option maxRecDepth 16000

open YMGap.Constructive
open YMGap.Continuum
open YMGap.Continuum.BondMovingStep
open YMGap.Continuum.SU2CharacterVacuumHaar
open YMGap.Continuum.SU2FundamentalPentagonFiniteGraph
open YMGap.Continuum.SU2FiniteTrivalentPacketGraphActualOperator
open YMGap.Continuum.SU2FiniteTrivalentPacketGraphFullSupportNorm
open YMGap.Continuum.SU2FiniteTrivalentPacketGraphPresentationCompatibility

local infix:50 " ≈ " => Q'.eqv

/-! ## Generic structural sums on lists -/

private theorem listQSum_single {A : Type} (f : A → Q') (x : A) :
    listQSum f [x] ≈ f x := by
  change f x + 0 ≈ f x
  exact Q'.eqv_of_eq (Q'.add_zero' _)

theorem listQSum_append {A : Type} (f : A → Q') : ∀ xs ys,
    listQSum f (xs ++ ys) ≈ listQSum f xs + listQSum f ys
  | [], ys => Q'.eqv_symm (Q'.eqv_of_eq (Q'.zero_add' _))
  | x :: xs, ys => by
      change f x + listQSum f (xs ++ ys) ≈
        (f x + listQSum f xs) + listQSum f ys
      exact Q'.eqv_trans _
        (f x + (listQSum f xs + listQSum f ys)) _
        (Q'.add_eqv_congr' (Q'.eqv_refl _) (listQSum_append f xs ys))
        (Q'.eqv_symm (Q'.add_assoc_eqv _ _ _))

theorem listQSum_map {A B : Type} (f : B → Q') (g : A → B) : ∀ xs,
    listQSum f (xs.map g) = listQSum (fun x => f (g x)) xs
  | [] => rfl
  | _ :: xs => by
      simp only [List.map, listQSum]
      rw [listQSum_map f g xs]

theorem listQSum_flatMap {A B : Type} (f : B → Q')
    (g : A → List B) : ∀ xs,
    listQSum f (xs.flatMap g) ≈
      listQSum (fun x => listQSum f (g x)) xs
  | [] => Q'.eqv_refl 0
  | x :: xs => by
      change listQSum f (g x ++ xs.flatMap g) ≈
        listQSum f (g x) +
          listQSum (fun y => listQSum f (g y)) xs
      exact Q'.eqv_trans _
        (listQSum f (g x) + listQSum f (xs.flatMap g)) _
        (listQSum_append f (g x) (xs.flatMap g))
        (Q'.add_eqv_congr' (Q'.eqv_refl _)
          (listQSum_flatMap f g xs))

theorem listQSum_range_eq_fsum (f : Nat → Q') : ∀ n,
    listQSum f (List.range n) ≈ fsum f n
  | 0 => Q'.eqv_refl 0
  | n + 1 => by
      rw [List.range_succ, fsum_succ]
      exact Q'.eqv_trans _
        (listQSum f (List.range n) + listQSum f [n]) _
        (listQSum_append f (List.range n) [n])
        (Q'.add_eqv_congr' (listQSum_range_eq_fsum f n)
          (listQSum_single f n))

/-! ## Finite Fubini for bounded edge labellings -/

theorem listQSum_bounded_cons (K edge : Nat) (rest : List Nat)
    (f : EdgeLabelling → Q') :
    listQSum f (boundedEdgeLabellings K (edge :: rest)) ≈
      fsum (fun spin =>
        listQSum (fun label => f (setEdgeLabel label edge spin))
          (boundedEdgeLabellings K rest)) (K + 1) := by
  change listQSum f
      ((List.range (K + 1)).flatMap (fun spin =>
        (boundedEdgeLabellings K rest).map
          (fun label => setEdgeLabel label edge spin))) ≈
    fsum (fun spin =>
      listQSum (fun label => f (setEdgeLabel label edge spin))
        (boundedEdgeLabellings K rest)) (K + 1)
  exact Q'.eqv_trans _
    (listQSum
      (fun spin => listQSum f
        ((boundedEdgeLabellings K rest).map
          (fun label => setEdgeLabel label edge spin)))
      (List.range (K + 1))) _
    (listQSum_flatMap _ _ _)
    (Q'.eqv_trans _
      (listQSum
        (fun spin => listQSum
          (fun label => f (setEdgeLabel label edge spin))
          (boundedEdgeLabellings K rest))
        (List.range (K + 1))) _
      (listQSum_congr (fun spin => Q'.eqv_of_eq
        (listQSum_map f (fun label => setEdgeLabel label edge spin)
          (boundedEdgeLabellings K rest))) (List.range (K + 1)))
      (listQSum_range_eq_fsum
        (fun spin => listQSum
          (fun label => f (setEdgeLabel label edge spin))
          (boundedEdgeLabellings K rest)) (K + 1)))

private theorem setEdgeLabel_commute (label : EdgeLabelling)
    {a b sa sb : Nat} (hab : a ≠ b) :
    setEdgeLabel (setEdgeLabel label b sb) a sa =
      setEdgeLabel (setEdgeLabel label a sa) b sb := by
  funext edge
  by_cases hea : edge = a
  · subst edge
    simp [setEdgeLabel, hab]
  · by_cases heb : edge = b
    · subst edge
      simp [setEdgeLabel, hea]
    · simp [setEdgeLabel, hea, heb]

private theorem bounded_swap_sum (K a b : Nat) (rest : List Nat)
    (f : EdgeLabelling → Q') :
    listQSum f (boundedEdgeLabellings K (a :: b :: rest)) ≈
      listQSum f (boundedEdgeLabellings K (b :: a :: rest)) := by
  by_cases hab : a = b
  · subst b
    exact Q'.eqv_refl _
  · let tail := boundedEdgeLabellings K rest
    let g : Nat → Nat → Q' := fun sa sb =>
      listQSum
        (fun label => f
          (setEdgeLabel (setEdgeLabel label b sb) a sa)) tail
    let swapped : Nat → Nat → Q' := fun sb sa =>
      listQSum
        (fun label => f
          (setEdgeLabel (setEdgeLabel label a sa) b sb)) tail
    have hleft :
        listQSum f (boundedEdgeLabellings K (a :: b :: rest)) ≈
          fsum (fun sa => fsum (fun sb => g sa sb) (K + 1)) (K + 1) :=
      Q'.eqv_trans _ _ _
        (listQSum_bounded_cons K a (b :: rest) f)
        (YMGap.Continuum.CubeRatioBounds.fsum_eqv_congr _ _
          (fun sa => listQSum_bounded_cons K b rest
            (fun label => f (setEdgeLabel label a sa))) (K + 1))
    have hcomm :
        fsum (fun sb => fsum (fun sa => g sa sb) (K + 1)) (K + 1) ≈
          fsum (fun sb => fsum (fun sa => swapped sb sa) (K + 1)) (K + 1) :=
      YMGap.Continuum.CubeRatioBounds.fsum_eqv_congr _ _
        (fun sb => YMGap.Continuum.CubeRatioBounds.fsum_eqv_congr _ _
          (fun sa => listQSum_congr
            (fun label => Q'.eqv_of_eq
              (congrArg f (setEdgeLabel_commute label hab))) tail)
          (K + 1)) (K + 1)
    have hright :
        listQSum f (boundedEdgeLabellings K (b :: a :: rest)) ≈
          fsum (fun sb => fsum (fun sa => swapped sb sa) (K + 1)) (K + 1) :=
      Q'.eqv_trans _ _ _
        (listQSum_bounded_cons K b (a :: rest) f)
        (YMGap.Continuum.CubeRatioBounds.fsum_eqv_congr _ _
          (fun sb => listQSum_bounded_cons K a rest
            (fun label => f (setEdgeLabel label b sb))) (K + 1))
    exact Q'.eqv_trans _ _ _ hleft
      (Q'.eqv_trans _ _ _
        (YMGap.Continuum.CubeRatioBounds.fsum_swap g (K + 1) (K + 1))
        (Q'.eqv_trans _ _ _ hcomm (Q'.eqv_symm hright)))

/-- The complete Cartesian sum is independent of the edge enumeration order,
including the harmless case of repeated edge identifiers. -/
theorem listQSum_bounded_perm (K : Nat) (f : EdgeLabelling → Q')
    {A B : List Nat} (h : A.Perm B) :
    listQSum f (boundedEdgeLabellings K A) ≈
      listQSum f (boundedEdgeLabellings K B) := by
  induction h generalizing f with
  | nil => exact Q'.eqv_refl _
  | cons edge h ih =>
      exact Q'.eqv_trans _
        (fsum (fun spin =>
          listQSum (fun label => f (setEdgeLabel label edge spin))
            (boundedEdgeLabellings K _)) (K + 1)) _
        (listQSum_bounded_cons K edge _ f)
        (Q'.eqv_trans _
          (fsum (fun spin =>
            listQSum (fun label => f (setEdgeLabel label edge spin))
              (boundedEdgeLabellings K _)) (K + 1)) _
          (YMGap.Continuum.CubeRatioBounds.fsum_eqv_congr _ _
            (fun spin => ih
              (fun label => f (setEdgeLabel label edge spin))) (K + 1))
          (Q'.eqv_symm (listQSum_bounded_cons K edge _ f)))
  | swap a b rest => exact Q'.eqv_symm (bounded_swap_sum K a b rest f)
  | trans hAB hBC ihAB ihBC =>
      exact Q'.eqv_trans _ _ _ (ihAB f) (ihBC f)

/-! ## Edge-order invariance of the actual norms -/

theorem packetGraphFullExactNorm_edge_perm {K : Nat}
    (vertices : List TrivalentVertex) (packet : Nat → CharacterPacket K)
    {A B : List Nat} (h : A.Perm B) :
    packetGraphFullExactNorm A vertices packet ≈
      packetGraphFullExactNorm B vertices packet := by
  unfold packetGraphFullExactNorm
  exact Q'.eqv_trans _
    (listQSum (projectedSquare B vertices packet)
      (boundedEdgeLabellings K A)) _
    (listQSum_congr
      (fun label => projectedSquare_edge_perm vertices packet label h) _)
    (listQSum_bounded_perm K (projectedSquare B vertices packet) h)

theorem packetGraphFullTransferredNorm_edge_perm {K : Nat}
    (vertices : List TrivalentVertex) (packet : Nat → CharacterPacket K)
    {A B : List Nat} (h : A.Perm B) :
    packetGraphFullTransferredNorm A vertices packet ≈
      packetGraphFullTransferredNorm B vertices packet := by
  unfold packetGraphFullTransferredNorm
  exact Q'.eqv_trans _
    (listQSum (transferredProjectedSquare B vertices packet)
      (boundedEdgeLabellings K A)) _
    (listQSum_congr
      (fun label => transferredProjectedSquare_edge_perm
        vertices packet label h) _)
    (listQSum_bounded_perm K
      (transferredProjectedSquare B vertices packet) h)

theorem packetGraphExactNorm_edge_perm {K : Nat}
    (vertices : List TrivalentVertex) (packet : Nat → CharacterPacket K)
    {A B : List Nat} (h : A.Perm B) :
    packetGraphExactNorm A vertices packet ≈
      packetGraphExactNorm B vertices packet := by
  exact Q'.eqv_trans _ (packetGraphFullExactNorm A vertices packet) _
    (packetGraphExactNorm_eq_full A vertices packet)
    (Q'.eqv_trans _ (packetGraphFullExactNorm B vertices packet) _
      (packetGraphFullExactNorm_edge_perm vertices packet h)
      (Q'.eqv_symm (packetGraphExactNorm_eq_full B vertices packet)))

theorem packetGraphOperatorTransferredNorm_edge_perm {K : Nat}
    (vertices : List TrivalentVertex) (packet : Nat → CharacterPacket K)
    {A B : List Nat} (h : A.Perm B) :
    packetGraphOperatorTransferredNorm A vertices packet ≈
      packetGraphOperatorTransferredNorm B vertices packet := by
  exact Q'.eqv_trans _ (packetGraphFullTransferredNorm A vertices packet) _
    (packetGraphOperatorTransferredNorm_eq_full A vertices packet)
    (Q'.eqv_trans _ (packetGraphFullTransferredNorm B vertices packet) _
      (packetGraphFullTransferredNorm_edge_perm vertices packet h)
      (Q'.eqv_symm
        (packetGraphOperatorTransferredNorm_eq_full B vertices packet)))

end YMGap.Continuum.SU2FiniteTrivalentPacketGraphEdgeOrderNorm

