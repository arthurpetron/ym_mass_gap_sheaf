open YMGap.Continuum.SU2FundamentalPentagonFiniteGraph
open YMGap.Continuum.Z4HalfTimeReflectionPhysicalGram

/-! ## 1. Generic positive-floor cross-tail theorem -/

/-- The exact relative error with a positive scale-dependent floor. -/
def floorRelativeError
    (error floor : Nat -> Q')
    (floor_pos : forall stage, (0 : Q') < floor stage)
    (stage : Nat) : Q' :=
  Q'.divPos (error stage) (floor stage) (floor_pos stage)

/-- A finite prefix and one division-free tail inequality for an arbitrary
error/floor ratio and tolerance. -/
structure PositiveFloorErrorCrossTail
    (error floor : Nat -> Q') (tolerance : Q') : Type where
  threshold : Nat
  floor_pos : forall stage, (0 : Q') < floor stage
  prefix_bound : forall stage, stage < threshold ->
    error stage <= tolerance * floor stage
  threshold_bound :
    error threshold <= tolerance * floor threshold
  tail_cross : forall stage, threshold <= stage ->
    error (stage + 1) * floor stage <=
      error stage * floor (stage + 1)

namespace PositiveFloorErrorCrossTail

/-- The division-free cross inequality makes the relative error antitone on
the analytic tail. -/
theorem tail_step
    {error floor : Nat -> Q'} {tolerance : Q'}
    (certificate :
      PositiveFloorErrorCrossTail error floor tolerance)
    (stage : Nat) (hstage : certificate.threshold <= stage) :
    floorRelativeError error floor certificate.floor_pos (stage + 1) <=
      floorRelativeError error floor certificate.floor_pos stage := by
  exact YMGap.Continuum.FusionMarginMono.divPos_le_divPos_of_cross
    (error (stage + 1)) (floor (stage + 1))
    (error stage) (floor stage)
    (certificate.floor_pos (stage + 1))
    (certificate.floor_pos stage)
    (certificate.tail_cross stage hstage)

/-- Every later tail ratio lies below the ratio at its starting point. -/
theorem tail_antitone_add
    {error floor : Nat -> Q'} {tolerance : Q'}
    (certificate :
      PositiveFloorErrorCrossTail error floor tolerance)
    (start : Nat) (hstart : certificate.threshold <= start) :
    forall offset,
      floorRelativeError error floor certificate.floor_pos
          (start + offset) <=
        floorRelativeError error floor certificate.floor_pos start
  | 0 => Q'.le_refl' _
  | offset + 1 => by
      refine Q'.le_trans' _ _ _ ?_
        (certificate.tail_antitone_add start hstart offset)
      rw [show start + (offset + 1) = (start + offset) + 1 by omega]
      exact certificate.tail_step (start + offset)
        (Nat.le_trans hstart (Nat.le_add_right start offset))

/-- The checked prefix and cross-product tail prove the relative tolerance at
every natural cutoff. -/
theorem relative_bound_all
    {error floor : Nat -> Q'} {tolerance : Q'}
    (certificate :
      PositiveFloorErrorCrossTail error floor tolerance)
    (stage : Nat) :
    floorRelativeError error floor certificate.floor_pos stage <=
      tolerance := by
  rcases Nat.lt_or_ge stage certificate.threshold with hprefix | htail
  · exact Q'.divPos_le_of_le_mul
      (error stage) (floor stage) (certificate.floor_pos stage)
      (certificate.prefix_bound stage hprefix)
  · obtain ⟨offset, rfl⟩ := Nat.exists_eq_add_of_le htail
    exact Q'.le_trans' _ _ _
      (certificate.tail_antitone_add certificate.threshold
        (Nat.le_refl _) offset)
      (Q'.divPos_le_of_le_mul
        (error certificate.threshold)
        (floor certificate.threshold)
        (certificate.floor_pos certificate.threshold)
        certificate.threshold_bound)

/-- Clearing the positive computed floor turns the all-scale quotient bound
back into the required division-free entry-error budget. -/
theorem error_le_tolerance_mul_floor
    {error floor : Nat -> Q'} {tolerance : Q'}
    (certificate :
      PositiveFloorErrorCrossTail error floor tolerance)
    (stage : Nat) :
    error stage <= tolerance * floor stage := by
  have hscaled :
      floorRelativeError error floor certificate.floor_pos stage *
          floor stage <=
        tolerance * floor stage :=
    Q'.mul_le_mul_of_nonneg_right _ _ _
      (certificate.relative_bound_all stage)
      (Q'.le_of_lt (certificate.floor_pos stage))
  exact Q'.le_trans' _ _ _
    (Q'.ge_of_eqv
      (Q'.divPos_mul_eqv
        (error stage) (floor stage)
        (certificate.floor_pos stage)))
    hscaled

end PositiveFloorErrorCrossTail

/-! ## 2. Adapter to the physical BF4 computed-floor interface -/

/-- Construct the sole physical-error field from an entrywise scalar
majorant, exact finite relative checks, and the analytic cross-product tail.
All terminal data are passed through unchanged. -/
def computedFloorErrorRowsOfCrossTail
    {Middle : Nat -> Type}
    {family : MatchedBlockFamily}
    {law : CubicMarginLaw family}
    {spacing : PhysicalSpacingEnvelope law.g₁}
    {coupling : Nat -> Q'}
    {halfExtent diagonalOrder : Nat -> Nat}
    (coupling_pos : forall scale, (0 : Q') < coupling scale)
    (coupling_le_window : forall scale, coupling scale <= law.g₁)
    (calibrated_harnack : forall scale,
      CalibratedEmptyProfileHarnackData
        (matchedAllSpinWeight family coupling scale)
        (matchedAllSpinWeight_nonnegative family coupling scale)
        (matchedAllSpinCutoff family coupling scale)
        (halfExtent scale) (diagonalOrder scale) 0)
    (middles : forall scale, List (Middle scale))
    (prefixWeight : forall scale, EdgeLabelling -> Middle scale -> Q')
    (terminal : forall scale, Middle scale -> EdgeLabelling -> Q')
    (prefixRows : forall scale,
      PositivePrefixRows
        (prefixWeight scale)
        (centralPositiveHalfStates
          (matchedAllSpinWeight family coupling scale)
          (matchedAllSpinWeight_nonnegative family coupling scale)
          (matchedAllSpinCutoff family coupling scale)
          (halfExtent scale))
        (middles scale))
    (terminalCertificate : forall scale,
      FiniteCrossRatioDiameterCertificate
        (terminal scale) (middles scale)
        (centralBoundaryChannels
          (matchedAllSpinCutoff family coupling scale)
          (halfExtent scale)))
    (terminal_spread_square_le_split : forall scale,
      (terminalCertificate scale).spread *
          (terminalCertificate scale).spread <=
        splitProjectiveCeiling)
    (errorMajorant : Nat -> Q')
    (entry_error : forall scale source,
      source ∈
          centralPositiveHalfStates
            (matchedAllSpinWeight family coupling scale)
            (matchedAllSpinWeight_nonnegative family coupling scale)
            (matchedAllSpinCutoff family coupling scale)
            (halfExtent scale) ->
        forall boundary,
          boundary ∈
              centralBoundaryChannels
                (matchedAllSpinCutoff family coupling scale)
                (halfExtent scale) ->
            Q'.abs
                (centralHalfAmplitude
                    (matchedAllSpinWeight family coupling scale)
                    (matchedAllSpinCutoff family coupling scale)
                    (halfExtent scale) source boundary +
                  -terminalSmoothedKernel
                    (prefixWeight scale)
                    (terminal scale)
                    (middles scale)
                    source boundary) <=
              errorMajorant scale)
    (errorTail :
      PositiveFloorErrorCrossTail
        errorMajorant
        (fun scale =>
          (terminalSmoothedFiniteFloor
            (matchedAllSpinWeight_nonnegative family coupling scale)
            (matchedAllSpinCutoff family coupling scale)
            (halfExtent scale)
            (middles scale)
            (prefixWeight scale)
            (terminal scale)
            (prefixRows scale)
            (terminalCertificate scale)).floor)
        physicalRelativeErrorTolerance) :
    MatchedPhysicalHalfAmplitudeComputedFloorErrorRows
      Middle family law spacing coupling halfExtent diagonalOrder where
  coupling_pos := coupling_pos
  coupling_le_window := coupling_le_window
  calibrated_harnack := calibrated_harnack
  middles := middles
  prefixWeight := prefixWeight
  terminal := terminal
  prefixRows := prefixRows
  terminalCertificate := terminalCertificate
  terminal_spread_square_le_split := terminal_spread_square_le_split
  physical_error := by
    intro scale source source_mem boundary boundary_mem
    exact Q'.le_trans' _ _ _
      (entry_error scale source source_mem boundary boundary_mem)
      (errorTail.error_le_tolerance_mul_floor scale)

end YMGap.Continuum.BF4BoundaryMessageComputedFloorCrossTail

