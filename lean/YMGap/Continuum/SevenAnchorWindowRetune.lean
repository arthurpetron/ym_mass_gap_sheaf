theorem tailRatio7_le_retune {w : Q'}
    (hw0 : (0 : Q') ≤ w) (hwc : w ≤ sevenAnchorCap) :
    tailRatio7 w ≤ retuneCube w := by
  have hs := scaled_bernstein_nonneg ratioSlack7P 15 ratio7Bern
    ratio7_bernstein_identity (by decide) hw0 hwc
  have hq : tailRatio7 w ≈ eval ratio7P w := by
    unfold tailRatio7 ratio7P
    exact Q'.eqv_symm (eval_monoP eightSevenths w 15)
  have he : eval ratioSlack7P w ≈ retuneCube w + -(tailRatio7 w) := by
    refine Q'.eqv_trans _ _ _ (eval_psub _ _ w) ?_
    exact Q'.add_eqv_congr' (Q'.eqv_symm (retune_eval w))
      (Q'.neg_eqv_congr _ _ (Q'.eqv_symm hq))
  exact Q'.le_of_sub_nonneg (Q'.le_trans' _ _ _ hs (Q'.le_of_eqv he))

theorem coeffW_seven_eq_tailRatio7_mul_six (w : Q') :
    coeffW w 7 ≈ tailRatio7 w * coeffW w 6 := by
  have hc7 := hcoeff w 7
  have hq : tailRatio7 w ≈ eval ratio7P w := by
    unfold tailRatio7 ratio7P
    exact Q'.eqv_symm (eval_monoP eightSevenths w 15)
  have hc6 := hcoeff w 6
  refine Q'.eqv_trans _ _ _ hc7 ?_
  refine Q'.eqv_trans _ _ _
    (poly_eqv (coeffPoly 7) (pmul ratio7P (coeffPoly 6)) w (by decide)) ?_
  exact Q'.eqv_symm (hEvalMul hq hc6)

theorem adjacent_tail7_le {w : Q'} (hw0 : (0 : Q') ≤ w)
    (hw1 : w ≤ (1 : Q')) (hwp : (0 : Q') < w) {a : Nat} (ha : 6 ≤ a) :
    coeffW w a * coeffW w (a + 1) ≤
      tailRatio7 w * (coeffW w a * coeffW w a) := by
  by_cases h6 : a = 6
  · subst a
    refine Q'.le_of_eqv ?_
    refine Q'.eqv_trans _ _ _
      (Q'.mul_eqv_congr_left (coeffW w 6) _ _
        (coeffW_seven_eq_tailRatio7_mul_six w)) ?_
    refine Q'.eqv_trans _ _ _ (Q'.eqv_symm (Q'.mul_assoc_eqv _ _ _)) ?_
    refine Q'.eqv_trans _ _ _
      (Q'.mul_eqv_congr_right _ _ _ (Q'.mul_comm_eqv _ _)) ?_
    exact Q'.mul_assoc_eqv _ _ _
  · have ha7 : 6 < a := by omega
    have hs := shifted_ratio_injection hw0 hw1 hwp (a := 6) (N := a) ha7
    have hr : coeffW w (a + 1) * coeffW w 6 ≤ coeffW w a * coeffW w 7 :=
      Q'.le_trans' _ _ _ (Q'.le_of_eqv (Q'.mul_comm_eqv _ _))
        (Q'.le_trans' _ _ _ hs (Q'.le_of_eqv (Q'.mul_comm_eqv _ _)))
    have hsq := ratio_to_sq (coeffW_nonneg hw0 a) hr
    have hc6p := FusionResidualBound.coeffW_pos hwp 6
    have hR : coeffW w 7 * (coeffW w a * coeffW w a) ≈
        coeffW w 6 * (tailRatio7 w * (coeffW w a * coeffW w a)) := by
      refine Q'.eqv_trans _ _ _
        (Q'.mul_eqv_congr_right _ _ _ (coeffW_seven_eq_tailRatio7_mul_six w)) ?_
      refine Q'.eqv_trans _ _ _ (Q'.mul_assoc_eqv _ _ _) ?_
      refine Q'.eqv_trans _ _ _ (Q'.eqv_symm (Q'.mul_assoc_eqv _ _ _)) ?_
      refine Q'.eqv_trans _ _ _
        (Q'.mul_eqv_congr_right _ _ _ (Q'.mul_comm_eqv _ _)) ?_
      exact Q'.mul_assoc_eqv _ _ _
    have hcancel : coeffW w 6 * (coeffW w a * coeffW w (a + 1)) ≤
        coeffW w 6 * (tailRatio7 w * (coeffW w a * coeffW w a)) :=
      Q'.le_trans' _ _ _ hsq (Q'.le_of_eqv hR)
    exact Q'.le_of_mul_le_mul_left hcancel hc6p

private def edgeTail (w : Q') (j : Nat) : Q' :=
  coeffW w (7 + j) * coeffW w (7 + j + 1)
private def squareTail (w : Q') (j : Nat) : Q' :=
  coeffW w (7 + j) * coeffW w (7 + j)

private theorem tail_sum_le {w : Q'} (hw0 : (0 : Q') ≤ w)
    (hw1 : w ≤ (1 : Q')) (hwp : (0 : Q') < w)
    (hwc : w ≤ sevenAnchorCap) (M : Nat) :
    fsum (edgeTail w) M ≤ retuneCube w * fsum (squareTail w) M := by
  have hterm : ∀ j, edgeTail w j ≤ retuneCube w * squareTail w j := by
    intro j
    have ht := adjacent_tail7_le hw0 hw1 hwp (a := 7 + j) (by omega)
    exact Q'.le_trans' _ _ _ ht
      (Q'.mul_le_mul_of_nonneg_right _ _ _ (tailRatio7_le_retune hw0 hwc)
        (Q'.mul_nonneg _ _
          (coeffW_nonneg hw0 (7 + j)) (coeffW_nonneg hw0 (7 + j))))
  have hsum : fsum (edgeTail w) M ≤
      fsum (fun j => retuneCube w * squareTail w j) M := by
    rw [MovingCutoff.fsum_eq_finSum, MovingCutoff.fsum_eq_finSum]
    exact CharacterTail.finSum_le_termwise _ _ hterm M
  have hfactor : retuneCube w * fsum (squareTail w) M ≈
      fsum (fun j => retuneCube w * squareTail w j) M := by
    rw [MovingCutoff.fsum_eq_finSum, MovingCutoff.fsum_eq_finSum]
    exact const_mul_finSum (squareTail w) (retuneCube w) M
  exact Q'.le_trans' _ _ _ hsum (Q'.ge_of_eqv hfactor)

theorem seven_anchor_retune_all_cutoffs {w : Q'}
    (hw0 : (0 : Q') ≤ w) (hwc : w ≤ sevenAnchorCap) (N : Nat) :
    adjCorr w N ≤ retuneCube w * coordNormSq w N := by
  have hw1 : w ≤ (1 : Q') := Q'.le_trans' _ _ _ hwc (by decide)
  by_cases hwz : w.eqv 0
  · have hA0 : adjCorr w N ≈ (0 : Q') := by
      unfold adjCorr
      refine Q'.eqv_trans _ _ _
        (fsum_eqv_congr _ (fun _ => (0 : Q')) (fun a => ?_) N) ?_
      · refine Q'.eqv_trans _ _ _
          (Q'.mul_eqv_congr_left (coeffW w a) _ _
            (coeffW_excited_zero hwz a)) ?_
        exact Q'.mul_zero_eqv _
      · rw [fsum_zero_seq]
        exact Q'.eqv_refl 0
    exact Q'.le_trans' _ _ _ (Q'.le_of_eqv hA0)
      (Q'.mul_nonneg _ _
        (qpow_nonneg _
          (Q'.mul_nonneg _ _ (by decide)
            (Q'.zero_le_add _ _ (by decide) hw0)) 3)
        (coordNormSq_nonneg hw0 N))
  · have hwp : (0 : Q') < w := pos_of_nonneg_not_eqv_zero hw0 hwz
    rcases Nat.le_total N 7 with hsmall | hlarge
    · have cases : N = 0 ∨ N = 1 ∨ N = 2 ∨ N = 3 ∨ N = 4 ∨ N = 5 ∨
          N = 6 ∨ N = 7 := by omega
      rcases cases with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
      · exact Q'.mul_nonneg _ _
          (qpow_nonneg _
            (Q'.mul_nonneg _ _ (by decide)
              (Q'.zero_le_add _ _ (by decide) hw0)) 3)
          (coordNormSq_nonneg hw0 0)
      · exact short_one_head hw0 hwc
      · exact short_two_head hw0 hwc
      · exact short_three_head hw0 hwc
      · exact short_four_head hw0 hwc
      · exact short_five_head hw0 hwc
      · have hA67 : adjCorr w 6 ≤ adjCorr w 7 := by
          unfold adjCorr
          exact AFRateCalibration.fsum_le_of_le
            (fun i => Q'.mul_nonneg _ _
              (coeffW_nonneg hw0 i) (coeffW_nonneg hw0 (i + 1))) (by omega)
        exact Q'.le_trans' _ _ _ hA67 (strengthened_seven_anchor_head hw0 hwc)
      · have hD67 : coordNormSq w 6 ≤ coordNormSq w 7 := by
          unfold coordNormSq
          exact AFRateCalibration.fsum_le_of_le
            (fun i => Q'.mul_nonneg _ _
              (coeffW_nonneg hw0 i) (coeffW_nonneg hw0 i)) (by omega)
        have hr0 : (0 : Q') ≤ retuneCube w := qpow_nonneg _
          (Q'.mul_nonneg _ _ (by decide)
            (Q'.zero_le_add _ _ (by decide) hw0)) 3
        exact Q'.le_trans' _ _ _ (strengthened_seven_anchor_head hw0 hwc)
          (Q'.mul_le_mul_of_nonneg_left _ _ _ hD67 hr0)
    · obtain ⟨M, rfl⟩ := Nat.le.dest hlarge
      have hA : adjCorr w (7 + M) ≈ adjCorr w 7 + fsum (edgeTail w) M := by
        unfold adjCorr edgeTail
        exact FusionCoreStepRoundH.fsum_split_at
          (fun a => coeffW w a * coeffW w (a + 1)) 7 M
      have hD : coordNormSq w (7 + M) ≈
          coordNormSq w 6 + fsum (squareTail w) (M + 1) := by
        unfold coordNormSq squareTail
        rw [show 7 + M + 1 = 7 + (M + 1) by omega]
        exact FusionCoreStepRoundH.fsum_split_at
          (fun a => coeffW w a * coeffW w a) 7 (M + 1)
      have hsquare0 : ∀ j, (0 : Q') ≤ squareTail w j := by
        intro j
        unfold squareTail
        exact Q'.mul_nonneg _ _
          (coeffW_nonneg hw0 (7 + j)) (coeffW_nonneg hw0 (7 + j))
      have htailPrefix : fsum (squareTail w) M ≤ fsum (squareTail w) (M + 1) :=
        AFRateCalibration.fsum_le_of_le hsquare0 (by omega)
      have hprefix : coordNormSq w 6 + fsum (squareTail w) M ≤
          coordNormSq w (7 + M) :=
        Q'.le_trans' _ _ _
          (Q'.add_le_add_left (coordNormSq w 6) _ _ htailPrefix)
          (Q'.ge_of_eqv hD)
      have hr0 : (0 : Q') ≤ retuneCube w := qpow_nonneg _
        (Q'.mul_nonneg _ _ (by decide)
          (Q'.zero_le_add _ _ (by decide) hw0)) 3
      have hpaid : adjCorr w 7 + fsum (edgeTail w) M ≤
          retuneCube w * coordNormSq w 6 +
            retuneCube w * fsum (squareTail w) M :=
        AFRateCalibration.q_add_le_add
          (strengthened_seven_anchor_head hw0 hwc)
          (tail_sum_le hw0 hw1 hwp hwc M)
      have hcollect : retuneCube w * coordNormSq w 6 +
          retuneCube w * fsum (squareTail w) M ≈
          retuneCube w * (coordNormSq w 6 + fsum (squareTail w) M) :=
        Q'.eqv_symm (Q'.mul_add_eqv _ _ _)
      exact Q'.le_trans' _ _ _ (Q'.le_of_eqv hA)
        (Q'.le_trans' _ _ _ hpaid
          (Q'.le_trans' _ _ _ (Q'.le_of_eqv hcollect)
            (Q'.mul_le_mul_of_nonneg_left _ _ _ hprefix hr0)))

theorem seven_anchor_ratio_all_cutoffs {w : Q'}
    (hw0 : (0 : Q') ≤ w) (hwc : w ≤ sevenAnchorCap) (N : Nat) :
    Q'.divPos (adjCorr w N) (coordNormSq w N) (coordNormSq_pos hw0 N) ≤
      retuneCube w :=
  Q'.divPos_le_of_le_mul _ _ _ (seven_anchor_retune_all_cutoffs hw0 hwc N)

theorem seven_anchor_lamPW_le_retune {w : Q'}
    (hw0 : (0 : Q') ≤ w) (hwc : w ≤ sevenAnchorCap) (N : Nat) :
    lamPW w N 1 ≤ retuneCube w := by
  have hw1 : w ≤ (1 : Q') := Q'.le_trans' _ _ _ hwc (by decide)
  have heq : lamPW w N 1 ≈
      Q'.divPos (adjCorr w N) (coordNormSq w N) (coordNormSq_pos hw0 N) :=
    Q'.eqv_trans _ _ _ (lamPW_eq_vacNorm_p2 hw0 hw1 N 0)
      (vacNorm_fundamental_eq_ratio hw0 hw1 N)
  exact Q'.le_trans' _ _ _ (Q'.le_of_eqv heq)
    (seven_anchor_ratio_all_cutoffs hw0 hwc N)

/-! ## Harmonic prefix and growing-anchor record -/

theorem harmW_thirteen_mem_window : harmW 13 ≤ sevenAnchorCap := by
  unfold harmW harmU ReciprocalBernoulliUpper.oneSub
    SummableInverseSquare.unit sevenAnchorCap
  decide
theorem harmW_fourteen_mem_window : harmW 14 ≤ sevenAnchorCap := by
  unfold harmW harmU ReciprocalBernoulliUpper.oneSub
    SummableInverseSquare.unit sevenAnchorCap
  decide
theorem harmW_fifteen_mem_window : harmW 15 ≤ sevenAnchorCap := by
  unfold harmW harmU ReciprocalBernoulliUpper.oneSub
    SummableInverseSquare.unit sevenAnchorCap
  decide
theorem harmW_sixteen_mem_window : harmW 16 ≤ sevenAnchorCap := by
  unfold harmW harmU ReciprocalBernoulliUpper.oneSub
    SummableInverseSquare.unit sevenAnchorCap
  decide

theorem harmonicMass_k13_retune_floor :
    (1 : Q') - retuneCube (harmW 13) ≤ harmonicMass 13 := by
  unfold harmonicMass
  exact Q'.add_le_add_left 1 _ _ (Q'.neg_le_neg
    (seven_anchor_lamPW_le_retune (harmW_nonneg 13) harmW_thirteen_mem_window (Ncut 13)))
theorem harmonicMass_k14_retune_floor :
    (1 : Q') - retuneCube (harmW 14) ≤ harmonicMass 14 := by
  unfold harmonicMass
  exact Q'.add_le_add_left 1 _ _ (Q'.neg_le_neg
    (seven_anchor_lamPW_le_retune (harmW_nonneg 14) harmW_fourteen_mem_window (Ncut 14)))
theorem harmonicMass_k15_retune_floor :
    (1 : Q') - retuneCube (harmW 15) ≤ harmonicMass 15 := by
  unfold harmonicMass
  exact Q'.add_le_add_left 1 _ _ (Q'.neg_le_neg
    (seven_anchor_lamPW_le_retune (harmW_nonneg 15) harmW_fifteen_mem_window (Ncut 15)))
theorem harmonicMass_k16_retune_floor :
    (1 : Q') - retuneCube (harmW 16) ≤ harmonicMass 16 := by
  unfold harmonicMass
  exact Q'.add_le_add_left 1 _ _ (Q'.neg_le_neg
    (seven_anchor_lamPW_le_retune (harmW_nonneg 16) harmW_sixteen_mem_window (Ncut 16)))

theorem initial_seventeen_retune {k : Nat} (hk : k ≤ 16) :
    adjCorr (harmW k) (Ncut k) ≤
      retuneCube (harmW k) * coordNormSq (harmW k) (Ncut k) := by
  by_cases hk12 : k ≤ 12
  · exact SixAnchorWindowRetune.initial_thirteen_retune hk12
  · have cases : k = 13 ∨ k = 14 ∨ k = 15 ∨ k = 16 := by omega
    rcases cases with rfl | rfl | rfl | rfl
    · exact seven_anchor_retune_all_cutoffs
        (harmW_nonneg 13) harmW_thirteen_mem_window (Ncut 13)
    · exact seven_anchor_retune_all_cutoffs
        (harmW_nonneg 14) harmW_fourteen_mem_window (Ncut 14)
    · exact seven_anchor_retune_all_cutoffs
        (harmW_nonneg 15) harmW_fifteen_mem_window (Ncut 15)
    · exact seven_anchor_retune_all_cutoffs
        (harmW_nonneg 16) harmW_sixteen_mem_window (Ncut 16)

/-- Exact historical data needed to conjecture a growing-anchor certificate:
`(anchor count, native/elevated head degree, cap numerator, cap denominator)`.
For anchors four through seven the native head degree is `2a²+2a-1`; the
three-anchor certificate required elevation from native degree 23 to 26. -/
def certifiedAnchorPattern : List (Nat × Nat × Nat × Nat) :=
  [(3, 26, 5, 6), (4, 39, 8, 9), (5, 59, 10, 11),
   (6, 83, 13, 14), (7, 111, 17, 18)]

theorem seven_native_head_degree_formula :
    2 * 7 * 7 + 2 * 7 - 1 = 111 := by decide

theorem seven_anchor_ratio_exponent_formula : 2 * 7 + 1 = 15 := by decide

end YMGap.Continuum.SevenAnchorWindowRetune

