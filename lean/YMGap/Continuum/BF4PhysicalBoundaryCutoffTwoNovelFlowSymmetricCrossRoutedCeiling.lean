/-! ## 1. The two routed prefix families -/

def cutoffTwoNovelRoutedPath
    {later : Nat} {pair : Nat × Nat}
    (hpair : pair ∈ cutoffTwoNovelEndpointPairs later) :=
  centralPhysicalFiniteVacuumSectorSimplePositivePath
    cutoffTwoHalfCoupling (by decide) later 0 pair.1 pair.2
    (cutoffTwoNovelEndpointPair_mem_full hpair).1
    (cutoffTwoNovelEndpointPair_mem_full hpair).2

def cutoffTwoNovelRoutedPrefix
    {later : Nat} {pair : Nat × Nat}
    (hpair : pair ∈ cutoffTwoNovelEndpointPairs later)
    (source target : Nat)
    (hedge : (source, target) ∈
      PositiveKernelChainIn.directedEdges
        (cutoffTwoNovelRoutedPath hpair)) :=
  PositiveKernelChainIn.prefixAtDirectedEdge
    (cutoffTwoNovelEndpointPair_mem_full hpair).1
    (cutoffTwoNovelRoutedPath hpair) (source, target) hedge

/-- Product ceilings only on prefixes generated by actual directed-edge
occurrences in the canonical novel paths. -/
structure CutoffTwoNovelRoutedPrefixRatioCeilingAt
    (later : Nat) (rho : Q') : Type 1 where
  rho_nonnegative : (0 : Q') ≤ rho
  source_prefix_product_le : ∀ pair,
    ∀ hpair : pair ∈ cutoffTwoNovelEndpointPairs later,
    ∀ source target,
    ∀ hedge : (source, target) ∈
      PositiveKernelChainIn.directedEdges
        (cutoffTwoNovelRoutedPath hpair),
      cutoffTwoNovelPathReverseForwardProduct later
          (cutoffTwoNovelEndpointPair_mem_full hpair).1
          (cutoffTwoNovelRoutedPrefix hpair source target hedge).pathPrefix ≤
        rho ^ PositiveKernelChainIn.edgeLength
          (cutoffTwoNovelRoutedPrefix hpair source target hedge).pathPrefix
  target_prefix_product_le : ∀ pair,
    ∀ hpair : pair ∈ cutoffTwoNovelEndpointPairs later,
    ∀ source target,
    ∀ hedge : (source, target) ∈
      PositiveKernelChainIn.directedEdges
        (cutoffTwoNovelRoutedPath hpair),
      cutoffTwoNovelPathReverseForwardProduct later
          (cutoffTwoNovelEndpointPair_mem_full hpair).1
          (positiveKernelPrefixThroughEdge
            (cutoffTwoNovelRoutedPrefix hpair source target hedge)) ≤
        rho ^ PositiveKernelChainIn.edgeLength
          (positiveKernelPrefixThroughEdge
            (cutoffTwoNovelRoutedPrefix hpair source target hedge))

namespace CutoffTwoConditionalReverseForwardCeilingAt

/-- A global one-edge ceiling is sufficient, but not necessary, for the two
routed prefix-product families. -/
def toRoutedPrefixRatioCeilingAt
    {later : Nat} {rho : Q'}
    (ceiling : CutoffTwoConditionalReverseForwardCeilingAt later rho) :
    CutoffTwoNovelRoutedPrefixRatioCeilingAt later rho where
  rho_nonnegative := ceiling.rho_nonnegative
  source_prefix_product_le := fun _pair hpair source target hedge =>
    cutoffTwoNovelPathReverseForwardProduct_le_ceilingPow ceiling
      (cutoffTwoNovelEndpointPair_mem_full hpair).1
      (cutoffTwoNovelRoutedPrefix hpair source target hedge).pathPrefix
  target_prefix_product_le := fun _pair hpair source target hedge =>
    cutoffTwoNovelPathReverseForwardProduct_le_ceilingPow ceiling
      (cutoffTwoNovelEndpointPair_mem_full hpair).1
      (positiveKernelPrefixThroughEdge
        (cutoffTwoNovelRoutedPrefix hpair source target hedge))

end CutoffTwoConditionalReverseForwardCeilingAt

/-! ## 2. Routed ceilings bound the two exact product loads -/

theorem cutoffTwoNovelPathPairConditionalTransitionProductTerm_le_routedCeiling
    {later : Nat} {rho : Q'}
    (ceiling : CutoffTwoNovelRoutedPrefixRatioCeilingAt later rho)
    (source target : Nat) (pair : Nat × Nat)
    (hpair : pair ∈ cutoffTwoNovelEndpointPairs later) :
    cutoffTwoNovelPathPairConditionalTransitionProductTerm
        later source target pair ≤
      cutoffTwoNovelPathPairConditionalRatioCeilingTerm
        rho later source target pair := by
  unfold cutoffTwoNovelPathPairConditionalTransitionProductTerm
    cutoffTwoNovelPathPairConditionalRatioCeilingTerm
  rw [dif_pos hpair, dif_pos hpair]
  let path := cutoffTwoNovelRoutedPath hpair
  change
    (if hedge : (source, target) ∈
        PositiveKernelChainIn.directedEdges path then
      let prefixData := cutoffTwoNovelRoutedPrefix
        hpair source target hedge
      (cutoffTwoNovelPathReverseForwardProduct later
          (cutoffTwoNovelEndpointPair_mem_full hpair).1
          prefixData.pathPrefix *
        cutoffTwoEdgeLoadWeight later pair.2) *
      Q'.ofNat (PositiveKernelChainIn.edgeLength path)
    else 0) ≤
    (if hedge : (source, target) ∈
        PositiveKernelChainIn.directedEdges path then
      let prefixData := cutoffTwoNovelRoutedPrefix
        hpair source target hedge
      (rho ^ PositiveKernelChainIn.edgeLength prefixData.pathPrefix *
        cutoffTwoEdgeLoadWeight later pair.2) *
      Q'.ofNat (PositiveKernelChainIn.edgeLength path)
    else 0)
  by_cases hedge : (source, target) ∈
      PositiveKernelChainIn.directedEdges path
  · rw [dif_pos hedge, dif_pos hedge]
    have hproduct := ceiling.source_prefix_product_le
      pair hpair source target hedge
    have hrightWeight :
        (0 : Q') ≤ cutoffTwoEdgeLoadWeight later pair.2 :=
      Q'.le_of_lt
        (centralPhysicalFiniteWeight_pos_of_vacuumSectorIndex
          (w := cutoffTwoHalfCoupling) (hw := by decide)
          (cutoffTwoNovelEndpointPair_mem_full hpair).2)
    have hlength :
        (0 : Q') ≤ Q'.ofNat (PositiveKernelChainIn.edgeLength path) :=
      ExpNeg.ofNat_nonneg' _
    exact Q'.mul_le_mul_of_nonneg_right _ _ _
      (Q'.mul_le_mul_of_nonneg_right _ _ _ hproduct hrightWeight)
      hlength
  · rw [dif_neg hedge, dif_neg hedge]
    exact Q'.le_refl' 0

theorem cutoffTwoNovelConditionalTransitionProductLoad_le_routedCeilingLoad
    {later : Nat} {rho : Q'}
    (ceiling : CutoffTwoNovelRoutedPrefixRatioCeilingAt later rho)
    (source target : Nat) :
    cutoffTwoNovelConditionalTransitionProductLoad later source target ≤
      cutoffTwoNovelConditionalRatioCeilingLoad
        rho later source target := by
  unfold cutoffTwoNovelConditionalTransitionProductLoad
    cutoffTwoNovelConditionalRatioCeilingLoad
  apply listQSum_mono
  intro pair hpair
  exact cutoffTwoNovelPathPairConditionalTransitionProductTerm_le_routedCeiling
    ceiling source target pair hpair

theorem cutoffTwoNovelPathPairConditionalTargetTransitionProductTerm_le_routedCeiling
    {later : Nat} {rho : Q'}
    (ceiling : CutoffTwoNovelRoutedPrefixRatioCeilingAt later rho)
    (source target : Nat) (pair : Nat × Nat)
    (hpair : pair ∈ cutoffTwoNovelEndpointPairs later) :
    cutoffTwoNovelPathPairConditionalTargetTransitionProductTerm
        later source target pair ≤
      cutoffTwoNovelPathPairConditionalTargetRatioCeilingTerm
        rho later source target pair := by
  unfold cutoffTwoNovelPathPairConditionalTargetTransitionProductTerm
    cutoffTwoNovelPathPairConditionalTargetRatioCeilingTerm
  rw [dif_pos hpair, dif_pos hpair]
  let path := cutoffTwoNovelRoutedPath hpair
  change
    (if hedge : (source, target) ∈
        PositiveKernelChainIn.directedEdges path then
      let prefixData := cutoffTwoNovelRoutedPrefix
        hpair source target hedge
      (cutoffTwoNovelPathReverseForwardProduct later
          (cutoffTwoNovelEndpointPair_mem_full hpair).1
          (positiveKernelPrefixThroughEdge prefixData) *
        cutoffTwoEdgeLoadWeight later pair.2) *
      Q'.ofNat (PositiveKernelChainIn.edgeLength path)
    else 0) ≤
    (if hedge : (source, target) ∈
        PositiveKernelChainIn.directedEdges path then
      let prefixData := cutoffTwoNovelRoutedPrefix
        hpair source target hedge
      (rho ^ PositiveKernelChainIn.edgeLength
          (positiveKernelPrefixThroughEdge prefixData) *
        cutoffTwoEdgeLoadWeight later pair.2) *
      Q'.ofNat (PositiveKernelChainIn.edgeLength path)
    else 0)
  by_cases hedge : (source, target) ∈
      PositiveKernelChainIn.directedEdges path
  · rw [dif_pos hedge, dif_pos hedge]
    have hproduct := ceiling.target_prefix_product_le
      pair hpair source target hedge
    have hrightWeight :
        (0 : Q') ≤ cutoffTwoEdgeLoadWeight later pair.2 :=
      Q'.le_of_lt
        (centralPhysicalFiniteWeight_pos_of_vacuumSectorIndex
          (w := cutoffTwoHalfCoupling) (hw := by decide)
          (cutoffTwoNovelEndpointPair_mem_full hpair).2)
    have hlength :
        (0 : Q') ≤ Q'.ofNat (PositiveKernelChainIn.edgeLength path) :=
      ExpNeg.ofNat_nonneg' _
    exact Q'.mul_le_mul_of_nonneg_right _ _ _
      (Q'.mul_le_mul_of_nonneg_right _ _ _ hproduct hrightWeight)
      hlength
  · rw [dif_neg hedge, dif_neg hedge]
    exact Q'.le_refl' 0

theorem cutoffTwoNovelConditionalTargetTransitionProductLoad_le_routedCeilingLoad
    {later : Nat} {rho : Q'}
    (ceiling : CutoffTwoNovelRoutedPrefixRatioCeilingAt later rho)
    (source target : Nat) :
    cutoffTwoNovelConditionalTargetTransitionProductLoad
        later source target ≤
      cutoffTwoNovelConditionalTargetRatioCeilingLoad
        rho later source target := by
  unfold cutoffTwoNovelConditionalTargetTransitionProductLoad
    cutoffTwoNovelConditionalTargetRatioCeilingLoad
  apply listQSum_mono
  intro pair hpair
  exact
    cutoffTwoNovelPathPairConditionalTargetTransitionProductTerm_le_routedCeiling
      ceiling source target pair hpair

theorem cutoffTwoNovelSymmetricCrossTransitionProductLoad_le_routedCeilingLoad
    {later : Nat} {rho : Q'}
    (ceiling : CutoffTwoNovelRoutedPrefixRatioCeilingAt later rho)
    (oldState newState : Nat) :
    cutoffTwoNovelSymmetricCrossTransitionProductLoad
        later oldState newState ≤
      cutoffTwoNovelSymmetricCrossRatioCeilingLoad
        rho later oldState newState := by
  unfold cutoffTwoNovelSymmetricCrossTransitionProductLoad
    cutoffTwoNovelSymmetricCrossRatioCeilingLoad
  exact Q'.add_le_add
    (Q'.mul_le_mul_of_nonneg_left _ _ HalfPow.half
      (cutoffTwoNovelConditionalTransitionProductLoad_le_routedCeilingLoad
        ceiling oldState newState)
      HalfPow.half_nonneg)
    (Q'.mul_le_mul_of_nonneg_left _ _ HalfPow.half
      (cutoffTwoNovelConditionalTargetTransitionProductLoad_le_routedCeilingLoad
        ceiling newState oldState)
      HalfPow.half_nonneg)

/-! ## 3. Routed ceiling and payment certificate -/

structure CutoffTwoNovelSymmetricOldNewRoutedCeilingCapacityAt
    (later : Nat) : Type 1 where
  rho : Q'
  routed_ceiling : CutoffTwoNovelRoutedPrefixRatioCeilingAt later rho
  ceiling_capacity : ∀ oldState,
    oldState ∈ cutoffTwoEdgeLoadOldStates later →
    ∀ newState,
    newState ∈ cutoffTwoEdgeLoadNewStates later →
      cutoffTwoNovelSimpleFlowCoercivityFloor *
          cutoffTwoNovelSymmetricCrossRatioCeilingLoad
            rho later oldState newState ≤
        cutoffTwoEdgeLoadConditionalKernel later oldState newState

namespace CutoffTwoNovelSymmetricOldNewRoutedCeilingCapacityAt

def toTransitionProductCapacityAt
    {later : Nat}
    (capacity :
      CutoffTwoNovelSymmetricOldNewRoutedCeilingCapacityAt later) :
    CutoffTwoNovelSymmetricOldNewTransitionProductCapacityAt later where
  transition_capacity := fun oldState hold newState hnew => by
    have hload :=
      cutoffTwoNovelSymmetricCrossTransitionProductLoad_le_routedCeilingLoad
        capacity.routed_ceiling oldState newState
    have hscaled := Q'.mul_le_mul_of_nonneg_left _ _
      cutoffTwoNovelSimpleFlowCoercivityFloor hload
      (Q'.le_of_lt cutoffTwoNovelSimpleFlowCoercivityFloor_pos)
    exact Q'.le_trans' _ _ _ hscaled
      (capacity.ceiling_capacity oldState hold newState hnew)

end CutoffTwoNovelSymmetricOldNewRoutedCeilingCapacityAt

