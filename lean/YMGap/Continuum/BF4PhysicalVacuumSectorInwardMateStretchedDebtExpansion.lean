/-
# Exact finite expansion of the twelve inward-mate debt factors

The global debt profile ends at a product of `target + stretchedDebt` factors.
Here each distributive term becomes observable as a Boolean word: `false`
chooses the target factor and `true` chooses the stretched debt.  The words
are enumerated structurally from the same attached incidence list.

The all-target term is separated exactly.  Every remaining word contains at
least one stretched choice, and their finite natural-number sum is the named
`cubeInwardMateNonemptyStretchedRemainder`.  Thus the still-open global
strand argument has one precise target: bound this remainder by a uniform
multiple of the pure mate boundary product.

No `Classical`, choice, `native_decide`, `sorry`, custom axiom, noncomputable
declaration, or trusted external computation is used.
-/

import YMGap.Continuum.BF4PhysicalVacuumSectorInwardMateGlobalDebtProfile

namespace YMGap.Continuum.BF4PhysicalVacuumSectorInwardMateStretchedDebtExpansion

open YMGap.Continuum.BF4PhysicalVacuumSectorInwardMateGlobalDebtProfile
open YMGap.Continuum.SU2FundamentalPentagonFiniteGraph
open YMGap.Continuum.Z4DyadicSlabCubeCoupledConditionalKernel
open YMGap.Continuum.Z4HalfTimeReflectionFaceReindex
open YMGap.Continuum.Z4HalfTimeReflectionLinkMultiplicity
open YMGap.Continuum.Z4ValenceFusionCutoffIndependence

/-! ## 1. Observable binary expansion words -/

/-- All target/debt words for a finite factor list.  The head bit controls the
head factor, so word order is visibly aligned with list order. -/
def debtChoiceWords {A : Type} : List A → List (List Bool)
  | [] => [[]]
  | _ :: tail =>
      (debtChoiceWords tail).map (fun word => false :: word) ++
        (debtChoiceWords tail).map (fun word => true :: word)

/-- Exactly the choice words containing at least one debt selection. -/
def nonemptyDebtChoiceWords {A : Type} : List A → List (List Bool)
  | [] => []
  | _ :: tail =>
      (nonemptyDebtChoiceWords tail).map (fun word => false :: word) ++
        (debtChoiceWords tail).map (fun word => true :: word)

/-- Evaluate one word.  Mismatched short words contribute zero; every word
generated by `debtChoiceWords` has the exact required length. -/
def debtChoiceProduct {A : Type}
    (target debt : A → Nat) : List A → List Bool → Nat
  | [], _ => 1
  | _ :: _, [] => 0
  | head :: tail, false :: word =>
      target head * debtChoiceProduct target debt tail word
  | head :: tail, true :: word =>
      debt head * debtChoiceProduct target debt tail word

private theorem natListSum_map_mul_left
    {A : Type} (factor : Nat) (value : A → Nat) : ∀ items : List A,
    natListSum (items.map (fun item => factor * value item)) =
      factor * natListSum (items.map value)
  | [] => by simp [natListSum]
  | item :: rest => by
      simp only [List.map_cons, natListSum]
      rw [natListSum_map_mul_left factor value rest]
      rw [Nat.mul_add]

/-- Full distributive expansion: the sum over all Boolean words is the
original product of two-term factors. -/
theorem debtChoiceWords_sum_eq_product
    {A : Type} (target debt : A → Nat) : ∀ items : List A,
    natListSum
        ((debtChoiceWords items).map
          (debtChoiceProduct target debt items)) =
      natListProduct (fun item => target item + debt item) items
  | [] => rfl
  | head :: tail => by
      simp only [debtChoiceWords, List.map_append, List.map_map,
        natListSum_append, Function.comp_def, debtChoiceProduct,
        natListProduct]
      rw [natListSum_map_mul_left,
        natListSum_map_mul_left,
        debtChoiceWords_sum_eq_product target debt tail]
      rw [Nat.add_mul]

/-- Sum of all expanded terms with at least one stretched-debt choice. -/
def nonemptyDebtExpansion {A : Type}
    (target debt : A → Nat) (items : List A) : Nat :=
  natListSum
    ((nonemptyDebtChoiceWords items).map
      (debtChoiceProduct target debt items))

private theorem nonemptyDebtExpansion_cons
    {A : Type} (target debt : A → Nat) (head : A) (tail : List A) :
    nonemptyDebtExpansion target debt (head :: tail) =
      target head * nonemptyDebtExpansion target debt tail +
        debt head *
          natListProduct (fun item => target item + debt item) tail := by
  unfold nonemptyDebtExpansion
  simp only [nonemptyDebtChoiceWords, List.map_append, List.map_map,
    natListSum_append, Function.comp_def, debtChoiceProduct]
  rw [natListSum_map_mul_left, natListSum_map_mul_left,
    debtChoiceWords_sum_eq_product]

/-- Exact separation of the pure target term from every nonempty debt word. -/
theorem product_target_add_debt_eq_target_add_nonemptyExpansion
    {A : Type} (target debt : A → Nat) : ∀ items : List A,
    natListProduct (fun item => target item + debt item) items =
      natListProduct target items +
        nonemptyDebtExpansion target debt items
  | [] => rfl
  | head :: tail => by
      have ih := product_target_add_debt_eq_target_add_nonemptyExpansion
        target debt tail
      rw [natListProduct, natListProduct,
        ih,
        nonemptyDebtExpansion_cons]
      rw [ih]
      simp only [Nat.add_mul, Nat.mul_add]
      omega

/-! ## 2. The actual twelve-link BF4 remainder -/

def cubeInwardMateTargetBoundaryProduct
    (K : Nat) (physical : EdgeLabelling) : Nat :=
  natListProduct (cubeInwardMateTargetLinkMultiplicity K physical)
    cubeProductionIncidences.attach

def cubeInwardMateNonemptyStretchedRemainder
    (K : Nat) (physical : EdgeLabelling)
    (hK : 1 ≤ K) (hbounded : SlabFaceLabellingBounded K 1 physical) : Nat :=
  nonemptyDebtExpansion
    (cubeInwardMateTargetLinkMultiplicity K physical)
    (cubeInwardMateStretchedDebt K physical hK hbounded)
    cubeProductionIncidences.attach

/-- The named global right side is exactly the pure mate boundary product
plus the observable sum of all nonempty stretched-debt words. -/
theorem cubeInwardMateTargetPlusDebtBoundaryProduct_eq_target_add_remainder
    (K : Nat) (physical : EdgeLabelling)
    (hK : 1 ≤ K) (hbounded : SlabFaceLabellingBounded K 1 physical) :
    cubeInwardMateTargetPlusDebtBoundaryProduct
        K physical hK hbounded =
      cubeInwardMateTargetBoundaryProduct K physical +
        cubeInwardMateNonemptyStretchedRemainder
          K physical hK hbounded :=
  product_target_add_debt_eq_target_add_nonemptyExpansion
    (cubeInwardMateTargetLinkMultiplicity K physical)
    (cubeInwardMateStretchedDebt K physical hK hbounded)
    cubeProductionIncidences.attach

/-- **Expanded global debt bound.**  The full source boundary product is at
most the pure mate product plus the exact nonempty stretched-word remainder. -/
theorem cubeInwardMateSourceBoundaryProduct_le_target_add_remainder
    (K : Nat) (physical : EdgeLabelling)
    (hK : 1 ≤ K) (hbounded : SlabFaceLabellingBounded K 1 physical) :
    cubeInwardMateSourceBoundaryProduct K physical ≤
      cubeInwardMateTargetBoundaryProduct K physical +
        cubeInwardMateNonemptyStretchedRemainder
          K physical hK hbounded := by
  rw [← cubeInwardMateTargetPlusDebtBoundaryProduct_eq_target_add_remainder]
  exact cubeInwardMateSourceBoundaryProduct_le_targetPlusDebt
    K physical hK hbounded

end YMGap.Continuum.BF4PhysicalVacuumSectorInwardMateStretchedDebtExpansion

