        (coeffBlock (by decide))
    exact Q'.le_trans' _ _ _ hsum' (Q'.le_of_eqv h39)
  have h4ww0 := Q'.mul_le_mul_of_nonneg_right ((4 : Q') * w) 1 w hwcap hw0
  have h4ww_le_w : (4 : Q') * (w * w) ≤ w := by
    have hassoc : (4 : Q') * (w * w) ≈ ((4 : Q') * w) * w :=
      Q'.eqv_symm (Q'.mul_assoc_eqv 4 w w)
    exact Q'.le_trans' _ _ _ (Q'.le_of_eqv hassoc)
      (Q'.le_trans' _ _ _ h4ww0 (Q'.le_of_eqv (Q'.one_mul_eqv w)))
  have h16ww : (16 : Q') * (w * w) ≤ (1 : Q') := by
    have hsplit : (16 : Q') * (w * w) ≈ (4 : Q') * ((4 : Q') * (w * w)) := by
      refine Q'.eqv_trans _ _ _
        (Q'.mul_eqv_congr_right _ _ (w * w)
          (by decide : (16 : Q') ≈ (4 : Q') * 4)) ?_
      exact Q'.mul_assoc_eqv 4 4 (w * w)
    have hstep := Q'.mul_le_mul_of_nonneg_left ((4 : Q') * (w * w)) w
      (4 : Q') h4ww_le_w (by decide)
    exact Q'.le_trans' _ _ _ (Q'.le_of_eqv hsplit)
      (Q'.le_trans' _ _ _ hstep hwcap)
  have hscaled := Q'.mul_le_mul_of_nonneg_left ((16 : Q') * (w * w)) 1
    (16384 : Q') h16ww (by decide)
  have hbig : (262144 : Q') * (w * w) ≤ (16384 : Q') := by
    have heq : (262144 : Q') * (w * w) ≈
        (16384 : Q') * ((16 : Q') * (w * w)) := by
      refine Q'.eqv_trans _ _ _
        (Q'.mul_eqv_congr_right _ _ (w * w)
          (by decide : (262144 : Q') ≈ (16384 : Q') * 16)) ?_
      exact Q'.mul_assoc_eqv 16384 16 (w * w)
    exact Q'.le_trans' _ _ _ (Q'.le_of_eqv heq)
      (Q'.le_trans' _ _ _ hscaled
        (Q'.le_of_eqv (Q'.mul_one_eqv 16384)))
  have hxobj0 : (0 : Q') ≤ w * w := Q'.mul_nonneg _ _ hw0 hw0
  have hmono := Q'.mul_le_mul_of_nonneg_right (253764 : Q') 262144 (w * w)
    (by decide) hxobj0
  exact Q'.le_trans' _ _ _ hmass
    (Q'.le_trans' _ _ _ hmono
      (Q'.le_trans' _ _ _ hbig (by decide)))

/-- The positive-coefficient part of the reduced quotient is nonnegative. -/
theorem r12Tail_nonneg {w h : Q'} (hw0 : (0 : Q') ≤ w)
    (hh0 : (0 : Q') ≤ h) :
    (0 : Q') ≤ RingNormaliser.eval
      (fun i => if i = 0 then w else h) r12TailExpr := by
  apply eval_nonneg_of_coefficients
  · intro i
    by_cases hi : i = 0
    · simp [hi, hw0]
    · simp [hi, hh0]
  · decide

/-- The reduced factor is nonnegative on the physical simplex. -/
theorem r12Reduced_nonneg {w h : Q'}
    (hh0 : (0 : Q') ≤ h) (hhw : h ≤ w)
    (hwcap : (4 : Q') * w ≤ (1 : Q')) :
    (0 : Q') ≤ RingNormaliser.eval
      (fun i => if i = 0 then w else h) r12ReducedExpr := by
  let rho : Nat → Q' := fun i => if i = 0 then w else h
  have hw0 : (0 : Q') ≤ w := Q'.le_trans' _ _ _ hh0 hhw
  have ht := r12Tail_nonneg hw0 hh0
  have ha := r12Adverse_paid hh0 hhw hwcap
  change (0 : Q') ≤
    ((19440 : Q') + RingNormaliser.eval rho r12TailExpr) +
      -RingNormaliser.eval rho r12AdverseExpr
  exact Q'.sub_nonneg_of_le
    (Q'.le_trans' _ _ _ ha
      (Q'.add_le_self_of_nonneg 19440
        (RingNormaliser.eval rho r12TailExpr) ht))

/-- The full square quotient at `(1,2)` is nonnegative. -/
theorem residualQuotient_one_two_nonneg {w h : Q'}
    (hh0 : (0 : Q') ≤ h) (hhw : h ≤ w)
    (hwcap : (4 : Q') * w ≤ (1 : Q')) :
    (0 : Q') ≤ RingNormaliser.eval
      (fun i => if i = 0 then w else h) (residualQuotientExpr 1 2) := by
  let rho : Nat → Q' := fun i => if i = 0 then w else h
  have hw0 : (0 : Q') ≤ w := Q'.le_trans' _ _ _ hh0 hhw
  have hcommon : (0 : Q') ≤ RingNormaliser.eval rho r12CommonExpr := by
    change (0 : Q') ≤
      RingNormaliser.qpow w 46 * RingNormaliser.qpow h 46
    exact Q'.mul_nonneg _ _ (rnqpow_nonneg hw0 46) (rnqpow_nonneg hh0 46)
  have hreduced : (0 : Q') ≤ RingNormaliser.eval rho r12ReducedExpr :=
    r12Reduced_nonneg hh0 hhw hwcap
  have hprod : (0 : Q') ≤
      RingNormaliser.eval rho (.mul r12CommonExpr r12ReducedExpr) :=
    Q'.mul_nonneg _ _ hcommon hreduced
  have hn := RingNormaliser.poly_identity_of_normal_eq _ _ quotientNormal12 rho
  exact Q'.le_trans' _ _ _ hprod (Q'.ge_of_eqv hn)

/-- Exact square-Abel factorization at `(1,2)`, stated semantically. -/
theorem boundaryResidualAt_one_two_factor (w h : Q') :
    boundaryResidualAt w h 1 2 ≈
      (RingNormaliser.qpow w 2 + -(RingNormaliser.qpow h 2)) *
        RingNormaliser.eval (fun i => if i = 0 then w else h)
          (residualQuotientExpr 1 2) := by
  have hn := RingNormaliser.poly_identity_of_normal_eq _ _ factorNormal12
    (fun i => if i = 0 then w else h)
  exact Q'.eqv_trans _ _ _
    (boundaryResidualAt_eq_eval_residualExpr w h 1 2) hn

/-- **Row-one residual positivity at offset 2.**  `R(1,2) >= 0` on the
full physical simplex. -/
theorem boundaryResidualAt_one_two_nonneg {w h : Q'}
    (hh0 : (0 : Q') ≤ h) (hhw : h ≤ w)
    (hwcap : (4 : Q') * w ≤ (1 : Q')) :
    (0 : Q') ≤ boundaryResidualAt w h 1 2 := by
  have hsq : (0 : Q') ≤
      RingNormaliser.qpow w 2 + -(RingNormaliser.qpow h 2) :=
    Q'.sub_nonneg_of_le
      (Q'.le_trans' _ _ _ (Q'.le_of_eqv (rnqpow_eqv_qpow h 2))
        (Q'.le_trans' _ _ _ (HeatKernelGap.qpow_mono hh0 hhw 2)
          (Q'.ge_of_eqv (rnqpow_eqv_qpow w 2))))
  have hp := Q'.mul_nonneg _ _ hsq
    (residualQuotient_one_two_nonneg hh0 hhw hwcap)
  exact Q'.le_trans' _ _ _ hp
    (Q'.ge_of_eqv (boundaryResidualAt_one_two_factor w h))

