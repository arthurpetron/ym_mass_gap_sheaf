/-
# Same-object continuum realization of the dynamic completed BF4 path

The preceding observable compiler produces a genuine physical separator from
the literal completed BF4 autocorrelations and constructs the correct
fixed-physical-time sampling.  The generic continuum modules separately know
how to remove an exact logarithmic rate, pass sampled stage correlators to one
projective OS functional, and identify that correlator and rate with one OS
reconstruction.  This file makes their source-specific commuting square.

`DynamicVacuumSectorContinuumHandoff` contains only the remaining analytic
and semantic inputs: a Cauchy modulus for the exact rate, one projective/OS
correlation handoff for the separator generated by the completed observable
pin, the nonzero reconstruction spectral-channel identification, and
convergence of the same exact cutoff-rate sequence to the reconstruction's
logarithmic gap.  From these fields the standard
`PhysicalSeparatorContinuumRealization` is constructed.

An exact full-range upper rate bound remains explicit.  A two-sided bound on
the margin `(1-q_j)/a_j` does not by itself supply a global upper bound on
`-log(q_j)/a_j` when a coarse-scale `q_j` may be very small.  Keeping this
field visible prevents a hidden infinite-mass or rate-currency substitution.

No handoff, projective continuum measure, continuum Yang--Mills existence,
OS spectral-channel pin, exact-rate convergence, or Clay conclusion is
inhabited here.  No `Classical.*`, choice, `native_decide`, `sorry`, custom
axiom, or noncomputable declaration is used.
-/

import YMGap.Continuum.BF4PhysicalDynamicVacuumSectorObservablePath
import YMGap.Continuum.ExactRateReconstructionHandoff
import YMGap.Continuum.ProjectiveOSCorrelationHandoff

namespace YMGap.Continuum.BF4PhysicalDynamicVacuumSectorContinuumRealization

set_option maxRecDepth 1000000
set_option maxHeartbeats 10000000
set_option autoImplicit false

open YMGap.Constructive
open YMGap.Continuum
open YMGap.Continuum.BF4PhysicalDynamicVacuumSectorCompletedFamily
open YMGap.Continuum.BF4PhysicalDynamicVacuumSectorObservablePath
open YMGap.Continuum.ContinuumMeasure
open YMGap.Continuum.ExactRateReconstructionHandoff
open YMGap.Continuum.FourDExistence
open YMGap.Continuum.MeasureLinkedOSReconstruction
open YMGap.Continuum.PhysicalSeparator
open YMGap.Continuum.PhysicalSeparatorContinuumRealization
open YMGap.Continuum.PhysicalSeparatorFullLogComparison
open YMGap.Continuum.PhysicalSeparatorFullLogRate
open YMGap.Continuum.ProjectiveOSCorrelationHandoff
open YMGap.Continuum.TuranPositivity

namespace DynamicVacuumSectorObservablePin

/-! ## 1. The exact logarithmic certificate on the pinned separator -/

/-- The full-range exact physical logarithmic rate of the definitionally same
separator and transfer spacing generated by the completed observable pin. -/
def fullRangeRateFamily
    {half : Nat}
    {family : DynamicVacuumSectorCompletedFamily half}
    (pin : DynamicVacuumSectorObservablePin family) :
    FullRangeExactPhysicalLogRateFamily pin.toPhysicalSeparator :=
  fullRangeRateFamilyOfPhysicalData pin.toPhysicalSeparator
    family.transferSpacing.spacing family.transferSpacing.spacing_pos

/-- Add the genuinely independent full-log upper bound to the compiled
physical margin floor. -/
def exactCertificate
    {half : Nat}
    {family : DynamicVacuumSectorCompletedFamily half}
    (pin : DynamicVacuumSectorObservablePin family)
    (band : DynamicVacuumSectorPhysicalRateBand family)
    (ceiling : FullRangeLogRateCeiling (fullRangeRateFamily pin)) :
    FullRangeExactPhysicalSeparatorCertificate :=
  fullRangeExactCertificateOfPhysicalGapFloor pin.toPhysicalSeparator
    family.transferSpacing.spacing family.transferSpacing.spacing_pos
    (pin.toPhysicalGapFloor band) ceiling

/-! ## 2. The remaining analytic/semantic handoff -/

/-- The exact remaining bridge from the completed BF4 observable path to one
projective continuum Yang--Mills/OS reconstruction.

Every field is attached to `pin.toPhysicalSeparator`, `pin.physicalSampling`,
and `pin.exactCertificate band ceiling`; hence an inhabitant cannot choose an
unrelated correlator, spacing schedule, rate sequence, or reconstruction after
the finite completed estimate has been proved. -/
structure DynamicVacuumSectorContinuumHandoff
    {half : Nat}
    {family : DynamicVacuumSectorCompletedFamily half}
    (pin : DynamicVacuumSectorObservablePin family)
    (band : DynamicVacuumSectorPhysicalRateBand family)
    (ceiling : FullRangeLogRateCeiling (fullRangeRateFamily pin))
    {M : Nat -> Type} {mu : ContinuumMeasure M}
    (existence : ContinuumYMExistence mu)
    (osGNS : MeasureLinkedOSGNSData existence) : Type 2 where
  rateCauchy : CReal.ModCauchyEv
    (exactCertificate pin band ceiling).rateFamily.rate
  projectiveOS : ProjectiveOSCorrelationHandoff pin.toPhysicalSeparator
    existence osGNS pin.physicalSampling
  spectralChannel :
    ProjectiveOSCorrelationHandoff.ReconstructionSpectralChannelHandoff
      projectiveOS osGNS.reconstruction
  exactRate : ExactRateReconstructionHandoff
    (exactCertificate pin band ceiling) osGNS.reconstruction

namespace DynamicVacuumSectorContinuumHandoff

/-! ## 3. Compile the commuting square -/

/-- The exact-rate Cauchy modulus and the already-stored spacing modulus give
the quantitative cutoff removal for the same certificate. -/
def cutoffRemoval
    {half : Nat}
    {family : DynamicVacuumSectorCompletedFamily half}
    {pin : DynamicVacuumSectorObservablePin family}
    {band : DynamicVacuumSectorPhysicalRateBand family}
    {ceiling : FullRangeLogRateCeiling (fullRangeRateFamily pin)}
    {M : Nat -> Type} {mu : ContinuumMeasure M}
    {existence : ContinuumYMExistence mu}
    {osGNS : MeasureLinkedOSGNSData existence}
    (handoff : DynamicVacuumSectorContinuumHandoff
      pin band ceiling existence osGNS) :
    ExactRateCutoffRemoval (exactCertificate pin band ceiling) :=
  (ExactRateLimitData.ofRateCauchy handoff.rateCauchy).withSpacing
    family.transferSpacingToZero

/-- Assemble the standard same-object continuum realization.  The continuum
correlator is the limit of the physically sampled completed-path correlator,
and the continuum mass is the limit of the exact logarithmic rate of the same
separator. -/
def toContinuumRealization
    {half : Nat}
    {family : DynamicVacuumSectorCompletedFamily half}
    {pin : DynamicVacuumSectorObservablePin family}
    {band : DynamicVacuumSectorPhysicalRateBand family}
    {ceiling : FullRangeLogRateCeiling (fullRangeRateFamily pin)}
    {M : Nat -> Type} {mu : ContinuumMeasure M}
    {existence : ContinuumYMExistence mu}
    {osGNS : MeasureLinkedOSGNSData existence}
    (handoff : DynamicVacuumSectorContinuumHandoff
      pin band ceiling existence osGNS) :
    PhysicalSeparatorContinuumRealization
      (exactCertificate pin band ceiling) mu where
  stageCorrelators := handoff.projectiveOS.stageCorrelators
  projectiveIdentification :=
    handoff.projectiveOS.projectiveIdentification
  cutoffRemoval := handoff.cutoffRemoval
  physicalSampling := pin.physicalSampling
  continuumCorrelators := handoff.projectiveOS.continuumCorrelators
  existence := existence
  osGNS := osGNS
  reconstructionCorrelators :=
    handoff.projectiveOS.reconstructionCorrelators
      osGNS.reconstruction handoff.spectralChannel
  osConnectedTwoPoint := handoff.projectiveOS.osConnectedTwoPoint
  osGapCorrelation :=
    handoff.projectiveOS.osGapCorrelation
      osGNS.reconstruction handoff.spectralChannel
  exactGap := handoff.exactRate.exactLogGapAt handoff.rateCauchy

/-- Export the conditional continuum Yang--Mills exact-log-gap endpoint. -/
def toContinuumYMWithExactLogGap
    {half : Nat}
    {family : DynamicVacuumSectorCompletedFamily half}
    {pin : DynamicVacuumSectorObservablePin family}
    {band : DynamicVacuumSectorPhysicalRateBand family}
    {ceiling : FullRangeLogRateCeiling (fullRangeRateFamily pin)}
    {M : Nat -> Type} {mu : ContinuumMeasure M}
    {existence : ContinuumYMExistence mu}
    {osGNS : MeasureLinkedOSGNSData existence}
    (handoff : DynamicVacuumSectorContinuumHandoff
      pin band ceiling existence osGNS) :
    ContinuumYMWithExactLogGap (exactCertificate pin band ceiling) mu :=
  handoff.toContinuumRealization.toContinuumYMWithExactLogGap

/-- The constructed continuum mass retains the explicit positive physical
floor of the dynamic band. -/
theorem continuumMass_posEv
    {half : Nat}
    {family : DynamicVacuumSectorCompletedFamily half}
    {pin : DynamicVacuumSectorObservablePin family}
    {band : DynamicVacuumSectorPhysicalRateBand family}
    {ceiling : FullRangeLogRateCeiling (fullRangeRateFamily pin)}
    {M : Nat -> Type} {mu : ContinuumMeasure M}
    {existence : ContinuumYMExistence mu}
    {osGNS : MeasureLinkedOSGNSData existence}
    (handoff : DynamicVacuumSectorContinuumHandoff
      pin band ceiling existence osGNS) :
    TuranPositivity.PosEv
      (PhysicalSeparatorContinuumRealization.endpointMass
        handoff.toContinuumYMWithExactLogGap) :=
  PhysicalSeparatorContinuumRealization.endpointMass_posEv
    handoff.toContinuumYMWithExactLogGap

/-- The OS connected two-point insertion and the reconstructed spectral
channel are the same physically sampled continuum correlator. -/
theorem osGapCorr_equiv_spectral
    {half : Nat}
    {family : DynamicVacuumSectorCompletedFamily half}
    {pin : DynamicVacuumSectorObservablePin family}
    {band : DynamicVacuumSectorPhysicalRateBand family}
    {ceiling : FullRangeLogRateCeiling (fullRangeRateFamily pin)}
    {M : Nat -> Type} {mu : ContinuumMeasure M}
    {existence : ContinuumYMExistence mu}
    {osGNS : MeasureLinkedOSGNSData existence}
    (handoff : DynamicVacuumSectorContinuumHandoff
      pin band ceiling existence osGNS)
    (time : Nat) :
    CReal.Equiv
      (CReal.ofQ' (existence.os_axioms.E.E
        (handoff.projectiveOS.osConnectedTwoPoint.connectedInsertion
          handoff.projectiveOS.osConnectedTwoPoint.gapInsertion time)))
      (CReal.ofQ'
        (SpectralGap.corr osGNS.reconstruction.spec time)) :=
  handoff.toContinuumRealization.osGapCorr_equiv_spectral time

end DynamicVacuumSectorContinuumHandoff

end DynamicVacuumSectorObservablePin

end YMGap.Continuum.BF4PhysicalDynamicVacuumSectorContinuumRealization

