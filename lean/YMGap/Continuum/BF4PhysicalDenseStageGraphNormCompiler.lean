/-! ## 1. Pointwise representative lift of the selected Wilson transfer -/

/-- The selected linear Wilson transfer together with the exact pointwise law
for its chosen Cauchy lift.

The quotient equation in `LinearTransferOperator.T_ofCauchy` alone does not
identify the terms of `TCauchy X`.  This strengthening records precisely that
the chosen lift applies the selected observable time shift `tau` termwise. -/
structure WilsonPointwiseLinearTimeTranslationPin
    {A : ObservableMeasure.ObsAlg}
    {W : WilsonGNS.WilsonGNSData A}
    (P : WilsonGNSTransferUnderdetermination.WilsonTimeTranslationPin W) :
    Type where
  linear : WilsonLinearTimeTranslationPin P
  pointwise : forall (X : CauchyGNS W.toGNSData) (n : Nat),
    W.toGNSData.veq
      ((linear.linearOperator.TCauchy X).seq n)
      (P.tau (X.seq n))

/-! ## 2. Literal dense finite-stage approximants -/

/-- A dense continuum observable sampled from `X` and mapped into the finite
physical BF4 carrier at `scale`. -/
def denseStageApproximant
    {family : MatchedBlockFamily}
    {coupling : Nat -> Q'}
    {M : Nat -> Type} {mu : ContinuumMeasure.ContinuumMeasure M}
    {H : FourDExistence.ContinuumYMExistence mu}
    (D : WilsonSelectedOSGNSData H)
    (sampleIndex : Nat -> Nat)
    (stageObservable : forall scale : Nat,
      D.wilson.toGNSData.V ->
        (MatchedPhysicalStageGNSData family coupling scale).V)
    (X : SelectedWilsonCauchy D) (scale : Nat) :
    MatchedPhysicalStageCauchy family coupling scale :=
  constCauchy (MatchedPhysicalStageGNSData family coupling scale)
    (stageObservable scale (X.seq (sampleIndex scale)))

/-- The exact finite norm stream generated by the dense-stage approximants. -/
def denseStageNormSequence
    {family : MatchedBlockFamily}
    {coupling : Nat -> Q'}
    {M : Nat -> Type} {mu : ContinuumMeasure.ContinuumMeasure M}
    {H : FourDExistence.ContinuumYMExistence mu}
    (D : WilsonSelectedOSGNSData H)
    (sampleIndex : Nat -> Nat)
    (stageObservable : forall scale : Nat,
      D.wilson.toGNSData.V ->
        (MatchedPhysicalStageGNSData family coupling scale).V)
    (X : SelectedWilsonCauchy D) : Nat -> CReal :=
  fun scale => matchedPhysicalStageNorm family coupling scale
    (denseStageApproximant D sampleIndex stageObservable X scale)

/-- The exact maps and intertwining laws shared by the two dense-stage limit
interfaces below.  No norm convergence is included in this record. -/
structure BF4WilsonDenseStageMapData
    {family : MatchedBlockFamily}
    {law : CubicMarginLaw family}
    {spacing : PhysicalSpacingEnvelope law.g₁}
    {coupling : Nat -> Q'}
    {P : PhysicalSeparator}
    (producer : BF4QuarterPhysicalSeparatorProducer
      family law spacing coupling P)
    {M : Nat -> Type} {mu : ContinuumMeasure.ContinuumMeasure M}
    {H : FourDExistence.ContinuumYMExistence mu}
    (D : WilsonSelectedOSGNSData H) : Type 3 where
  separatorPinned : D.selectedSpectralData.gap.sep = bf4MacroNormRate
  pointwiseTimeTranslation :
    WilsonPointwiseLinearTimeTranslationPin D.timeTranslation
  /-- Explicit diagonal reindexing of a continuum Cauchy representative. -/
  sampleIndex : Nat -> Nat
  /-- Cross-scale map from continuum dense observables to literal finite BF4
  observables. -/
  stageObservable : forall scale : Nat,
    D.wilson.toGNSData.V ->
      (MatchedPhysicalStageGNSData family coupling scale).V
  /-- The finite-stage map respects the continuum carrier equivalence. -/
  stageObservable_congr : forall scale : Nat,
    forall {a b : D.wilson.toGNSData.V}, D.wilson.toGNSData.veq a b ->
      (MatchedPhysicalStageGNSData family coupling scale).veq
        (stageObservable scale a) (stageObservable scale b)
  /-- The concrete finite macro transfer exactly intertwines with the selected
  continuum observable shift. -/
  stageTransfer_intertwines : forall (scale : Nat)
    (a : D.wilson.toGNSData.V),
      (MatchedPhysicalStageGNSData family coupling scale).veq
        (centralPhysicalMarkovApply
          (matchedAllSpinWeight family coupling scale)
          (matchedAllSpinWeight_nonnegative family coupling scale)
          (matchedAllSpinCutoff family coupling scale) 0
          (stageObservable scale a))
        (stageObservable scale (D.timeTranslation.tau a))
  /-- Continuum vacuum-complement vectors map into every finite vacuum
  complement. -/
  stage_vacuumOrthogonal : forall
    (X : SelectedWilsonCauchy D),
    D.selectedSpectralData.vacPerp (selectedWilsonPoint D X) ->
      forall scale : Nat,
        CentralPhysicalModulatedVacuumOrthogonal
          (matchedAllSpinWeight family coupling scale)
          (matchedAllSpinWeight_nonnegative family coupling scale)
          (matchedAllSpinCutoff family coupling scale) 0
          (matchedPhysicalStagePoint family coupling scale
            (denseStageApproximant D sampleIndex stageObservable X scale))

/-- Dense finite-stage data sufficient to construct the full linear
graph-norm approximation.

The only norm-limit input is `normCauchy` plus `normLimitPinned`.  Both expose
their constructive content: `ModCauchyEv` contains an outer modulus, inner
regularity moduli, and eventual approximation thresholds. -/
structure BF4WilsonDenseStageApproximation
    {family : MatchedBlockFamily}
    {law : CubicMarginLaw family}
    {spacing : PhysicalSpacingEnvelope law.g₁}
    {coupling : Nat -> Q'}
    {P : PhysicalSeparator}
    (producer : BF4QuarterPhysicalSeparatorProducer
      family law spacing coupling P)
    {M : Nat -> Type} {mu : ContinuumMeasure.ContinuumMeasure M}
    {H : FourDExistence.ContinuumYMExistence mu}
    (D : WilsonSelectedOSGNSData H)
    extends BF4WilsonDenseStageMapData producer D where
  /-- Type-level Cauchy data for the single finite norm stream. -/
  normCauchy : forall X : SelectedWilsonCauchy D,
    CReal.ModCauchyEv
      (denseStageNormSequence D sampleIndex stageObservable X)
  /-- The limit constructed from that explicit modulus denotes the actual
  continuum representative norm. -/
  normLimitPinned : forall X : SelectedWilsonCauchy D,
    CReal.Equiv
      (CReal.completeLimitCauchy
        (denseStageNormSequence D sampleIndex stageObservable X)
        (normCauchy X))
      (D.wilson.toGNSData.cinnerRep X X)

namespace BF4WilsonDenseStageApproximation

variable
    {family : MatchedBlockFamily}
    {law : CubicMarginLaw family}
    {spacing : PhysicalSpacingEnvelope law.g₁}
    {coupling : Nat -> Q'}
    {P : PhysicalSeparator}
    {producer : BF4QuarterPhysicalSeparatorProducer
      family law spacing coupling P}
    {M : Nat -> Type} {mu : ContinuumMeasure.ContinuumMeasure M}
    {H : FourDExistence.ContinuumYMExistence mu}
    {D : WilsonSelectedOSGNSData H}
    (data : BF4WilsonDenseStageApproximation producer D)

/-- Pointwise carrier equivalence gives a null relation between Cauchy
representatives, with the constant outer threshold `0`. -/
private theorem cauchyNull_of_pointwise_veq
    {E : GNSData} {X Y : CauchyGNS E}
    (h : forall n, E.veq (X.seq n) (Y.seq n)) : CauchyNull E X Y := by
  intro epsilon hepsilon
  exact ⟨0, fun n _ =>
    le_of_eqv_le (rad_of_veq E (h n)) (Q'.le_of_lt hepsilon)⟩

/-- The finite transfer of a dense-stage approximant is null-equivalent to
the dense-stage approximant of the chosen continuum `TCauchy` lift. -/
theorem transferredApproximant_null
    (X : SelectedWilsonCauchy D) (scale : Nat) :
    CauchyNull (MatchedPhysicalStageGNSData family coupling scale)
      (matchedPhysicalStageTransferCauchy family coupling scale
        (denseStageApproximant D data.sampleIndex data.stageObservable X scale))
      (denseStageApproximant D data.sampleIndex data.stageObservable
        (data.pointwiseTimeTranslation.linear.linearOperator.TCauchy X)
        scale) := by
  apply cauchyNull_of_pointwise_veq
  intro n
  change (MatchedPhysicalStageGNSData family coupling scale).veq
    (centralPhysicalMarkovApply
      (matchedAllSpinWeight family coupling scale)
      (matchedAllSpinWeight_nonnegative family coupling scale)
      (matchedAllSpinCutoff family coupling scale) 0
      (data.stageObservable scale (X.seq (data.sampleIndex scale))))
    (data.stageObservable scale
      ((data.pointwiseTimeTranslation.linear.linearOperator.TCauchy X).seq
        (data.sampleIndex scale)))
  exact (MatchedPhysicalStageGNSData family coupling scale).veq_trans
    (data.stageTransfer_intertwines scale
      (X.seq (data.sampleIndex scale)))
    ((MatchedPhysicalStageGNSData family coupling scale).veq_symm
      (data.stageObservable_congr scale
        (data.pointwiseTimeTranslation.pointwise X
          (data.sampleIndex scale))))

/-- At each scale, the transferred finite norm is equivalent to the ordinary
finite norm stream evaluated on the continuum transfer representative. -/
theorem transferredStageNorm_equiv
    (X : SelectedWilsonCauchy D) (scale : Nat) :
    CReal.Equiv
      (matchedPhysicalStageTransferredNorm family coupling scale
        (denseStageApproximant D data.sampleIndex data.stageObservable X scale))
      (denseStageNormSequence D data.sampleIndex data.stageObservable
        (data.pointwiseTimeTranslation.linear.linearOperator.TCauchy X) scale) := by
  exact (MatchedPhysicalStageGNSData family coupling scale).cinnerRep_welldef
    _ _ _ _ (data.transferredApproximant_null X scale)
      (data.transferredApproximant_null X scale)

/-- The one explicit `ModCauchyEv` record constructs ordinary norm
convergence to the actual continuum representative norm. -/
theorem norm_converges (X : SelectedWilsonCauchy D) :
    CReal.ConvergesTo
      (denseStageNormSequence D data.sampleIndex data.stageObservable X)
      (D.wilson.toGNSData.cinnerRep X X) :=
  CReal.convergesTo_limit_congr
    (CReal.convergesTo_completeLimitCauchy
      (denseStageNormSequence D data.sampleIndex data.stageObservable X)
      (data.normCauchy X))
    (data.normLimitPinned X)

/-- Transferred-norm convergence follows from the same norm modulus applied
to `TCauchy X` and the two exact intertwining laws. -/
theorem transferredNorm_converges (X : SelectedWilsonCauchy D) :
    CReal.ConvergesTo
      (fun scale => matchedPhysicalStageTransferredNorm family coupling scale
        (denseStageApproximant D data.sampleIndex data.stageObservable X scale))
      (D.wilson.toGNSData.cinnerRep
        (data.pointwiseTimeTranslation.linear.linearOperator.TCauchy X)
        (data.pointwiseTimeTranslation.linear.linearOperator.TCauchy X)) := by
  apply YMGap.Constructive.TrigAddCReal.convergesTo_congr_seq
    (fun scale => CReal.Equiv.symm (data.transferredStageNorm_equiv X scale))
  exact data.norm_converges
    (data.pointwiseTimeTranslation.linear.linearOperator.TCauchy X)

/-- Compile literal dense-stage data into the already-verified linear
graph-norm limit interface.  In particular, no independent transferred-norm
convergence field is consumed. -/
def toLinearGraphNormLimitApproximation :
    BF4WilsonLinearGraphNormLimitApproximation producer D where
  separatorPinned := data.separatorPinned
  linearTimeTranslation := data.pointwiseTimeTranslation.linear
  approximant := denseStageApproximant D data.sampleIndex data.stageObservable
  approximant_vacuumOrthogonal := data.stage_vacuumOrthogonal
  norm_converges := data.norm_converges
  transferredNorm_converges := data.transferredNorm_converges

/-- Dense-stage maps, exact intertwining, and one explicit norm modulus imply
the selected continuum Wilson operator gap. -/
def toWilsonOperatorNormGapPin : WilsonOperatorNormGapPin D :=
  data.toLinearGraphNormLimitApproximation.toWilsonOperatorNormGapPin

end BF4WilsonDenseStageApproximation

/-! ## 3. Construct the norm modulus from summable cross-scale variation -/

/-- A still more causal dense-stage interface: adjacent finite-stage norms
move by a summable nonnegative error stream, eventually at each rational
approximation depth.

`SummableCRealEventualStepVariation` exposes the local step threshold, the
variation tail, an antitone tail rate, and inner regularity data.  Its
telescoping theorem constructs the `ModCauchyEv` field consumed above. -/
structure BF4WilsonDenseStageEventualVariationApproximation
    {family : MatchedBlockFamily}
    {law : CubicMarginLaw family}
    {spacing : PhysicalSpacingEnvelope law.g₁}
    {coupling : Nat -> Q'}
    {P : PhysicalSeparator}
    (producer : BF4QuarterPhysicalSeparatorProducer
      family law spacing coupling P)
    {M : Nat -> Type} {mu : ContinuumMeasure.ContinuumMeasure M}
    {H : FourDExistence.ContinuumYMExistence mu}
    (D : WilsonSelectedOSGNSData H)
    extends BF4WilsonDenseStageMapData producer D where
  /-- Summable eventual two-sided variation of the exact finite norm stream. -/
  normVariation : forall X : SelectedWilsonCauchy D,
    SummableCRealEventualStepVariation
      (denseStageNormSequence D sampleIndex stageObservable X)
  /-- The limit built from the telescoped step bounds is the actual continuum
  representative norm. -/
  normLimitPinned : forall X : SelectedWilsonCauchy D,
    CReal.Equiv
      (CReal.completeLimitCauchy
        (denseStageNormSequence D sampleIndex stageObservable X)
        (normVariation X).toModCauchyEv)
      (D.wilson.toGNSData.cinnerRep X X)

namespace BF4WilsonDenseStageEventualVariationApproximation

variable
    {family : MatchedBlockFamily}
    {law : CubicMarginLaw family}
    {spacing : PhysicalSpacingEnvelope law.g₁}
    {coupling : Nat -> Q'}
    {P : PhysicalSeparator}
    {producer : BF4QuarterPhysicalSeparatorProducer
      family law spacing coupling P}
    {M : Nat -> Type} {mu : ContinuumMeasure.ContinuumMeasure M}
    {H : FourDExistence.ContinuumYMExistence mu}
    {D : WilsonSelectedOSGNSData H}
    (data : BF4WilsonDenseStageEventualVariationApproximation producer D)

/-- Telescoping the summable adjacent-scale error constructs the dense-stage
`ModCauchyEv` interface. -/
def toDenseStageApproximation :
    BF4WilsonDenseStageApproximation producer D where
  toBF4WilsonDenseStageMapData := data.toBF4WilsonDenseStageMapData
  normCauchy := fun X => (data.normVariation X).toModCauchyEv
  normLimitPinned := data.normLimitPinned

/-- Summable cross-scale norm variation plus the exact dense maps constructs
the linear graph-norm limit interface. -/
def toLinearGraphNormLimitApproximation :
    BF4WilsonLinearGraphNormLimitApproximation producer D :=
  data.toDenseStageApproximation.toLinearGraphNormLimitApproximation

/-- The summable cross-scale interface therefore constructs the selected
continuum Wilson operator norm gap. -/
def toWilsonOperatorNormGapPin : WilsonOperatorNormGapPin D :=
  data.toDenseStageApproximation.toWilsonOperatorNormGapPin

end BF4WilsonDenseStageEventualVariationApproximation

end YMGap.Continuum.BF4PhysicalDenseStageGraphNormCompiler

