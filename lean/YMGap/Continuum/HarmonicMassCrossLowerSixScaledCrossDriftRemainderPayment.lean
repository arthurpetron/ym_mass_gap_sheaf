/-
Quadratic lower payment from the exact lower-six drift remainder.

The first-order Bernoulli floor misses the cross-scale inequality by a small
amount.  The missing sign is not numerical: the exact drift factor contains
the positive quadratic binomial coefficient at every exponent.  This file
extracts that coefficient constructively, transports it through the positive
right-suffix carriers, and packages the resulting sum as a certified lower
bound for the full exact-minus-linear remainder.
-/

import YMGap.Continuum.HarmonicMassCrossLowerSixScaledCrossDriftScaleStep

namespace YMGap.Continuum.HarmonicMassCrossLowerSixScaledCrossDriftRemainderPayment

set_option maxHeartbeats 5000000
set_option maxRecDepth 100000

open YMGap.Constructive
open YMGap.Constructive.RationalTail
open YMGap.Continuum
open YMGap.Continuum.BondMovingRelResidual
open YMGap.Continuum.HarmonicGrowingAnchorPF2
open YMGap.Continuum.HarmonicMassCrossLowerSixInteriorAbel
open YMGap.Continuum.HarmonicMassCrossLowerSixScaledCrossDriftCarrier
open YMGap.Continuum.HarmonicMassCrossLowerSixScaledCrossDriftPayment
open YMGap.Continuum.HarmonicMassCrossLowerSixScaledCrossDriftScaleStep
open YMGap.Continuum.HarmonicMassCrossLowerSixScaledCrossDriftSuffix
open YMGap.Continuum.HarmonicMassCrossLowerSixScaledWindowInduction
open YMGap.Continuum.HarmonicMovingDeterminantThetaWindow
open YMGap.Continuum.HarmonicWeightDriftFence
open YMGap.Continuum.HarmonicWeightedAbelReserve
open YMGap.Continuum.RGTransport
open YMGap.Continuum.SummableInverseSquare

local infix:50 " ≈ " => Q'.eqv

private theorem remainder_payment_neg_num_cast (a : Q') :
    (-a).num = -(a.num) := rfl

local macro "remainder_payment_ring" : tactic =>
  `(tactic| (show _ * (_ : Int) = _ * (_ : Int);
             simp only [Q'.add_num_cast, Q'.add_den_cast,
               Q'.mul_num_cast, Q'.mul_den_cast, Q'.neg_den,
               remainder_payment_neg_num_cast, Q'.ofNat_num_cast,
               Q'.ofNat_den_cast,
               show (1 : Q').num = 1 from rfl,
               show ((1 : Q').den : Int) = 1 from rfl,
               show (0 : Q').num = 0 from rfl,
               show ((0 : Q').den : Int) = 1 from rfl,
               Int.add_mul, Int.mul_add, Int.neg_mul, Int.mul_neg,
               Int.neg_add, Int.neg_neg, Int.neg_zero, Int.zero_mul,
               Int.mul_zero, Int.one_mul, Int.mul_one];
             ac_rfl))

/-- Subtraction-free triangular coefficient `m choose 2`. -/
def lowerSixQuadraticCoeff : Nat → Nat
  | 0 => 0
  | m + 1 => lowerSixQuadraticCoeff m + m

private theorem quadratic_step_algebra (M C u : Q') :
    (((1 : Q') + M * u) + C * (u * u)) * ((1 : Q') + u) ≈
      (((1 : Q') + (M + 1) * u) + (C + M) * (u * u)) +
        C * (u * (u * u)) := by
  remainder_payment_ring

private theorem quadratic_step_eqv (u : Q') (m : Nat) :
    (((1 : Q') + Q'.ofNat m * u) +
        Q'.ofNat (lowerSixQuadraticCoeff m) * (u * u)) *
          ((1 : Q') + u) ≈
      (((1 : Q') + Q'.ofNat (m + 1) * u) +
        Q'.ofNat (lowerSixQuadraticCoeff (m + 1)) * (u * u)) +
          Q'.ofNat (lowerSixQuadraticCoeff m) * (u * (u * u)) := by
  have hm : Q'.ofNat (m + 1) ≈ Q'.ofNat m + (1 : Q') := by
    exact Q'.eqv_trans _ _ _ (Q'.ofNat_add_eqv m 1)
      (Q'.add_eqv_congr_left _ _ _ (by decide))
  have hc : Q'.ofNat (lowerSixQuadraticCoeff (m + 1)) ≈
      Q'.ofNat (lowerSixQuadraticCoeff m) + Q'.ofNat m := by
    rw [lowerSixQuadraticCoeff]
    exact Q'.ofNat_add_eqv _ _
  refine Q'.eqv_trans _
    ((((1 : Q') + (Q'.ofNat m + 1) * u) +
      (Q'.ofNat (lowerSixQuadraticCoeff m) + Q'.ofNat m) * (u * u)) +
        Q'.ofNat (lowerSixQuadraticCoeff m) * (u * (u * u))) _ ?_ ?_
  · exact quadratic_step_algebra _ _ _
  · exact Q'.add_eqv_congr_right _ _ _
      (Q'.add_eqv_congr'
        (Q'.add_eqv_congr_left (1 : Q') _ _
          (Q'.mul_eqv_congr_right _ _ u (Q'.eqv_symm hm)))
        (Q'.mul_eqv_congr_right _ _ (u * u) (Q'.eqv_symm hc)))

/-- Constructive second-order Bernoulli lower bound.  The coefficient is
generated by Pascal recurrence, so no division or choice enters the proof. -/
theorem qpow_one_add_quadratic_lower {u : Q'} (hu : (0 : Q') ≤ u) :
    ∀ m,
      ((1 : Q') + Q'.ofNat m * u) +
          Q'.ofNat (lowerSixQuadraticCoeff m) * (u * u) ≤
        qpow ((1 : Q') + u) m
  | 0 => by
      exact Q'.le_of_eqv (Q'.eqv_trans _ _ _
        (Q'.add_eqv_congr'
          (Q'.add_eqv_congr_left (1 : Q') _ _ (Q'.zero_mul_eqv u))
          (Q'.zero_mul_eqv (u * u)))
        (Q'.eqv_trans _ _ _ (QPoly.q_add_zero_eqv _)
          (QPoly.q_add_zero_eqv _)))
  | m + 1 => by
      let r := (1 : Q') + u
      let L := ((1 : Q') + Q'.ofNat m * u) +
        Q'.ofNat (lowerSixQuadraticCoeff m) * (u * u)
      let T := ((1 : Q') + Q'.ofNat (m + 1) * u) +
        Q'.ofNat (lowerSixQuadraticCoeff (m + 1)) * (u * u)
      let E := Q'.ofNat (lowerSixQuadraticCoeff m) * (u * (u * u))
      have hr0 : (0 : Q') ≤ r := by
        dsimp only [r]
        exact Q'.zero_le_add _ _ (by decide) hu
      have hmul : L * r ≤ qpow r m * r :=
        Q'.mul_le_mul_of_nonneg_right _ _ r
          (qpow_one_add_quadratic_lower hu m) hr0
      have hu3 : (0 : Q') ≤ u * (u * u) :=
        Q'.mul_nonneg _ _ hu (Q'.mul_nonneg _ _ hu hu)
      have hE : (0 : Q') ≤ E :=
        Q'.mul_nonneg _ _ (HeatKernelRGStep.zero_le_ofNat _) hu3
      have hstep : T ≤ L * r := by
        have hadd := Q'.add_le_self_of_nonneg T E hE
        exact Q'.le_trans' _ _ _ hadd
          (Q'.le_of_eqv
            (Q'.eqv_symm (by
              dsimp only [L, T, E, r]
              exact quadratic_step_eqv u m)))
      change T ≤ qpow r m * r
      exact Q'.le_trans' _ _ _ hstep hmul

private theorem square_one_add_eqv (u : Q') :
    ((1 : Q') + u) * ((1 : Q') + u) ≈
      (1 : Q') + ((u + u) + u * u) := by
  remainder_payment_ring

private theorem lowerSix_squaredDriftBase_eqv (k : Nat) :
    driftRatio k * driftRatio k ≈
      (1 : Q') + lowerSixDriftExcess k := by
  let u := unit (driftDen k) (driftDen_pos k)
  have hr := driftRatio_eqv_one_add_unitDen k
  refine Q'.eqv_trans _
    (((1 : Q') + u) * ((1 : Q') + u)) _ ?_ ?_
  · exact Q'.eqv_trans _ _ _
      (Q'.mul_eqv_congr_right _ _ _ hr)
      (Q'.mul_eqv_congr_left _ _ _ hr)
  · unfold lowerSixDriftExcess
    dsimp only [u]
    exact square_one_add_eqv u

/-- The explicit quadratic term beyond the linear drift floor. -/
def lowerSixWeightDriftQuadratic (k n : Nat) : Q' :=
  Q'.ofNat (lowerSixQuadraticCoeff (n * n)) *
    (lowerSixDriftExcess k * lowerSixDriftExcess k)

/-- The linear-plus-quadratic polynomial is a genuine lower bound for the
exact exponential drift factor at every scale and mode. -/
theorem lowerSixWeightDriftFloor_add_quadratic_le_factor (k n : Nat) :
    lowerSixWeightDriftFloor k n + lowerSixWeightDriftQuadratic k n ≤
      lowerSixWeightDriftFactor k n := by
  have hbase := lowerSix_squaredDriftBase_eqv k
  have hpow := qpow_eqv_congr_base hbase (n * n)
  have hquad := qpow_one_add_quadratic_lower
    (lowerSixDriftExcess_nonnegative k) (n * n)
  unfold lowerSixWeightDriftFloor lowerSixWeightDriftQuadratic
    lowerSixWeightDriftFactor
  exact Q'.le_trans' _ _ _ hquad
    (Q'.le_of_eqv (Q'.eqv_symm hpow))

/-- The extracted quadratic coefficient is paid by the exact-minus-linear
drift remainder, with no asymptotic or measured constant. -/
theorem lowerSixWeightDriftQuadratic_le_remainder (k n : Nat) :
    lowerSixWeightDriftQuadratic k n ≤
      lowerSixWeightDriftRemainder k n := by
  have h := Q'.add_le_add_right _ _
    (-lowerSixWeightDriftFloor k n)
    (lowerSixWeightDriftFloor_add_quadratic_le_factor k n)
  have hleft :
      (lowerSixWeightDriftFloor k n + lowerSixWeightDriftQuadratic k n) +
          -lowerSixWeightDriftFloor k n ≈
        lowerSixWeightDriftQuadratic k n := by
    let F := lowerSixWeightDriftFloor k n
    let Q := lowerSixWeightDriftQuadratic k n
    change (F + Q) + -F ≈ Q
    refine Q'.eqv_trans _ ((F + -F) + Q) _ ?_ ?_
    · refine Q'.eqv_trans _ (F + (Q + -F)) _
        (Q'.add_assoc_eqv F Q (-F)) ?_
      exact Q'.eqv_trans _ (F + (-F + Q)) _
        (Q'.add_eqv_congr_left F _ _ (Q'.add_comm_eqv Q (-F)))
        (Q'.eqv_symm (Q'.add_assoc_eqv F (-F) Q))
    · refine Q'.eqv_trans _ (0 + Q) _
        (Q'.add_eqv_congr_right _ _ Q (Q'.add_neg_self_eqv F)) ?_
      exact QPoly.q_zero_add_eqv Q
  unfold lowerSixWeightDriftRemainder
  exact Q'.le_trans' _ _ _
    (Q'.le_of_eqv (Q'.eqv_symm hleft)) h

/-- Quadratic portion of the scaled exact carrier remainder. -/
def lowerSixScaledDriftQuadratic (k n : Nat) : Q' :=
  Q'.ofNat (k + 3) * lowerSixWeightDriftQuadratic k n *
    lowerSixModeCarrier (k + 1) n

/-- On the retained suffix the exact scaled remainder dominates its explicit
quadratic binomial payment. -/
theorem lowerSixScaledDriftQuadratic_le_remainder
    {k : Nat} (hk : 48 ≤ k) (j : Nat) :
    lowerSixScaledDriftQuadratic k (thetaWindowRight k + 1 + j) ≤
      lowerSixScaledDriftRemainder k
        (thetaWindowRight k + 1 + j) := by
  let n0 := thetaWindowRight k + 1 + j
  let A := Q'.ofNat (k + 3)
  let C := lowerSixModeCarrier (k + 1) n0
  have hAC0 : (0 : Q') ≤ A * C :=
    Q'.mul_nonneg _ _ (HeatKernelRGStep.zero_le_ofNat _)
      (lowerSixNextModeCarrier_nonnegative hk j)
  have hquad : lowerSixWeightDriftQuadratic k n0 ≤
      lowerSixWeightDriftRemainder k n0 :=
    lowerSixWeightDriftQuadratic_le_remainder k n0
  have hmul : (A * C) * lowerSixWeightDriftQuadratic k n0 ≤
      (A * C) * lowerSixWeightDriftRemainder k n0 :=
    Q'.mul_le_mul_of_nonneg_left _ _ (A * C) hquad hAC0
  unfold lowerSixScaledDriftQuadratic lowerSixScaledDriftRemainder
  dsimp only [n0, A, C] at hmul ⊢
  exact Q'.le_trans' _ _ _
    (Q'.le_of_eqv (by remainder_payment_ring))
    (Q'.le_trans' _ _ _ hmul (Q'.le_of_eqv (by remainder_payment_ring)))

/-- Old-weighted quadratic payment over the complete retained right suffix. -/
def lowerSixScaledQuadraticCrossWindowSuffix (k : Nat) : Q' :=
  finSum
    (fun j => lowerSixModeWeight k (thetaWindowRight k + 1 + j) *
      lowerSixScaledDriftQuadratic k
        (thetaWindowRight k + 1 + j))
    (growingAnchor k - thetaWindowRight k)

/-- The summed quadratic payment is a certified lower bound for the complete
exact-minus-linear suffix. -/
theorem lowerSixScaledQuadraticCrossWindowSuffix_le_remainder
    {k : Nat} (hk : 48 ≤ k) :
    lowerSixScaledQuadraticCrossWindowSuffix k ≤
      lowerSixScaledRemainderCrossWindowSuffix k := by
  unfold lowerSixScaledQuadraticCrossWindowSuffix
    lowerSixScaledRemainderCrossWindowSuffix
  exact CharacterTail.finSum_le_termwise _ _ (fun j =>
    Q'.mul_le_mul_of_nonneg_left _ _ _
      (lowerSixScaledDriftQuadratic_le_remainder hk j)
      (lowerSixModeWeight_nonnegative k _)) _

/-- The quadratic binomial payment is already sufficient whenever it covers
the signed linear prefix/suffix residual; the exact remainder then closes the
physical scaled step by monotonicity. -/
theorem lowerSixScaledWindowStep_of_quadratic_payment
    {k : Nat} (hk : 48 ≤ k)
    (hpay : -lowerSixScaledLinearCrossPaymentResidual k ≤
      lowerSixScaledQuadraticCrossWindowSuffix k) :
    LowerSixScaledWindowStep k := by
  exact lowerSixScaledWindowStep_of_linearResidual_payment hk
    (Q'.le_trans' _ _ _ hpay
      (lowerSixScaledQuadraticCrossWindowSuffix_le_remainder hk))

