/-
# Permutation invariance of fusion-complete local SU(2) multiplicities

The left-associated path formula is order-sensitive at an undersized
auxiliary cutoff.  At the production cutoff `linkAuxiliaryCutoff K = 6*K`,
however, every channel generated by at most six cutoff-`K` external spins is
present.  This module develops the constructive recoupling step needed to
recover permutation invariance in that fusion-complete window.

The first theorem below is the four-leg associativity bijection.  It maps a
left intermediate channel to the constant-shift channel constructed in
`RacahInhabit`; its inverse is the corresponding reverse shift.  Thus the
proof is an exact list permutation, not a cardinality postulate or numerical
check.
-/

import YMGap.Continuum.Z4FusionPathZeroInsertion
import YMGap.Continuum.PentagonRelation
import YMGap.Continuum.CayleyPruferInjection
import YMGap.Continuum.Z4CanonicalPolymerUniverse

namespace YMGap.Continuum.Z4FusionMultiplicityPermutation

set_option maxRecDepth 100000
set_option maxHeartbeats 3000000

open YMGap.Continuum.BondMovingStep
open YMGap.Continuum.CayleyPruferInjection
open YMGap.Continuum.FusionCoreStepRoundD
open YMGap.Continuum.RacahInhabit
open YMGap.Continuum.Z4ExplicitValenceFusionMultiplicity
open YMGap.Continuum.Z4FusionPathZeroInsertion

private theorem range_nodup_local (n : Nat) :
    (List.range n).Nodup := by
  induction n with
  | zero => exact List.nodup_nil
  | succ n ih =>
      rw [List.range_succ]
      apply List.nodup_append.mpr
      refine ⟨ih, List.nodup_cons.mpr ⟨List.not_mem_nil,
        List.nodup_nil⟩, ?_⟩
      intro left hleft right hright heq
      have hrightEq : right = n := List.mem_singleton.mp hright
      rw [heq, hrightEq] at hleft
      exact absurd (List.mem_range.mp hleft) (Nat.lt_irrefl n)

def leftCouplingChannels
    (cutoff a b c d : Nat) : List Nat :=
  (List.range (cutoff + 1)).filter fun e =>
    fusionOK a b e && fusionOK e c d

def rightCouplingChannels
    (cutoff a b c d : Nat) : List Nat :=
  (List.range (cutoff + 1)).filter fun f =>
    fusionOK b c f && fusionOK f a d

def couplingShift (a b c d e : Nat) : Nat :=
  e + fLo a b c d - eLo a b c d

def couplingUnshift (a b c d f : Nat) : Nat :=
  f + eLo a b c d - fLo a b c d

theorem couplingShift_injective_on_left
    {a b c d left right : Nat}
    (hleft₁ : fusionOK a b left = true)
    (hleft₂ : fusionOK left c d = true)
    (hright₁ : fusionOK a b right = true)
    (hright₂ : fusionOK right c d = true)
    (heq : couplingShift a b c d left =
      couplingShift a b c d right) :
    left = right := by
  have hlowerLeft := (valid_e hleft₁ hleft₂).1
  have hlowerRight := (valid_e hright₁ hright₂).1
  unfold couplingShift at heq
  omega

theorem couplingShift_unshift
    {a b c d f : Nat}
    (hfirst : fusionOK b c f = true)
    (hsecond : fusionOK f a d = true) :
    couplingShift a b c d (couplingUnshift a b c d f) = f := by
  have hsecond' : fusionOK a f d = true := by
    rw [fusionOK_symm_ab]
    exact hsecond
  have hlower := (valid_f hfirst hsecond').1
  unfold couplingShift couplingUnshift
  omega

/-- The valid intermediate channels in the two four-leg coupling schemes are
constructively permuted by the Racah constant shift.  The two pair-sum bounds
are exactly what ensures that both the shift and its inverse remain inside
the enumerated auxiliary window. -/
theorem leftCouplingChannels_shift_perm
    {cutoff a b c d : Nat}
    (hab : a + b ≤ cutoff)
    (hbc : b + c ≤ cutoff) :
    ((leftCouplingChannels cutoff a b c d).map
        (couplingShift a b c d)).Perm
      (rightCouplingChannels cutoff a b c d) := by
  apply YMGap.Continuum.Z4CanonicalPolymerUniverse.perm_of_nodup_mem_iff
  · apply nodup_map_of_injOn
      (couplingShift a b c d)
      (leftCouplingChannels cutoff a b c d)
      (List.filter_sublist.nodup (range_nodup_local _))
    intro left hleft right hright heq
    have hleftAllowed := (List.mem_filter.mp hleft).2
    have hrightAllowed := (List.mem_filter.mp hright).2
    simp only [Bool.and_eq_true] at hleftAllowed hrightAllowed
    exact couplingShift_injective_on_left
      hleftAllowed.1 hleftAllowed.2
      hrightAllowed.1 hrightAllowed.2 heq
  · exact List.filter_sublist.nodup (range_nodup_local _)
  · intro channel
    constructor
    · intro hchannel
      obtain ⟨source, hsource, hsourceEq⟩ := List.mem_map.mp hchannel
      rw [← hsourceEq]
      have hsourceAllowed := (List.mem_filter.mp hsource).2
      simp only [Bool.and_eq_true] at hsourceAllowed
      have hshiftValid := fstar_valid
        hsourceAllowed.1 hsourceAllowed.2
      apply List.mem_filter.mpr
      refine ⟨List.mem_range.mpr ?_, ?_⟩
      · have hsourceRange := (List.mem_filter.mp hsource).1
        have hsourceLe := List.mem_range.mp hsourceRange
        have hsourceEndpoints := valid_e
          hsourceAllowed.1 hsourceAllowed.2
        have hshiftLe := fstar_le a b c d source
          hsourceEndpoints.1 hsourceEndpoints.2.1
        have htop := fHi_le_bc a b c d
        unfold couplingShift
        omega
      · simp only [Bool.and_eq_true]
        refine ⟨hshiftValid.1, ?_⟩
        rw [fusionOK_symm_ab]
        exact hshiftValid.2
    · intro hchannel
      have hchannelAllowed := (List.mem_filter.mp hchannel).2
      simp only [Bool.and_eq_true] at hchannelAllowed
      have hsecond' : fusionOK a channel d = true := by
        rw [fusionOK_symm_ab]
        exact hchannelAllowed.2
      let source := couplingUnshift a b c d channel
      have hsourceValid := estar_valid hchannelAllowed.1 hsecond'
      apply List.mem_map.mpr
      refine ⟨source, ?_, ?_⟩
      · apply List.mem_filter.mpr
        refine ⟨List.mem_range.mpr ?_, ?_⟩
        · have hchannelEndpoints := valid_f
            hchannelAllowed.1 hsecond'
          have hsourceLe := estar_le a b c d channel
            hchannelEndpoints.1 hchannelEndpoints.2.1
          have htop := eHi_le_ab a b c d
          dsimp [source, couplingUnshift]
          omega
        · simp only [Bool.and_eq_true]
          exact hsourceValid
      · dsimp [source]
        exact couplingShift_unshift
          hchannelAllowed.1 hchannelAllowed.2

/-- Finite-window fusion associativity at a channel-complete cutoff. -/
theorem oneChannelMultiplicity_assoc
    {cutoff a b c d : Nat}
    (hab : a + b ≤ cutoff)
    (hbc : b + c ≤ cutoff) :
    oneChannelMultiplicity cutoff a b c d =
      oneChannelMultiplicity cutoff b c a d := by
  change (leftCouplingChannels cutoff a b c d).length =
    (rightCouplingChannels cutoff a b c d).length
  have hlength :=
    (leftCouplingChannels_shift_perm (d := d) hab hbc).length_eq
  simpa only [List.length_map] using hlength

end YMGap.Continuum.Z4FusionMultiplicityPermutation

