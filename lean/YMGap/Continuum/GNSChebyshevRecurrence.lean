/-
# The literal first-kind Chebyshev recurrence on one completion

The first component of the checked coupled energy state is generated by the
usual two-step operator recurrence. Self-adjointness supplies the required
additive laws for the operator through nondegeneracy of the completed pairing.
No contraction, spectral theorem, or gap input is used here.
-/

import YMGap.Continuum.GNSChebyshevEnergy

namespace YMGap.Continuum.GNSChebyshevRecurrence

set_option autoImplicit false

open YMGap.Constructive
open YMGap.Constructive.CReal
open YMGap.Continuum.GNSQuotient
open YMGap.Continuum.GNSChebyshevEnergy
open YMGap.Continuum.RingNormaliser

variable {D : GNSData} (X : GNSCompletionSpace D → GNSCompletionSpace D)

private theorem rc_add_zero (a : RC) : RCadd a RCzero = a := by
  refine Quotient.inductionOn a ?_
  intro A
  exact Quotient.sound (SumOfSquares.Equiv_of_approx_eqv (fun n =>
    Q'.eqv_of_eq (Q'.add_zero' (A.approx n))))

private theorem rc_sub_zero (a : RC) : RCsub a RCzero = a := by
  refine Quotient.inductionOn a ?_
  intro A
  exact Quotient.sound (SumOfSquares.Equiv_of_approx_eqv (fun n =>
    poly_identity_of_normal_eq
      (.add (.var 0) (.neg (.const 0))) (.var 0)
      (by decide) (fun _ => A.approx n)))

private theorem rc_shuffle (a b c d : RC) :
    RCsub (RCadd a b) (RCadd c d) =
      RCsub (RCadd a (RCsub b d)) c := by
  refine Quotient.inductionOn₃ a b c ?_
  intro A B C
  refine Quotient.inductionOn d ?_
  intro E
  exact Quotient.sound (SumOfSquares.Equiv_of_approx_eqv (fun n =>
    poly_identity_of_normal_eq
      (.add (.add (.var 0) (.var 1))
        (.neg (.add (.var 2) (.var 3))))
      (.add (.add (.var 0) (.add (.var 1) (.neg (.var 3))))
        (.neg (.var 2)))
      (by decide)
      (fun | 0 => A.approx n | 1 => B.approx n
           | 2 => C.approx n | _ => E.approx n)))

private theorem cSub_add_shuffle (a b c d : GNSCompletionSpace D) :
    D.cSub (D.cAdd a b) (D.cAdd c d) =
      D.cSub (D.cAdd a (D.cSub b d)) c := by
  apply GNSDenseCompletionLaws.eq_of_pairings_equal
  intro z
  rw [D.cinnerCompl_cSub_left, D.cinnerCompl_cAdd_left,
    D.cinnerCompl_cAdd_left, D.cinnerCompl_cSub_left,
    D.cinnerCompl_cAdd_left, D.cinnerCompl_cSub_left, rc_shuffle]

private theorem cAdd_zero (a : GNSCompletionSpace D) :
    D.cAdd a (embedV D D.zero) = a := by
  apply GNSDenseCompletionLaws.eq_of_pairings_equal
  intro z
  rw [D.cinnerCompl_cAdd_left, D.cinnerCompl_embedZero_left, rc_add_zero]

private theorem cSub_zero (a : GNSCompletionSpace D) :
    D.cSub a (embedV D D.zero) = a := by
  apply GNSDenseCompletionLaws.eq_of_pairings_equal
  intro z
  rw [D.cinnerCompl_cSub_left, D.cinnerCompl_embedZero_left, rc_sub_zero]

variable (hsa : ∀ x y, D.cinnerCompl (X x) y = D.cinnerCompl x (X y))

include hsa in
private theorem X_zero : X (embedV D D.zero) = embedV D D.zero := by
  apply GNSDenseCompletionLaws.eq_of_pairings_equal
  intro z
  rw [hsa, D.cinnerCompl_embedZero_left, D.cinnerCompl_embedZero_left]

include hsa in
/-- Self-adjointness alone forces additivity on the separated completion. -/
theorem X_add (a b : GNSCompletionSpace D) :
    X (D.cAdd a b) = D.cAdd (X a) (X b) := by
  apply GNSDenseCompletionLaws.eq_of_pairings_equal
  intro z
  rw [hsa, D.cinnerCompl_cAdd_left, D.cinnerCompl_cAdd_left,
    hsa, hsa]

include hsa in
/-- Likewise for subtraction, without a separately assumed linearity field. -/
theorem X_sub (a b : GNSCompletionSpace D) :
    X (D.cSub a b) = D.cSub (X a) (X b) := by
  apply GNSDenseCompletionLaws.eq_of_pairings_equal
  intro z
  rw [hsa, D.cinnerCompl_cSub_left, D.cinnerCompl_cSub_left,
    hsa, hsa]

/-- First component of the actual coupled state, with no polynomial surrogate. -/
def first (x : GNSCompletionSpace D) (n : Nat) : GNSCompletionSpace D :=
  (state X x n).1

theorem first_zero (x : GNSCompletionSpace D) : first X x 0 = x := rfl

include hsa in
theorem first_one (x : GNSCompletionSpace D) : first X x 1 = X x := by
  change D.cSub (X (D.cAdd x (X (embedV D D.zero))))
      (embedV D D.zero) = X x
  rw [X_zero X hsa, cAdd_zero, cSub_zero]

include hsa in
private theorem step_twice_first (t u : GNSCompletionSpace D) :
    (step X (step X t u).1 (step X t u).2).1 =
      D.cSub (D.cAdd (X (step X t u).1) (X (step X t u).1)) t := by
  let v := D.cAdd t (X u)
  change D.cSub (X (D.cAdd (D.cSub (X v) u) (X v))) v =
    D.cSub (D.cAdd (X (D.cSub (X v) u)) (X (D.cSub (X v) u))) t
  rw [X_add X hsa]
  change D.cSub (D.cAdd (X (D.cSub (X v) u)) (X (X v)))
      (D.cAdd t (X u)) = _
  rw [cSub_add_shuffle]
  rw [← X_sub X hsa (X v) u]

include hsa in
theorem first_succ_succ (x : GNSCompletionSpace D) (n : Nat) :
    first X x (n + 2) =
      D.cSub (D.cAdd (X (first X x (n + 1)))
        (X (first X x (n + 1)))) (first X x n) := by
  unfold first
  change (step X (step X (state X x n).1 (state X x n).2).1
      (step X (state X x n).1 (state X x n).2).2).1 = _
  exact step_twice_first X hsa (state X x n).1 (state X x n).2

#print axioms X_add
#print axioms X_sub
#print axioms first
#print axioms first_zero
#print axioms first_one
#print axioms first_succ_succ

end YMGap.Continuum.GNSChebyshevRecurrence
