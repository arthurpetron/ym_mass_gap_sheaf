/-
# A finite binary-surface certificate for the cutoff-one BF4 Haar-five values

The active boundary of one four-cube has 24 plaquettes.  Its closed binary
two-chains form a rank-seven space, hence exactly 128 surfaces.  This module
checks that finite space directly from seven bit-mask generators.  It then
computes the vertex/edge/face census, the topological Haar weight of every
surface, and the two sparse heat polynomials needed by the five-cycle moment
calculation.

The certificate is intentionally independent of the 116-link expression.  A
separate bridge theorem must still identify the gauge-fixed Haar label sum
with this finite surface sum; no such identification is assumed here.

## Axiom gate

Finite `Nat`, `List`, and exact-rational kernel computation only.  No
`Classical.*`, `native_decide`, `sorry`, custom axiom, choice, or
`noncomputable` declaration.
-/

import YMGap.Constructive.QPoly

namespace YMGap.Continuum.BF4CutoffOneBinarySurfaceCertificate

open YMGap.Constructive
open YMGap.Constructive.QPoly

set_option maxRecDepth 200000
set_option maxHeartbeats 12000000

/-! ## The rank-seven closed-surface space -/

/-- Seven independent closed binary two-chains in the 24-face ordering. -/
def binarySurfaceBasis : List Nat :=
  [2707861, 1049766, 35128, 2167232, 4333056, 8642560, 16515072]

/-- XOR the basis vectors selected by the low bits of `coefficient`. -/
def xorBasisMask : Nat → List Nat → Nat
  | _, [] => 0
  | coefficient, basis :: rest =>
      Nat.xor (if coefficient % 2 = 1 then basis else 0)
        (xorBasisMask (coefficient / 2) rest)

/-- All `2^7 = 128` binary surfaces generated by the basis. -/
def binarySurfaceMasks : List Nat :=
  (List.range 128).map fun coefficient =>
    xorBasisMask coefficient binarySurfaceBasis

/-- The 32 edge-incidence rows of the 24-face boundary complex. -/
def edgeIncidenceMasks : List Nat :=
  [7, 25, 42, 52, 196, 336, 416, 1538,
   2568, 3104, 5248, 6400, 24577, 40968, 49168, 81984,
   98560, 139776, 165888, 200704, 786433, 1310722, 1572868, 2621504,
   3145856, 4456960, 5243904, 6295552, 8658944, 8929280, 10551296, 12713984]

/-- The 16 vertex-incidence rows of the 24-face boundary complex. -/
def vertexIncidenceMasks : List Nat :=
  [63, 500, 3626, 7584, 57369, 115024, 174600, 235776,
   1835015, 3670212, 5506562, 7345280, 9199617, 11092032, 12984832, 14880768]

/-- Number of selected face bits lying in an incidence mask. -/
def maskIntersectionCount (carrier mask : Nat) : Nat :=
  ((List.range 24).filter fun index =>
    carrier.testBit index && mask.testBit index).length

/-- A two-chain is closed when every edge has even face incidence. -/
def surfaceIsClosed (mask : Nat) : Bool :=
  edgeIncidenceMasks.all fun edge =>
    decide (maskIntersectionCount edge mask % 2 = 0)

def surfaceFaceCount (mask : Nat) : Nat :=
  maskIntersectionCount ((2 ^ 24) - 1) mask

def surfaceEdgeCount (mask : Nat) : Nat :=
  (edgeIncidenceMasks.filter fun edge =>
    decide (0 < maskIntersectionCount edge mask)).length

def surfaceVertexCount (mask : Nat) : Nat :=
  (vertexIncidenceMasks.filter fun vertex =>
    decide (0 < maskIntersectionCount vertex mask)).length

structure SurfaceTopology where
  vertices : Nat
  edges : Nat
  faces : Nat
  euler : Nat
  deriving DecidableEq, Repr

def surfaceTopology (mask : Nat) : SurfaceTopology :=
  let vertices := surfaceVertexCount mask
  let edges := surfaceEdgeCount mask
  let faces := surfaceFaceCount mask
  { vertices := vertices
    edges := edges
    faces := faces
    euler := vertices + faces - edges }

def topologyCount (target : SurfaceTopology) : Nat :=
  (binarySurfaceMasks.filter fun mask =>
    decide (surfaceTopology mask = target)).length

/-- The seven generators really give 128 distinct closed two-chains. -/
theorem binarySurfaceMasks_complete :
    binarySurfaceBasis.length = 7 ∧
    binarySurfaceMasks.length = 128 ∧
    binarySurfaceMasks.Nodup ∧
    binarySurfaceMasks.all surfaceIsClosed = true := by
  decide

/-! ## Exact topology census -/

/-- Every nonempty topology occurring in the 128-surface sum, with count. -/
theorem binarySurface_topology_census :
    topologyCount { vertices := 0, edges := 0, faces := 0, euler := 0 } = 1 ∧
    topologyCount { vertices := 8, edges := 12, faces := 6, euler := 2 } = 8 ∧
    topologyCount { vertices := 12, edges := 20, faces := 10, euler := 2 } = 24 ∧
    topologyCount { vertices := 14, edges := 24, faces := 12, euler := 2 } = 40 ∧
    topologyCount { vertices := 16, edges := 24, faces := 12, euler := 4 } = 4 ∧
    topologyCount { vertices := 16, edges := 28, faces := 14, euler := 2 } = 48 ∧
    topologyCount { vertices := 16, edges := 32, faces := 16, euler := 0 } = 3 := by
  decide

/-- The vacuum row selects only the empty surface and one six-face sphere. -/
def vacuumRowSurfaceMasks : List Nat := [0, 2167232]

theorem vacuumRowSurface_topology :
    vacuumRowSurfaceMasks.Nodup ∧
    vacuumRowSurfaceMasks.all surfaceIsClosed = true ∧
    surfaceTopology 0 =
      { vertices := 0, edges := 0, faces := 0, euler := 0 } ∧
    surfaceTopology 2167232 =
      { vertices := 8, edges := 12, faces := 6, euler := 2 } := by
  decide

/-! ## Surface weights and sparse heat polynomials -/

/-- For a closed surface, `2^F` from representation dimensions times the
topological Haar amplitude `2^(V-E)` gives this integral coefficient. -/
def surfacePhysicalCoefficient (mask : Nat) : Nat :=
  (2 ^ surfaceFaceCount mask) / (2 ^ (surfaceEdgeCount mask - surfaceVertexCount mask))

def sumNat : List Nat → Nat
  | [] => 0
  | value :: rest => value + sumNat rest

def surfaceHeatCoefficient (degree : Nat) (masks : List Nat) : Nat :=
  sumNat (masks.map fun mask =>
    if degree = 3 * surfaceFaceCount mask
    then surfacePhysicalCoefficient mask
    else 0)

def surfaceHeatPolynomial (masks : List Nat) : QPoly.Poly :=
  (List.range 49).map fun degree =>
    Q'.ofNat (surfaceHeatCoefficient degree masks)

def constantSurfaceHeatPolynomial : QPoly.Poly :=
  surfaceHeatPolynomial binarySurfaceMasks

def vacuumRowSurfaceHeatPolynomial : QPoly.Poly :=
  surfaceHeatPolynomial vacuumRowSurfaceMasks

def expectedConstantHeatCoefficient (degree : Nat) : Nat :=
  if degree = 0 then 1
  else if degree = 18 then 32
  else if degree = 30 then 96
  else if degree = 36 then 224
  else if degree = 42 then 192
  else if degree = 48 then 3
  else 0

def expectedVacuumRowHeatCoefficient (degree : Nat) : Nat :=
  if degree = 0 then 1
  else if degree = 18 then 4
  else 0

def expectedConstantHeatPolynomial : QPoly.Poly :=
  (List.range 49).map fun degree =>
    Q'.ofNat (expectedConstantHeatCoefficient degree)

def expectedVacuumRowHeatPolynomial : QPoly.Poly :=
  (List.range 49).map fun degree =>
    Q'.ofNat (expectedVacuumRowHeatCoefficient degree)

/-- Exact finite evaluation of the full 128-surface constant polynomial. -/
theorem constantSurfaceHeatPolynomial_closedForm :
    constantSurfaceHeatPolynomial = expectedConstantHeatPolynomial := by
  decide

/-- Exact finite evaluation of the two-surface vacuum-row polynomial. -/
theorem vacuumRowSurfaceHeatPolynomial_closedForm :
    vacuumRowSurfaceHeatPolynomial = expectedVacuumRowHeatPolynomial := by
  decide

/-! ## Centered numerator and normalization-defect algebra -/

def haarFiveDifferenceHeatPolynomial : QPoly.Poly :=
  QPoly.psub expectedConstantHeatPolynomial expectedVacuumRowHeatPolynomial

def expectedHaarFiveDifferenceHeatCoefficient (degree : Nat) : Nat :=
  if degree = 18 then 28
  else if degree = 30 then 96
  else if degree = 36 then 224
  else if degree = 42 then 192
  else if degree = 48 then 3
  else 0

def expectedHaarFiveDifferenceHeatPolynomial : QPoly.Poly :=
  (List.range 49).map fun degree =>
    Q'.ofNat (expectedHaarFiveDifferenceHeatCoefficient degree)

/-- `C - R = 28w¹⁸ + 96w³⁰ + 224w³⁶ + 192w⁴² + 3w⁴⁸`. -/
theorem haarFiveDifferenceHeatPolynomial_closedForm (w : Q') :
    (QPoly.eval haarFiveDifferenceHeatPolynomial w).eqv
      (QPoly.eval expectedHaarFiveDifferenceHeatPolynomial w) :=
  QPoly.poly_eqv _ _ w (by decide)

def centeredNumeratorHeatPolynomial : QPoly.Poly :=
  QPoly.psub expectedConstantHeatPolynomial
    (QPoly.pmul expectedVacuumRowHeatPolynomial expectedVacuumRowHeatPolynomial)

def expectedCenteredNumeratorHeatCoefficient (degree : Nat) : Nat :=
  if degree = 18 then 24
  else if degree = 30 then 96
  else if degree = 36 then 208
  else if degree = 42 then 192
  else if degree = 48 then 3
  else 0

def expectedCenteredNumeratorHeatPolynomial : QPoly.Poly :=
  (List.range 97).map fun degree =>
    Q'.ofNat (expectedCenteredNumeratorHeatCoefficient degree)

/-- `C - R² = 24w¹⁸ + 96w³⁰ + 208w³⁶ + 192w⁴² + 3w⁴⁸`. -/
theorem centeredNumeratorHeatPolynomial_closedForm (w : Q') :
    (QPoly.eval centeredNumeratorHeatPolynomial w).eqv
      (QPoly.eval expectedCenteredNumeratorHeatPolynomial w) :=
  QPoly.poly_eqv _ _ w (by decide)

def partitionExcessHeatPolynomial : QPoly.Poly :=
  QPoly.psub expectedConstantHeatPolynomial [1]

def centeredNormalizationDefectHeatPolynomial : QPoly.Poly :=
  QPoly.pmul partitionExcessHeatPolynomial expectedCenteredNumeratorHeatPolynomial

def expectedCenteredNormalizationDefectHeatCoefficient (degree : Nat) : Nat :=
  if degree = 36 then 768
  else if degree = 48 then 5376
  else if degree = 54 then 12032
  else if degree = 60 then 19968
  else if degree = 66 then 41640
  else if degree = 72 then 83456
  else if degree = 78 then 83520
  else if degree = 84 then 38160
  else if degree = 90 then 1152
  else if degree = 96 then 9
  else 0

def expectedCenteredNormalizationDefectHeatPolynomial : QPoly.Poly :=
  (List.range 97).map fun degree =>
    Q'.ofNat (expectedCenteredNormalizationDefectHeatCoefficient degree)

/-- `(C - 1)(C - R²)` has the exact ten-term nonnegative expansion used by
the centered-vacuum balance obstruction. -/
theorem centeredNormalizationDefectHeatPolynomial_closedForm (w : Q') :
    (QPoly.eval centeredNormalizationDefectHeatPolynomial w).eqv
      (QPoly.eval expectedCenteredNormalizationDefectHeatPolynomial w) :=
  QPoly.poly_eqv _ _ w (by decide)

/-! ## Strict positivity away from the vacuum endpoint -/

def allNonnegativeCoefficientsB : QPoly.Poly → Bool
  | [] => true
  | coefficient :: rest =>
      decide ((0 : Q') ≤ coefficient) && allNonnegativeCoefficientsB rest

def anyPositiveCoefficientB : QPoly.Poly → Bool
  | [] => false
  | coefficient :: rest =>
      decide ((0 : Q') < coefficient) || anyPositiveCoefficientB rest

private theorem q_num_pos_of_pos {value : Q'} (hvalue : (0 : Q') < value) :
    0 < value.num := by
  have h :
      (0 : Int) * (value.den : Int) < value.num * (1 : Int) := hvalue
  simpa using h

private theorem q_le_of_lt {left right : Q'} (h : left < right) : left ≤ right :=
  Int.le_of_lt h

private theorem q_mul_pos {left right : Q'}
    (hleft : (0 : Q') < left) (hright : (0 : Q') < right) :
    (0 : Q') < left * right := by
  show (0 : Int) * ((left * right).den : Int) <
    (left * right).num * (1 : Int)
  rw [Int.zero_mul, Int.mul_one]
  exact Int.mul_pos (q_num_pos_of_pos hleft) (q_num_pos_of_pos hright)

private theorem q_pos_add_nonneg {left right : Q'}
    (hleft : (0 : Q') < left) (hright : (0 : Q') ≤ right) :
    (0 : Q') < left + right := by
  show (0 : Int) * ((left + right).den : Int) <
    (left + right).num * (1 : Int)
  rw [Int.zero_mul, Int.mul_one]
  show (0 : Int) <
    left.num * (right.den : Int) + right.num * (left.den : Int)
  have hpositive : 0 < left.num * (right.den : Int) :=
    Int.mul_pos (q_num_pos_of_pos hleft) (by exact_mod_cast right.den_pos)
  have hnonnegative : 0 ≤ right.num * (left.den : Int) :=
    Int.mul_nonneg ((Q'.zero_le_iff_num_nonneg right).mp hright)
      (by exact_mod_cast Nat.zero_le left.den)
  omega

private theorem q_nonneg_add_pos {left right : Q'}
    (hleft : (0 : Q') ≤ left) (hright : (0 : Q') < right) :
    (0 : Q') < left + right := by
  show (0 : Int) * ((left + right).den : Int) <
    (left + right).num * (1 : Int)
  rw [Int.zero_mul, Int.mul_one]
  show (0 : Int) <
    left.num * (right.den : Int) + right.num * (left.den : Int)
  have hnonnegative : 0 ≤ left.num * (right.den : Int) :=
    Int.mul_nonneg ((Q'.zero_le_iff_num_nonneg left).mp hleft)
      (by exact_mod_cast Nat.zero_le right.den)
  have hpositive : 0 < right.num * (left.den : Int) :=
    Int.mul_pos (q_num_pos_of_pos hright) (by exact_mod_cast left.den_pos)
  omega

theorem eval_nonnegative_of_allNonnegativeCoefficientsB
    {w : Q'} (hw : (0 : Q') ≤ w) :
    ∀ polynomial : QPoly.Poly,
      allNonnegativeCoefficientsB polynomial = true →
      (0 : Q') ≤ QPoly.eval polynomial w
  | [], _ => Q'.le_refl' 0
  | coefficient :: rest, hcoefficients => by
      have hparts :
          decide ((0 : Q') ≤ coefficient) = true ∧
            allNonnegativeCoefficientsB rest = true := by
        rw [allNonnegativeCoefficientsB, Bool.and_eq_true] at hcoefficients
        exact hcoefficients
      show (0 : Q') ≤ coefficient + w * QPoly.eval rest w
      exact Q'.zero_le_add _ _
        (of_decide_eq_true hparts.1)
        (Q'.mul_nonneg _ _ hw
          (eval_nonnegative_of_allNonnegativeCoefficientsB hw rest hparts.2))

theorem eval_positive_of_nonnegativeCoefficients
    {w : Q'} (hw : (0 : Q') < w) :
    ∀ polynomial : QPoly.Poly,
      allNonnegativeCoefficientsB polynomial = true →
      anyPositiveCoefficientB polynomial = true →
      (0 : Q') < QPoly.eval polynomial w
  | [], _, hpositive => by simp [anyPositiveCoefficientB] at hpositive
  | coefficient :: rest, hcoefficients, hpositive => by
      have hparts :
          decide ((0 : Q') ≤ coefficient) = true ∧
            allNonnegativeCoefficientsB rest = true := by
        rw [allNonnegativeCoefficientsB, Bool.and_eq_true] at hcoefficients
        exact hcoefficients
      have hcases :
          decide ((0 : Q') < coefficient) = true ∨
            anyPositiveCoefficientB rest = true := by
        rw [anyPositiveCoefficientB, Bool.or_eq_true] at hpositive
        exact hpositive
      show (0 : Q') < coefficient + w * QPoly.eval rest w
      rcases hcases with hhead | htail
      · exact q_pos_add_nonneg
          (of_decide_eq_true hhead)
          (Q'.mul_nonneg _ _ (q_le_of_lt hw)
            (eval_nonnegative_of_allNonnegativeCoefficientsB
              (q_le_of_lt hw) rest hparts.2))
      · exact q_nonneg_add_pos
          (of_decide_eq_true hparts.1)
          (q_mul_pos hw
            (eval_positive_of_nonnegativeCoefficients hw rest hparts.2 htail))

/-- The centered numerator is strictly positive for every positive heat
variable `w`; hence it vanishes at no positive cutoff-one heat value. -/
theorem expectedCenteredNumeratorHeatPolynomial_positive
    (w : Q') (hw : (0 : Q') < w) :
    (0 : Q') < QPoly.eval expectedCenteredNumeratorHeatPolynomial w :=
  eval_positive_of_nonnegativeCoefficients hw _ (by decide) (by decide)

/-- The two Haar-five values are strictly ordered for every `w > 0`, because
their exact difference polynomial has positive coefficients. -/
theorem expectedHaarFiveDifferenceHeatPolynomial_positive
    (w : Q') (hw : (0 : Q') < w) :
    (0 : Q') < QPoly.eval expectedHaarFiveDifferenceHeatPolynomial w :=
  eval_positive_of_nonnegativeCoefficients hw _ (by decide) (by decide)

/-- The signed-versus-physical normalization defect is strictly positive for
every `w > 0`.  Therefore exact centered-vacuum balance occurs only at the
vacuum endpoint `w = 0`, once the binary-surface Haar bridge is supplied. -/
theorem expectedCenteredNormalizationDefectHeatPolynomial_positive
    (w : Q') (hw : (0 : Q') < w) :
    (0 : Q') <
      QPoly.eval expectedCenteredNormalizationDefectHeatPolynomial w :=
  eval_positive_of_nonnegativeCoefficients hw _ (by decide) (by decide)

end YMGap.Continuum.BF4CutoffOneBinarySurfaceCertificate

