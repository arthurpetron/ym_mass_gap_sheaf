def cutoffTwoSectorLocalZeroWitness (row column : Nat) : Nat :=
  cutoffTwoSectorLocalZeroWitnessData.getD (row * 65 + column) 0

def cutoffTwoSectorLocalZeroEntryCheck (row column : Nat) : Bool :=
  if decide (cutoffTwoSectorRawKernel row column ≈ 0) then
    decide (cutoffTwoSectorLocalZeroWitness row column ∈
      centralFixedFaceIds 0) &&
    cutoffTwoSectorIndexPairLocalZeroAtCheck row column
      (cutoffTwoSectorLocalZeroWitness row column)
  else true

def cutoffTwoSectorLocalZeroRowCheck (row : Nat) : Bool :=
  (List.range 65).all fun column =>
    cutoffTwoSectorLocalZeroEntryCheck row column

theorem cutoffTwoSectorLocalZeroRowCheck_sound
    {row column : Nat}
    (hcheck : cutoffTwoSectorLocalZeroRowCheck row = true)
    (hcolumn : column < 65)
    (hzero : cutoffTwoSectorRawKernel row column ≈ 0) :
    cutoffTwoSectorLocalZeroWitness row column ∈
        centralFixedFaceIds 0 ∧
      cutoffTwoSectorIndexPairLocalZeroAtCheck row column
        (cutoffTwoSectorLocalZeroWitness row column) = true := by
  have hentry := List.all_eq_true.mp hcheck column
    (List.mem_range.mpr hcolumn)
  unfold cutoffTwoSectorLocalZeroEntryCheck at hentry
  have hzeroCheck :
      decide (cutoffTwoSectorRawKernel row column ≈ 0) = true :=
    decide_eq_true hzero
  rw [hzeroCheck] at hentry
  have hparts := (Bool.and_eq_true _ _).mp hentry
  exact ⟨of_decide_eq_true hparts.1, hparts.2⟩

end YMGap.Continuum.BF4PhysicalBoundaryCutoffTwoSectorLocalZeroClassification
