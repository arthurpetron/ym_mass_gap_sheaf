/-
# Observable route for the repaired changing-nome BF4 family

This module joins the already-checked same-object cofinal route to the
explicit rationalization certificate consumed by the observable compiler.
The rationalization remains a field: no rationality, gauge invariance, or
amplitude bound is inferred from the completed `RC` channel.  Once that field
is supplied, the route exposes the physical separator, the two-sided physical
gap floor, the regular scaling band, and the scalar continuum-gap interface
for the definitionally same repaired family.

The module does not construct the rationalization, an OS/GNS handoff, a
continuum measure, a Hamiltonian, or the Clay theorem.
-/

import YMGap.Continuum.BF4PhysicalChangingNomeExplicitMarginLaw
import YMGap.Continuum.BF4PhysicalDynamicVacuumSectorObservablePath

namespace YMGap.Continuum.BF4PhysicalChangingNomeObservableRoute

set_option maxRecDepth 100000
set_option maxHeartbeats 10000000
set_option autoImplicit false

open YMGap.Constructive
open YMGap.Continuum
open YMGap.Continuum.BF4PhysicalChangingNomeDynamicFamily
open YMGap.Continuum.BF4PhysicalChangingNomeExplicitMarginLaw
open YMGap.Continuum.BF4PhysicalDynamicVacuumSectorCompletedFamily
open YMGap.Continuum.BF4PhysicalDynamicVacuumSectorObservablePath
open YMGap.Continuum.BF4PhysicalDynamicVacuumSectorSameObjectRCChannel
open YMGap.Continuum.BF4PhysicalCubeCutoffUniformGap
open YMGap.Continuum.PhysicalSeparator
open YMGap.Continuum.RegularContinuumPipeline
open YMGap.Continuum.RCStrictPositivity

/-! ## 1. The rate witness for the repaired family -/

/-- The repaired family retains the strict finite-cutoff rate supplied by the
completed strict contraction.  This is pointwise in scale; it is not a
uniform physical-rate calibration. -/
theorem changingNomeCarrierNormalizedDynamicFamily_rate_pos (scale : Nat) :
    (0 : Q') <
      (changingNomeCarrierNormalizedDynamicFamily.completedGap scale).rate := by
  rw [changingNomeCarrierNormalizedDynamicFamily_same_gap_rate]
  exact cutoffUniformRate_pos (changingNome scale)
    (Q'.le_of_lt (changingNome_pos scale))

/-! ## 2. Same-object rationalized route -/

/-- The rationalized route keeps the cofinal response/physical inputs and the
literal same-object rationalization in one dependent certificate.  In
particular, the observable pin cannot be attached to an unrelated channel. -/
structure ChangingNomeCarrierNormalizedObservableRoute : Type 1 where
  cofinal : ChangingNomeCarrierNormalizedCofinalConcreteChannelRoute
  rationalization :
    DynamicVacuumSectorSameObjectRationalization
      cofinal.responsePersistence.channelBridge.channel

namespace ChangingNomeCarrierNormalizedObservableRoute

/-- Compile the explicit rationalization into the observable interface. -/
def toObservablePin
    (route : ChangingNomeCarrierNormalizedObservableRoute) :
    DynamicVacuumSectorObservablePin
      changingNomeCarrierNormalizedDynamicFamily :=
  route.rationalization.toObservablePin
    changingNomeCarrierNormalizedDynamicFamily_rate_pos

/-- The observable separator is generated from the same completed channel. -/
def toPhysicalSeparator
    (route : ChangingNomeCarrierNormalizedObservableRoute) :
    PhysicalSeparator :=
  route.toObservablePin.toPhysicalSeparator

/-- The cofinal physical-rate calibration becomes a genuine two-sided floor
for the separator generated by that same observable pin. -/
def toPhysicalGapFloor
    (route : ChangingNomeCarrierNormalizedObservableRoute) :
    PhysicalGapFloor route.toPhysicalSeparator
      changingNomeCarrierNormalizedDynamicFamily.transferSpacing.spacing
      changingNomeCarrierNormalizedDynamicFamily.transferSpacing.spacing_pos :=
  route.toObservablePin.toPhysicalGapFloor
    route.cofinal.toPhysicalRateBand

/-- The separator and its spacing-to-zero modulus enter the regular scaling
compiler without replacing the literal completed transfer. -/
def toRegScalingBand
    (route : ChangingNomeCarrierNormalizedObservableRoute) :
    RegScalingBand :=
  route.toObservablePin.toRegScalingBand route.cofinal.toPhysicalRateBand

/-- The route exposes the already-available scalar continuum-gap interface. -/
def toContinuumGapTheorem
    (route : ChangingNomeCarrierNormalizedObservableRoute) :
    SharpContinuumObligation.ContinuumGapTheorem :=
  route.cofinal.toContinuumGapTheorem

/-- The selected same-object observable remains strictly nonzero at time zero
at every cutoff. -/
theorem gapObservable_zero_pos
    (route : ChangingNomeCarrierNormalizedObservableRoute)
    (scale : Nat) :
    (0 : Q') <
      route.toPhysicalSeparator.corrIface.connectedCorr
        scale route.toObservablePin.gapObservable 0 :=
  route.toObservablePin.physicalSeparator_gapObservable_zero_pos scale

/-- The regular scaling floor is strictly positive for this same-object route. -/
theorem regScalingBand_physGapMin_pos
    (route : ChangingNomeCarrierNormalizedObservableRoute) :
    (0 : Q') < route.toRegScalingBand.physGapMin :=
  route.toObservablePin.toRegScalingBand_physGapMin_pos
    route.cofinal.toPhysicalRateBand

end ChangingNomeCarrierNormalizedObservableRoute

end YMGap.Continuum.BF4PhysicalChangingNomeObservableRoute

