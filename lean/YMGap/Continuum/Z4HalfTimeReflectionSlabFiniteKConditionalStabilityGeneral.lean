local infix:50 " ≈ " => Q'.eqv

/-! ## 1. General normalized carrier tail -/

def couplingSlabConditionalBoundaryEpsilon
    (rootCount floor : Nat) : Q' :=
  Q'.ofNat rootCount *
    (anchorDecoratedEffectiveRatio ^ floor * Q'.ofNat 2)

theorem couplingSlabConditionalBoundaryEpsilon_nonnegative
    (rootCount floor : Nat) :
    (0 : Q') ≤ couplingSlabConditionalBoundaryEpsilon rootCount floor := by
  unfold couplingSlabConditionalBoundaryEpsilon
  exact Q'.mul_nonneg _ _ (by
      rw [Q'.zero_le_iff_num_nonneg]
      exact Int.natCast_nonneg rootCount)
    (Q'.mul_nonneg _ _
      (Q'.pow_nonneg anchorDecoratedEffectiveRatio
        anchorDecoratedEffectiveRatio_nonnegative floor)
      (by decide))

/-- The arbitrary-root carrier estimate after division by the two actual
positive finite-volume partition functions. -/
theorem couplingNormalizedSlabConnectedCylinderResidue_le_of_floor
    {coupling : Q'} (hcoupling : (0 : Q') ≤ coupling)
    (hle : coupling ≤ anchorCoupling) (cutoff : Nat)
    {extent : Nat} {roots : List (CanonicalAtom (extent + 1))}
    {predicate : List Bool → Bool}
    (defaultRoot : CanonicalAtom (extent + 1))
    (hrootsSupported : ∀ root, root ∈ roots →
      canonicalPolymerSlabSupportedB extent root.val = true)
    (floor : Nat)
    (hfloor : ∀ entry : SlabConnectedSourceEntry extent roots predicate,
      floor ≤ (slabConnectedCarrierSupport defaultRoot entry).length) :
    couplingNormalizedSlabConnectedCylinderResidue
        coupling hcoupling cutoff extent roots predicate ≤
      couplingSlabConditionalBoundaryEpsilon roots.length floor := by
  unfold couplingNormalizedSlabConnectedCylinderResidue
    couplingSlabConditionalBoundaryEpsilon
  apply Q'.divPos_le_of_le_mul
  exact couplingSpinSummedSlabConnectedCylinderResidue_le_tail_of_floor
    hcoupling hle cutoff defaultRoot hrootsSupported floor hfloor

theorem couplingAmbientProbability_sub_givenSlab_le_of_floor
    {coupling : Q'} (hcoupling : (0 : Q') ≤ coupling)
    (hle : coupling ≤ anchorCoupling) (cutoff : Nat)
    {extent : Nat} {roots : List (CanonicalAtom (extent + 1))}
    {predicate : List Bool → Bool}
    (defaultRoot : CanonicalAtom (extent + 1))
    (hrootsSupported : ∀ root, root ∈ roots →
      canonicalPolymerSlabSupportedB extent root.val = true)
    (floor : Nat)
    (hfloor : ∀ entry : SlabConnectedSourceEntry extent roots predicate,
      floor ≤ (slabConnectedCarrierSupport defaultRoot entry).length) :
    couplingParametricKCompatibleSupportEventProbability
          coupling hcoupling cutoff (extent + 1)
          (slabMarkedCylinderEvent roots predicate) -
        couplingParametricKCompatibleGivenSlabProbability
          coupling hcoupling cutoff extent
          (slabMarkedCylinderEvent roots predicate) ≤
      couplingSlabConditionalBoundaryEpsilon roots.length floor := by
  exact Q'.le_trans' _ _ _
    (couplingAmbientProbability_sub_givenSlab_le_normalizedResidue
      coupling hcoupling cutoff extent roots predicate)
    (couplingNormalizedSlabConnectedCylinderResidue_le_of_floor
      hcoupling hle cutoff defaultRoot hrootsSupported floor hfloor)

/-! ## 2. Complementation gives the reverse direction -/

private theorem left_eqv_one_sub_right {a complement : Q'}
    (hsum : a + complement ≈ (1 : Q')) :
    a ≈ (1 : Q') - complement := by
  refine Q'.eqv_trans _ (a + 0) _
    (Q'.eqv_symm (Q'.eqv_of_eq (Q'.add_zero' a))) ?_
  refine Q'.eqv_trans _ (a + (complement + (-complement))) _
    (Q'.add_eqv_congr_left a 0 (complement + (-complement))
      (Q'.eqv_symm (Q'.add_neg_self_eqv complement))) ?_
  refine Q'.eqv_trans _ ((a + complement) + (-complement)) _
    (Q'.eqv_symm (Q'.add_assoc_eqv a complement (-complement))) ?_
  exact Q'.add_eqv_congr_right
    (a + complement) 1 (-complement) hsum

private theorem sub_eqv_both_local {a a' b b' : Q'}
    (ha : a ≈ a') (hb : b ≈ b') : a - b ≈ a' - b' :=
  Q'.add_eqv_congr' ha (Q'.neg_eqv_congr _ _ hb)

private theorem eventReverseSub_eqv_complementSub
    {a aComplement b bComplement : Q'}
    (ha : a + aComplement ≈ (1 : Q'))
    (hb : b + bComplement ≈ (1 : Q')) :
    a - b ≈ bComplement - aComplement := by
  refine Q'.eqv_trans _
    (((1 : Q') - aComplement) - ((1 : Q') - bComplement)) _
    (sub_eqv_both_local
      (left_eqv_one_sub_right ha)
      (left_eqv_one_sub_right hb)) ?_
  change
    ((1 + (-aComplement)) + (-(1 + (-bComplement)))) ≈
      (bComplement + (-aComplement))
  have hneg : (-(1 + (-bComplement))) ≈
      ((-1) + bComplement) := by
    refine Q'.eqv_trans _ ((-1) + (-(-bComplement))) _
      (Q'.neg_add_eqv 1 (-bComplement)) ?_
    exact Q'.add_eqv_congr_left (-1) (-(-bComplement)) bComplement
      (Q'.neg_neg_eqv bComplement)
  refine Q'.eqv_trans _
    ((1 + (-aComplement)) + ((-1) + bComplement)) _
    (Q'.add_eqv_congr_left (1 + (-aComplement)) _ _ hneg) ?_
  refine Q'.eqv_trans _
    ((1 + (-1)) + ((-aComplement) + bComplement)) _
    (Q'.add_swap_inner 1 (-aComplement) (-1) bComplement) ?_
  refine Q'.eqv_trans _
    (0 + ((-aComplement) + bComplement)) _
    (Q'.add_eqv_congr_right (1 + (-1)) 0
      ((-aComplement) + bComplement)
      (Q'.add_neg_self_eqv 1)) ?_
  refine Q'.eqv_trans _ ((-aComplement) + bComplement) _
    (Q'.eqv_of_eq (Q'.zero_add' ((-aComplement) + bComplement))) ?_
  exact Q'.add_comm_eqv (-aComplement) bComplement

theorem couplingGivenSlab_sub_ambientProbability_le_of_floor
    {coupling : Q'} (hcoupling : (0 : Q') ≤ coupling)
    (hle : coupling ≤ anchorCoupling) (cutoff : Nat)
    {extent : Nat} {roots : List (CanonicalAtom (extent + 1))}
    (predicate : List Bool → Bool)
    (defaultRoot : CanonicalAtom (extent + 1))
    (hrootsSupported : ∀ root, root ∈ roots →
      canonicalPolymerSlabSupportedB extent root.val = true)
    (floor : Nat)
    (hfloor : ∀ entry : SlabConnectedSourceEntry extent roots
        (complementSlabPredicate predicate),
      floor ≤ (slabConnectedCarrierSupport defaultRoot entry).length) :
    couplingParametricKCompatibleGivenSlabProbability
          coupling hcoupling cutoff extent
          (slabMarkedCylinderEvent roots predicate) -
        couplingParametricKCompatibleSupportEventProbability
          coupling hcoupling cutoff (extent + 1)
          (slabMarkedCylinderEvent roots predicate) ≤
      couplingSlabConditionalBoundaryEpsilon roots.length floor := by
  let event := slabMarkedCylinderEvent roots predicate
  let complementEvent := slabMarkedCylinderEvent roots
    (complementSlabPredicate predicate)
  have hcomplement := couplingAmbientProbability_sub_givenSlab_le_of_floor
    hcoupling hle cutoff defaultRoot hrootsSupported floor hfloor
  have hpointwise : complementEvent =
      (fun family => !(event family)) := by
    funext family
    rfl
  have hambientSum :
      couplingParametricKCompatibleSupportEventProbability
            coupling hcoupling cutoff (extent + 1) event +
        couplingParametricKCompatibleSupportEventProbability
            coupling hcoupling cutoff (extent + 1)
            complementEvent ≈ (1 : Q') := by
    rw [hpointwise]
    exact
      couplingParametricKCompatibleEventProbability_add_complement_eqv_one
        hcoupling cutoff (extent + 1) event
  have hslabSum :
      couplingParametricKCompatibleGivenSlabProbability
            coupling hcoupling cutoff extent event +
        couplingParametricKCompatibleGivenSlabProbability
            coupling hcoupling cutoff extent complementEvent ≈
          (1 : Q') := by
    rw [hpointwise]
    exact
      couplingParametricKCompatibleGivenSlabProbability_add_complement_eqv_one
        coupling hcoupling cutoff extent event
  have hreorder :
      couplingParametricKCompatibleGivenSlabProbability
            coupling hcoupling cutoff extent event -
          couplingParametricKCompatibleSupportEventProbability
            coupling hcoupling cutoff (extent + 1) event ≈
        couplingParametricKCompatibleSupportEventProbability
            coupling hcoupling cutoff (extent + 1) complementEvent -
          couplingParametricKCompatibleGivenSlabProbability
            coupling hcoupling cutoff extent complementEvent :=
    eventReverseSub_eqv_complementSub hslabSum hambientSum
  exact Q'.le_trans' _ _ _ (Q'.le_of_eqv hreorder) (by
    simpa [event, complementEvent] using hcomplement)

private theorem sub_swap_eqv_neg_local (a b : Q') :
    b - a ≈ -(a - b) := by
  change (b + -a) ≈ (-(a + -b))
  refine Q'.eqv_trans _ _ _ (Q'.add_comm_eqv b (-a)) ?_
  refine Q'.eqv_trans _ _ _
    (Q'.add_eqv_congr_left (-a) b (-(-b))
      (Q'.eqv_symm (Q'.neg_neg_eqv b))) ?_
  exact Q'.eqv_symm (Q'.neg_add_eqv a (-b))

/-- General two-sided corrected-slab law comparison.  The forward and
complement carrier floors are exposed separately because they are logically
distinct finite geometric obligations. -/
theorem couplingAmbient_givenSlabProbability_abs_sub_le_of_floors
    {coupling : Q'} (hcoupling : (0 : Q') ≤ coupling)
    (hle : coupling ≤ anchorCoupling) (cutoff : Nat)
    {extent : Nat} {roots : List (CanonicalAtom (extent + 1))}
    (predicate : List Bool → Bool)
    (defaultRoot : CanonicalAtom (extent + 1))
    (hrootsSupported : ∀ root, root ∈ roots →
      canonicalPolymerSlabSupportedB extent root.val = true)
    (floor : Nat)
    (hfloor : ∀ entry : SlabConnectedSourceEntry extent roots predicate,
      floor ≤ (slabConnectedCarrierSupport defaultRoot entry).length)
    (hfloorComplement : ∀ entry : SlabConnectedSourceEntry extent roots
        (complementSlabPredicate predicate),
      floor ≤ (slabConnectedCarrierSupport defaultRoot entry).length) :
    Q'.abs
        (couplingParametricKCompatibleSupportEventProbability
            coupling hcoupling cutoff (extent + 1)
            (slabMarkedCylinderEvent roots predicate) -
          couplingParametricKCompatibleGivenSlabProbability
            coupling hcoupling cutoff extent
            (slabMarkedCylinderEvent roots predicate)) ≤
      couplingSlabConditionalBoundaryEpsilon roots.length floor := by
  apply Q'.abs_le
  · have hreverse := couplingGivenSlab_sub_ambientProbability_le_of_floor
      hcoupling hle cutoff predicate defaultRoot hrootsSupported floor
        hfloorComplement
    have hneg := Q'.neg_le_neg hreverse
    exact Q'.le_trans' _ _ _ hneg
      (Q'.le_of_eqv
        (Q'.eqv_symm
          (sub_swap_eqv_neg_local
            (couplingParametricKCompatibleGivenSlabProbability
              coupling hcoupling cutoff extent
              (slabMarkedCylinderEvent roots predicate))
            (couplingParametricKCompatibleSupportEventProbability
              coupling hcoupling cutoff (extent + 1)
              (slabMarkedCylinderEvent roots predicate)))))
  · exact couplingAmbientProbability_sub_givenSlab_le_of_floor
      hcoupling hle cutoff defaultRoot hrootsSupported floor hfloor

/-! ## 3. Literal physical finite law -/

theorem couplingPhysicalDifference_eqv_compatible
    (coupling : Q') (hcoupling : (0 : Q') ≤ coupling)
    (cutoff extent : Nat) (event : List (List Nat) → Bool) :
    couplingKFamilyEventProbability coupling hcoupling cutoff
          (extent + 1) event -
        couplingParametricKPhysicalGivenSlabProbability
          coupling hcoupling cutoff extent event ≈
      couplingParametricKCompatibleSupportEventProbability
          coupling hcoupling cutoff (extent + 1) event -
        couplingParametricKCompatibleGivenSlabProbability
          coupling hcoupling cutoff extent event :=
  sub_eqv_both_local
    (couplingKFamilyEventProbability_eqv_compatible
      coupling hcoupling cutoff (extent + 1) event)
    (couplingParametricKPhysicalGivenSlabProbability_eqv_compatible
      coupling hcoupling cutoff extent event)

/-- The arbitrary finite-root comparison stated for the literal physical
ambient and corrected-slab conditional ensembles. -/
theorem couplingPhysicalAmbient_givenSlabProbability_abs_sub_le_of_floors
    {coupling : Q'} (hcoupling : (0 : Q') ≤ coupling)
    (hle : coupling ≤ anchorCoupling) (cutoff : Nat)
    {extent : Nat} {roots : List (CanonicalAtom (extent + 1))}
    (predicate : List Bool → Bool)
    (defaultRoot : CanonicalAtom (extent + 1))
    (hrootsSupported : ∀ root, root ∈ roots →
      canonicalPolymerSlabSupportedB extent root.val = true)
    (floor : Nat)
    (hfloor : ∀ entry : SlabConnectedSourceEntry extent roots predicate,
      floor ≤ (slabConnectedCarrierSupport defaultRoot entry).length)
    (hfloorComplement : ∀ entry : SlabConnectedSourceEntry extent roots
        (complementSlabPredicate predicate),
      floor ≤ (slabConnectedCarrierSupport defaultRoot entry).length) :
    Q'.abs
        (couplingKFamilyEventProbability coupling hcoupling cutoff
            (extent + 1) (slabMarkedCylinderEvent roots predicate) -
          couplingParametricKPhysicalGivenSlabProbability
            coupling hcoupling cutoff extent
            (slabMarkedCylinderEvent roots predicate)) ≤
      couplingSlabConditionalBoundaryEpsilon roots.length floor := by
  have hbridge := couplingPhysicalDifference_eqv_compatible
    coupling hcoupling cutoff extent
      (slabMarkedCylinderEvent roots predicate)
  exact Q'.le_trans' _ _ _
    (Q'.le_of_eqv (Q'.abs_eqv_congr hbridge))
    (couplingAmbient_givenSlabProbability_abs_sub_le_of_floors
      hcoupling hle cutoff predicate defaultRoot hrootsSupported floor
        hfloor hfloorComplement)

