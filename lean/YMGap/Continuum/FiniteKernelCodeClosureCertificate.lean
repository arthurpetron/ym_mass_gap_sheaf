/-
# Proof-carrying finite kernel support closure

This module is the trust boundary for an external support-graph computation.
A program may propose natural-number state codes, a Boolean possible-edge
classifier, and a candidate code sector.  Lean accepts the sector as
row-closed only after checking every finite source/target pair and after a
proof establishes that every classifier `false` forces the genuine exact
kernel entry to vanish.

The Boolean table may be generated by Rust, C, or another fast program.  Its
mathematical soundness and the successful finite closure check are replayed
inside Lean.  No native-code evaluation is trusted by the theorem.

No `Classical.*`, `native_decide`, `sorry`, custom axiom, choice, or
noncomputable declaration.
-/

import YMGap.Continuum.FiniteDeterministicKernelPushforward

namespace YMGap.Continuum.FiniteKernelCodeClosureCertificate

set_option maxRecDepth 10000
set_option maxHeartbeats 1000000

open YMGap.Constructive

local infix:50 " ≈ " => Q'.eqv

/-- Executable row-closure check.  Only sources whose codes are in the
candidate sector are inspected; every target outside the sector must be
classified as an impossible edge. -/
def finiteKernelCodeSectorRowClosedB
    {State : Type}
    (states : List State)
    (encode : State → Nat)
    (sectorCodes : List Nat)
    (possibleEdge : Nat → Nat → Bool) : Bool :=
  states.all (fun source =>
    if decide (encode source ∈ sectorCodes) then
      states.all (fun target =>
        if decide (encode target ∈ sectorCodes) then true
        else !(possibleEdge (encode source) (encode target)))
    else true)

/-- Propositional row closure for the genuine exact kernel. -/
def FiniteKernelCodeSectorRowClosed
    {State : Type}
    (states : List State)
    (encode : State → Nat)
    (kernel : State → State → Q')
    (sectorCodes : List Nat) : Prop :=
  ∀ source target : State,
    source ∈ states →
    target ∈ states →
    encode source ∈ sectorCodes →
    encode target ∉ sectorCodes →
    kernel source target ≈ 0

private theorem bool_eq_false_of_not_eq_true
    (value : Bool) (hvalue : (!value) = true) : value = false := by
  cases value <;> simp_all

/-- Soundness of the executable checker.  The only model-specific premise is
the zero-soundness of the proposed possible-edge classifier. -/
theorem finiteKernelCodeSectorRowClosed_of_check
    {State : Type}
    (states : List State)
    (encode : State → Nat)
    (kernel : State → State → Q')
    (sectorCodes : List Nat)
    (possibleEdge : Nat → Nat → Bool)
    (zero_of_edge_false :
      ∀ source target : State,
        source ∈ states →
        target ∈ states →
        possibleEdge (encode source) (encode target) = false →
        kernel source target ≈ 0)
    (hcheck : finiteKernelCodeSectorRowClosedB
      states encode sectorCodes possibleEdge = true) :
    FiniteKernelCodeSectorRowClosed
      states encode kernel sectorCodes := by
  intro source target hsource htarget hsourceCode htargetCode
  unfold finiteKernelCodeSectorRowClosedB at hcheck
  have hsourceRow := List.all_eq_true.mp hcheck source hsource
  simp only [hsourceCode, decide_true, if_true] at hsourceRow
  have htargetEntry := List.all_eq_true.mp hsourceRow target htarget
  simp only [htargetCode, decide_false] at htargetEntry
  exact zero_of_edge_false source target hsource htarget
    (bool_eq_false_of_not_eq_true _ htargetEntry)

/-- A proof-carrying possible-edge oracle for one exact finite kernel. -/
structure FiniteKernelCodeSupportOracle (State : Type) where
  states : List State
  encode : State → Nat
  kernel : State → State → Q'
  possibleEdge : Nat → Nat → Bool
  zero_of_edge_false :
    ∀ source target : State,
      source ∈ states →
      target ∈ states →
      possibleEdge (encode source) (encode target) = false →
      kernel source target ≈ 0

/-- A candidate code sector together with a kernel-checked Boolean closure
certificate. -/
structure FiniteKernelCodeClosureCertificate
    {State : Type}
    (oracle : FiniteKernelCodeSupportOracle State) where
  sectorCodes : List Nat
  sectorCodes_nodup : sectorCodes.Nodup
  closure_checked : finiteKernelCodeSectorRowClosedB
    oracle.states oracle.encode sectorCodes oracle.possibleEdge = true

namespace FiniteKernelCodeClosureCertificate

theorem rowClosed
    {State : Type}
    {oracle : FiniteKernelCodeSupportOracle State}
    (certificate : FiniteKernelCodeClosureCertificate oracle) :
    FiniteKernelCodeSectorRowClosed
      oracle.states oracle.encode oracle.kernel certificate.sectorCodes := by
  exact finiteKernelCodeSectorRowClosed_of_check
    oracle.states oracle.encode oracle.kernel certificate.sectorCodes
    oracle.possibleEdge oracle.zero_of_edge_false
    certificate.closure_checked

end FiniteKernelCodeClosureCertificate

/-! ## A closed regression example -/

private def exampleStates : List Nat := [0, 1, 2]

private def examplePossibleEdge (source target : Nat) : Bool :=
  decide (source < 2 ∧ target < 2)

private def exampleKernel (source target : Nat) : Q' :=
  if examplePossibleEdge source target then 1 else 0

private theorem exampleKernel_zero_of_edge_false
    (source target : Nat)
    (_hsource : source ∈ exampleStates)
    (_htarget : target ∈ exampleStates)
    (hedge : examplePossibleEdge source target = false) :
    exampleKernel source target ≈ 0 := by
  unfold exampleKernel
  rw [if_neg (by simpa using hedge)]
  exact Q'.eqv_refl 0

private def exampleOracle : FiniteKernelCodeSupportOracle Nat where
  states := exampleStates
  encode := fun state => state
  kernel := exampleKernel
  possibleEdge := examplePossibleEdge
  zero_of_edge_false := exampleKernel_zero_of_edge_false

def exampleClosureCertificate :
    FiniteKernelCodeClosureCertificate exampleOracle where
  sectorCodes := [0, 1]
  sectorCodes_nodup := by decide
  closure_checked := by decide

theorem exampleClosureCertificate_rowClosed :
    FiniteKernelCodeSectorRowClosed
      exampleStates (fun state => state) exampleKernel [0, 1] := by
  exact exampleClosureCertificate.rowClosed

end YMGap.Continuum.FiniteKernelCodeClosureCertificate

#print axioms
  YMGap.Continuum.FiniteKernelCodeClosureCertificate.finiteKernelCodeSectorRowClosed_of_check
#print axioms
  YMGap.Continuum.FiniteKernelCodeClosureCertificate.FiniteKernelCodeClosureCertificate.rowClosed
#print axioms
  YMGap.Continuum.FiniteKernelCodeClosureCertificate.exampleClosureCertificate_rowClosed
