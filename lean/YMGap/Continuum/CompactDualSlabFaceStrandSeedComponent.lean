/-! ## 1. The undirected finite graph carried by a strand-edge list -/

/-- One literal strand edge connects two displayed copies in either
orientation. -/
def slabFaceStrandEdgeConnectsB
    {physical : SlabLabelling} (edge : SlabFaceStrandEdge physical)
    (left right : SlabFaceStrandCopy physical) : Bool :=
  (decide (edge.source = left) && decide (edge.target = right)) ||
    (decide (edge.source = right) && decide (edge.target = left))

/-- Adjacency generated by a finite physical strand-edge list. -/
def slabFaceStrandAdjacentB
    {physical : SlabLabelling} (edges : List (SlabFaceStrandEdge physical))
    (left right : SlabFaceStrandCopy physical) : Bool :=
  edges.any fun edge => slabFaceStrandEdgeConnectsB edge left right

/-- Edge adjacency is symmetric by construction. -/
theorem slabFaceStrandAdjacentB_symmetric
    {physical : SlabLabelling} (edges : List (SlabFaceStrandEdge physical)) :
    SymmetricAdj (slabFaceStrandAdjacentB edges) := by
  intro left right
  induction edges with
  | nil => rfl
  | cons edge rest ih =>
      change
        (slabFaceStrandEdgeConnectsB edge left right ||
            slabFaceStrandAdjacentB rest left right) =
          (slabFaceStrandEdgeConnectsB edge right left ||
            slabFaceStrandAdjacentB rest right left)
      rw [ih]
      unfold slabFaceStrandEdgeConnectsB
      exact congrArg
        (fun value => value || slabFaceStrandAdjacentB rest right left)
        (Bool.or_comm _ _)

/-- The explicit finite vertex carrier is the concatenation of the two
endpoints of every displayed edge. -/
def slabFaceStrandVertices
    {physical : SlabLabelling} (edges : List (SlabFaceStrandEdge physical)) :
    List (SlabFaceStrandCopy physical) :=
  edges.flatMap fun edge => [edge.source, edge.target]

/-- A displayed edge's source belongs to the endpoint carrier. -/
theorem slabFaceStrandEdge_source_mem_vertices
    {physical : SlabLabelling} {edges : List (SlabFaceStrandEdge physical)}
    {edge : SlabFaceStrandEdge physical} (hmem : edge ∈ edges) :
    edge.source ∈ slabFaceStrandVertices edges := by
  apply List.mem_flatMap.mpr
  exact ⟨edge, hmem, List.mem_cons_self⟩

/-- A displayed edge's target belongs to the endpoint carrier. -/
theorem slabFaceStrandEdge_target_mem_vertices
    {physical : SlabLabelling} {edges : List (SlabFaceStrandEdge physical)}
    {edge : SlabFaceStrandEdge physical} (hmem : edge ∈ edges) :
    edge.target ∈ slabFaceStrandVertices edges := by
  apply List.mem_flatMap.mpr
  exact ⟨edge, hmem, List.mem_cons_of_mem edge.source List.mem_cons_self⟩

/-- Every displayed edge generates a true adjacency between its endpoints. -/
theorem slabFaceStrandAdjacentB_true_of_mem
    {physical : SlabLabelling} {edges : List (SlabFaceStrandEdge physical)}
    {edge : SlabFaceStrandEdge physical} (hmem : edge ∈ edges) :
    slabFaceStrandAdjacentB edges edge.source edge.target = true := by
  unfold slabFaceStrandAdjacentB
  apply List.any_eq_true.mpr
  refine ⟨edge, hmem, ?_⟩
  simp [slabFaceStrandEdgeConnectsB]

/-! ## 2. Constructive rooted component and edge closure -/

/-- An explicit seed in the endpoint carrier of a physical strand graph. -/
structure SlabFaceStrandSeed
    {physical : SlabLabelling} (edges : List (SlabFaceStrandEdge physical)) :
    Type where
  root : SlabFaceStrandCopy physical
  root_mem : root ∈ slabFaceStrandVertices edges

/-- Any displayed edge constructively supplies a seed. -/
def SlabFaceStrandSeed.ofEdge
    {physical : SlabLabelling} {edges : List (SlabFaceStrandEdge physical)}
    {edge : SlabFaceStrandEdge physical} (hmem : edge ∈ edges) :
    SlabFaceStrandSeed edges where
  root := edge.source
  root_mem := slabFaceStrandEdge_source_mem_vertices hmem

/-- The duplicate-free constructive connected component containing the
explicit seed. -/
def SlabFaceStrandSeed.component
    {physical : SlabLabelling} {edges : List (SlabFaceStrandEdge physical)}
    (seed : SlabFaceStrandSeed edges) :
    List (SlabFaceStrandCopy physical) :=
  rootComponent (slabFaceStrandAdjacentB edges)
    (slabFaceStrandVertices edges) seed.root

/-- Boolean characteristic function of the seed-generated component. -/
def SlabFaceStrandSeed.selected
    {physical : SlabLabelling} {edges : List (SlabFaceStrandEdge physical)}
    (seed : SlabFaceStrandSeed edges)
    (copy : SlabFaceStrandCopy physical) : Bool :=
  decide (copy ∈ seed.component)

/-- **Component edge closure.**  The characteristic function of a rooted
component takes equal values on the two endpoints of every displayed edge. -/
theorem SlabFaceStrandSeed.selected_eq_of_edge_mem
    {physical : SlabLabelling} {edges : List (SlabFaceStrandEdge physical)}
    (seed : SlabFaceStrandSeed edges)
    {edge : SlabFaceStrandEdge physical} (hmem : edge ∈ edges) :
    seed.selected edge.target = seed.selected edge.source := by
  have hsym := slabFaceStrandAdjacentB_symmetric edges
  have hadj := slabFaceStrandAdjacentB_true_of_mem hmem
  have hsourceVertex := slabFaceStrandEdge_source_mem_vertices hmem
  have htargetVertex := slabFaceStrandEdge_target_mem_vertices hmem
  by_cases hsource : edge.source ∈ seed.component
  · have htarget : edge.target ∈ seed.component :=
      rootComponent_closed_under_edge
        (slabFaceStrandAdjacentB edges) hsym seed.root_mem
        hsource htargetVertex hadj
    simp [SlabFaceStrandSeed.selected, hsource, htarget]
  · by_cases htarget : edge.target ∈ seed.component
    · have hreverse :
          slabFaceStrandAdjacentB edges edge.target edge.source = true := by
        rw [hsym edge.target edge.source]
        exact hadj
      have hsource' : edge.source ∈ seed.component :=
        rootComponent_closed_under_edge
          (slabFaceStrandAdjacentB edges) hsym seed.root_mem
          htarget hsourceVertex hreverse
      exact False.elim (hsource hsource')
    · simp [SlabFaceStrandSeed.selected, hsource, htarget]

/-- Every rooted strand component contains a copy on a face distinct from the
root face.  Indeed, the root lies in the endpoint carrier of some displayed
edge; the opposite endpoint belongs to the same component by edge closure,
and physical terminal pairing records that the two endpoint face identifiers
are distinct. -/
theorem SlabFaceStrandSeed.exists_component_faceId_ne_root
    {physical : SlabLabelling} {edges : List (SlabFaceStrandEdge physical)}
    (seed : SlabFaceStrandSeed edges) :
    Exists fun copy : SlabFaceStrandCopy physical =>
      copy ∈ seed.component ∧ copy.faceId ≠ seed.root.faceId := by
  obtain ⟨edge, hedge, hendpoint⟩ := List.mem_flatMap.mp seed.root_mem
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hendpoint
  have hsym := slabFaceStrandAdjacentB_symmetric edges
  have hadj := slabFaceStrandAdjacentB_true_of_mem hedge
  have hroot : seed.root ∈ seed.component := by
    unfold SlabFaceStrandSeed.component
    exact root_mem_rootComponent
      (slabFaceStrandAdjacentB edges) seed.root_mem
  rcases hendpoint with hsource | htarget
  · have hsourceComponent : edge.source ∈ seed.component := by
      rw [← hsource]
      exact hroot
    have htargetComponent : edge.target ∈ seed.component :=
      rootComponent_closed_under_edge
        (slabFaceStrandAdjacentB edges) hsym seed.root_mem
        hsourceComponent (slabFaceStrandEdge_target_mem_vertices hedge) hadj
    exact ⟨edge.target, htargetComponent, by
      simpa [hsource] using edge.faceId_ne.symm⟩
  · have htargetComponent : edge.target ∈ seed.component := by
      rw [← htarget]
      exact hroot
    have hreverse :
        slabFaceStrandAdjacentB edges edge.target edge.source = true := by
      rw [hsym edge.target edge.source]
      exact hadj
    have hsourceComponent : edge.source ∈ seed.component :=
      rootComponent_closed_under_edge
        (slabFaceStrandAdjacentB edges) hsym seed.root_mem
        htargetComponent (slabFaceStrandEdge_source_mem_vertices hedge)
        hreverse
    exact ⟨edge.source, hsourceComponent, by
      simpa [htarget] using edge.faceId_ne⟩

/-! ## 3. A global assignment seed induces every local physical selection -/

/-- Seed data for the literal global face-strand edge list of one accepted
fusion-witness assignment. -/
abbrev SlabFusionWitnessFaceStrandSeed
    (K extent : Nat) (physical : SlabLabelling)
    (links : List SlabLink) (assignment : SlabFusionWitnessAssignment)
    (hassignment : assignment ∈
      slabFusionWitnessAssignmentsOn K extent physical links) :=
  SlabFaceStrandSeed
    (slabFusionWitnessAssignmentFaceStrandEdges
      K extent physical links assignment hassignment)

/-- Restrict the seed-component characteristic function to one displayed
accepted link.  Literal global-edge membership proves partner closure. -/
def SlabFusionWitnessFaceStrandSeed.atLinkSelection
    {K extent : Nat} {physical : SlabLabelling}
    {links : List SlabLink} {assignment : SlabFusionWitnessAssignment}
    {hassignment : assignment ∈
      slabFusionWitnessAssignmentsOn K extent physical links}
    (seed : SlabFusionWitnessFaceStrandSeed
      K extent physical links assignment hassignment)
    (linked : {link // link ∈ links}) :
    let auxiliary := slabFusionWitnessAssignmentAt linked.1 assignment
    let hmem := slabFusionWitnessAssignmentAt_mem_local
      K extent physical links assignment hassignment linked.1 linked.2
    SlabLinkPartnerClosedFaceSelection
      K extent physical linked.1 auxiliary hmem := by
  dsimp
  refine
    { selected := seed.selected
      partner_closed := ?_ }
  intro terminal
  let edge := slabLinkFaceStrandEdgeOfTerminal
    K extent physical linked.1
      (slabFusionWitnessAssignmentAt linked.1 assignment)
      (slabFusionWitnessAssignmentAt_mem_local
        K extent physical links assignment hassignment linked.1 linked.2)
      terminal
  have hedge : edge ∈
      slabFusionWitnessAssignmentFaceStrandEdges
        K extent physical links assignment hassignment :=
    slabFusionWitnessAssignmentFaceStrandEdgeOfTerminal_mem
      K extent physical links assignment hassignment linked terminal
  exact seed.selected_eq_of_edge_mem hedge

/-- Compose global component closure with terminal pullback and same-copy
descent.  The result is exactly the mate-closed link selection consumed by
the Kirchhoff removal compiler. -/
def SlabFusionWitnessFaceStrandSeed.atLinkMateClosedSelection
    {K extent : Nat} {physical : SlabLabelling}
    {links : List SlabLink} {assignment : SlabFusionWitnessAssignment}
    {hassignment : assignment ∈
      slabFusionWitnessAssignmentsOn K extent physical links}
    (seed : SlabFusionWitnessFaceStrandSeed
      K extent physical links assignment hassignment)
    (linked : {link // link ∈ links}) :
    let hmem := slabFusionWitnessAssignmentAt_mem_local
      K extent physical links assignment hassignment linked.1 linked.2
    SlabLinkMateClosedSelection hmem := by
  dsimp
  exact (seed.atLinkSelection linked).toMateClosedSelection

