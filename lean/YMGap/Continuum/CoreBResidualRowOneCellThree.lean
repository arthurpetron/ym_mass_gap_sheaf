    RingNormaliser.qpow w (nw + 2) * RingNormaliser.qpow h (nh + 2) ≤
      w * w * (h * h) := by
  have hA := rnqpow_two_le_sq hw0 hw1 nw
  have hB := rnqpow_two_le_sq hh0 hh1 nh
  have hB0 : (0 : Q') ≤ RingNormaliser.qpow h (nh + 2) :=
    rnqpow_nonneg hh0 (nh + 2)
