/-- The positive-coefficient part of the reduced quotient is nonnegative. -/
theorem r13Tail_nonneg {w h : Q'} (hw0 : (0 : Q') ≤ w)
    (hh0 : (0 : Q') ≤ h) :
    (0 : Q') ≤ RingNormaliser.eval
      (fun i => if i = 0 then w else h) r13TailExpr := by
  apply eval_nonneg_of_coefficients
  · intro i
    by_cases hi : i = 0
    · simp [hi, hw0]
    · simp [hi, hh0]
  · decide

/-- The reduced factor is nonnegative on the physical simplex. -/
theorem r13Reduced_nonneg {w h : Q'}
    (hh0 : (0 : Q') ≤ h) (hhw : h ≤ w)
    (hwcap : (4 : Q') * w ≤ (1 : Q')) :
    (0 : Q') ≤ RingNormaliser.eval
      (fun i => if i = 0 then w else h) r13ReducedExpr := by
  let rho : Nat → Q' := fun i => if i = 0 then w else h
  have hw0 : (0 : Q') ≤ w := Q'.le_trans' _ _ _ hh0 hhw
  have ht := r13Tail_nonneg hw0 hh0
  have ha := r13Adverse_paid hh0 hhw hwcap
  change (0 : Q') ≤
    ((48600 : Q') + RingNormaliser.eval rho r13TailExpr) +
      -RingNormaliser.eval rho r13AdverseExpr
  exact Q'.sub_nonneg_of_le
    (Q'.le_trans' _ _ _ ha
      (Q'.add_le_self_of_nonneg 48600
        (RingNormaliser.eval rho r13TailExpr) ht))

