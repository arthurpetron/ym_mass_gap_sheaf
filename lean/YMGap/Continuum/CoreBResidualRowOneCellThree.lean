      (fun i => if i = 0 then w else h) (residualQuotientExpr 1 3) := by
  let rho : Nat → Q' := fun i => if i = 0 then w else h
  have hw0 : (0 : Q') ≤ w := Q'.le_trans' _ _ _ hh0 hhw
  have hcommon : (0 : Q') ≤ RingNormaliser.eval rho r13CommonExpr := by
    change (0 : Q') ≤
      RingNormaliser.qpow w 64 * RingNormaliser.qpow h 64
    exact Q'.mul_nonneg _ _ (rnqpow_nonneg hw0 64) (rnqpow_nonneg hh0 64)
  have hreduced : (0 : Q') ≤ RingNormaliser.eval rho r13ReducedExpr :=
    r13Reduced_nonneg hh0 hhw hwcap
  have hprod : (0 : Q') ≤
      RingNormaliser.eval rho (.mul r13CommonExpr r13ReducedExpr) :=
    Q'.mul_nonneg _ _ hcommon hreduced
  have hn := RingNormaliser.poly_identity_of_normal_eq _ _ quotientNormal13 rho
  exact Q'.le_trans' _ _ _ hprod (Q'.ge_of_eqv hn)

/-- Exact square-Abel factorization at `(1,3)`, stated semantically. -/
theorem boundaryResidualAt_one_three_factor (w h : Q') :
    boundaryResidualAt w h 1 3 ≈
      (RingNormaliser.qpow w 2 + -(RingNormaliser.qpow h 2)) *
        RingNormaliser.eval (fun i => if i = 0 then w else h)
          (residualQuotientExpr 1 3) := by
  have hn := RingNormaliser.poly_identity_of_normal_eq _ _ factorNormal13
    (fun i => if i = 0 then w else h)
  exact Q'.eqv_trans _ _ _
    (boundaryResidualAt_eq_eval_residualExpr w h 1 3) hn

/-- **Row-one residual positivity at offset 3.**  `R(1,3) >= 0` on the
full physical simplex. -/
theorem boundaryResidualAt_one_three_nonneg {w h : Q'}
    (hh0 : (0 : Q') ≤ h) (hhw : h ≤ w)
    (hwcap : (4 : Q') * w ≤ (1 : Q')) :
    (0 : Q') ≤ boundaryResidualAt w h 1 3 := by
  have hsq : (0 : Q') ≤
      RingNormaliser.qpow w 2 + -(RingNormaliser.qpow h 2) :=
    Q'.sub_nonneg_of_le
      (Q'.le_trans' _ _ _ (Q'.le_of_eqv (rnqpow_eqv_qpow h 2))
        (Q'.le_trans' _ _ _ (HeatKernelGap.qpow_mono hh0 hhw 2)
          (Q'.ge_of_eqv (rnqpow_eqv_qpow w 2))))
  have hp := Q'.mul_nonneg _ _ hsq
    (residualQuotient_one_three_nonneg hh0 hhw hwcap)
  exact Q'.le_trans' _ _ _ hp
    (Q'.ge_of_eqv (boundaryResidualAt_one_three_factor w h))

