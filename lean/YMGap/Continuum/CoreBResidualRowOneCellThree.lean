  have h1 := Q'.mul_le_mul_of_nonneg_right
    (RingNormaliser.qpow w (nw + 2)) (w * w)
    (RingNormaliser.qpow h (nh + 2)) hA hB0
  have h2 := Q'.mul_le_mul_of_nonneg_left
    (RingNormaliser.qpow h (nh + 2)) (h * h) (w * w) hB hww0
  exact Q'.le_trans' _ _ _ h1 h2

