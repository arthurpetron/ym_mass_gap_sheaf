local infix:50 " ≈ " => Q'.eqv

/-! ## 1. Exact bounded state cylinders -/

/-- Characteristic function of agreement with one lower-half state on every
displayed lower face.  It is a globally defined unit observable. -/
def centralPhysicalStateCylinderUnitObservable
    (half : Nat) (source : EdgeLabelling) :
    CentralPhysicalUnitObservable where
  value state :=
    if labellingsAgreeOnB
        (centralLowerFaceIds half) state source then 1 else 0
  nonnegative := by
    intro state
    cases labellingsAgreeOnB
      (centralLowerFaceIds half) state source <;> decide
  le_one := by
    intro state
    cases labellingsAgreeOnB
      (centralLowerFaceIds half) state source <;> decide

/-- Finite syntactic linear combination of exact state cylinders. -/
def centralPhysicalStateCylinderLinearCombination
    (half : Nat) (stateAt : Nat → EdgeLabelling)
    (coefficient : Nat → Q') : List Nat →
      CentralPhysicalLinearObservable
  | [] => .zero
  | index :: rest =>
      .add
        (.smul (coefficient index)
          (.atom (centralPhysicalStateCylinderUnitObservable
            half (stateAt index))))
        (centralPhysicalStateCylinderLinearCombination
          half stateAt coefficient rest)

/-- The dense linear observable represented by an arbitrary coefficient on a
fixed finite canonical vacuum component. -/
def centralPhysicalFiniteVacuumSectorLinearObservable
    (w : Q') (hw : (0 : Q') ≤ w) (base half : Nat)
    (coefficient : Nat → Q') : CentralPhysicalLinearObservable :=
  centralPhysicalStateCylinderLinearCombination half
    (centralPhysicalFiniteStateAt w hw base half) coefficient
    (centralPhysicalFiniteVacuumSectorIndices w hw base half)

theorem centralPhysicalStateCylinderLinearCombination_value
    (half : Nat) (stateAt : Nat → EdgeLabelling)
    (coefficient : Nat → Q') (state : EdgeLabelling) :
    ∀ indices : List Nat,
      (centralPhysicalStateCylinderLinearCombination
        half stateAt coefficient indices).value state ≈
      listQSum
        (fun index =>
          if labellingsAgreeOnB
              (centralLowerFaceIds half) state (stateAt index)
          then coefficient index else 0)
        indices
  | [] => Q'.eqv_refl 0
  | index :: rest => by
      simp only [centralPhysicalStateCylinderLinearCombination,
        CentralPhysicalLinearObservable.value, listQSum]
      cases hagree : labellingsAgreeOnB
          (centralLowerFaceIds half) state (stateAt index) with
      | false =>
          simp only [centralPhysicalStateCylinderUnitObservable,
            hagree, Bool.false_eq_true, if_false]
          exact Q'.add_eqv_congr'
            (Q'.mul_zero_eqv (coefficient index))
            (centralPhysicalStateCylinderLinearCombination_value
              half stateAt coefficient state rest)
      | true =>
          simp only [centralPhysicalStateCylinderUnitObservable,
            hagree, if_true]
          exact Q'.add_eqv_congr'
            (Q'.mul_one_eqv (coefficient index))
            (centralPhysicalStateCylinderLinearCombination_value
              half stateAt coefficient state rest)

/-! ## 2. Cylinder equality is the explicit cutoff embedding -/

private theorem centralPhysicalFiniteStateAt_injective_of_lt
    {w : Q'} {hw : (0 : Q') ≤ w} {cutoff half left right : Nat}
    (hleft : left < centralPhysicalFiniteCarrierSize w hw cutoff half)
    (hright : right < centralPhysicalFiniteCarrierSize w hw cutoff half)
    (hstate : centralPhysicalFiniteStateAt w hw cutoff half left =
      centralPhysicalFiniteStateAt w hw cutoff half right) :
    left = right := by
  let states := centralPositiveHalfStates w hw cutoff half
  have hoptions : states[left]? = states[right]? := by
    rw [List.getElem?_eq_getElem hleft,
      List.getElem?_eq_getElem hright]
    apply congrArg some
    change states.getD left zeroEdgeLabelling =
      states.getD right zeroEdgeLabelling at hstate
    rw [← List.getElem_eq_getD
        (l := states) (i := left) (h := hleft) zeroEdgeLabelling,
      ← List.getElem_eq_getD
        (l := states) (i := right) (h := hright) zeroEdgeLabelling]
      at hstate
    exact hstate
  exact List.getElem?_inj hleft
    (centralPositiveHalfStates_nodup w hw cutoff half) hoptions

/-- On an in-range later carrier, agreement with one old sector state is
equivalent to being the explicit image of that old index. -/
theorem centralPhysicalStateCylinder_agrees_iff_cutoffIndexMap_eq
    {w : Q'} {hw : (0 : Q') ≤ w}
    {base later half source target : Nat}
    (hcutoff : base ≤ later)
    (hsource : source ∈
      centralPhysicalFiniteVacuumSectorIndices w hw base half)
    (htarget : target <
      centralPhysicalFiniteCarrierSize w hw later half) :
    labellingsAgreeOnB (centralLowerFaceIds half)
        (centralPhysicalFiniteStateAt w hw later half target)
        (centralPhysicalFiniteStateAt w hw base half source) = true ↔
      centralPhysicalFiniteCutoffIndexMap
        w hw base later half source = target := by
  have hsourceLt := centralPhysicalFiniteVacuumSectorIndex_lt
    w hw base half hsource
  have hsourcePositive := centralPhysicalFiniteStateAt_mem_positive
    w hw base half hsourceLt
  have hsourceLaterPositive := mem_centralPositiveHalfStates_of_le
    hw hcutoff hsourcePositive
  have htargetPositive := centralPhysicalFiniteStateAt_mem_positive
    w hw later half htarget
  have hsourceBounded :
      centralPhysicalFiniteStateAt w hw base half source ∈
        boundedEdgeLabellings later (centralLowerFaceIds half) := by
    have hhalf :=
      (mem_centralPositiveHalfStates_iff.mp hsourceLaterPositive).1
    exact hhalf
  have htargetBounded :
      centralPhysicalFiniteStateAt w hw later half target ∈
        boundedEdgeLabellings later (centralLowerFaceIds half) := by
    have hhalf :=
      (mem_centralPositiveHalfStates_iff.mp htargetPositive).1
    exact hhalf
  constructor
  · intro hagree
    have htargetState :
        centralPhysicalFiniteStateAt w hw later half target =
          centralPhysicalFiniteStateAt w hw base half source :=
      eq_of_labellingsAgreeOnB_of_bounded
        htargetBounded hsourceBounded hagree
    have hmapLt := centralPhysicalFiniteCutoffIndexMap_lt
      hcutoff hsourceLt
    have hmapState := centralPhysicalFiniteStateAt_cutoffIndexMap_eq
      hcutoff hsourceLt
    exact centralPhysicalFiniteStateAt_injective_of_lt
      hmapLt htarget (hmapState.trans htargetState.symm)
  · intro hmap
    have hstate :
        centralPhysicalFiniteStateAt w hw later half target =
          centralPhysicalFiniteStateAt w hw base half source := by
      rw [← hmap]
      exact centralPhysicalFiniteStateAt_cutoffIndexMap_eq
        hcutoff hsourceLt
    rw [hstate]
    exact labellingsAgreeOnB_self
      (centralLowerFaceIds half)
      (centralPhysicalFiniteStateAt w hw base half source)

/-! ## 3. Exact dense-carrier realization and form contraction -/

/-- Evaluation of the dense cylinder combination is exactly the full-carrier
zero extension of the finite vacuum-sector coefficient. -/
theorem centralPhysicalFiniteVacuumSectorLinearObservable_value_eqv_extension
    {w : Q'} {hw : (0 : Q') ≤ w}
    {base later half target : Nat} (hcutoff : base ≤ later)
    (coefficient : Nat → Q')
    (htarget : target <
      centralPhysicalFiniteCarrierSize w hw later half) :
    (centralPhysicalFiniteVacuumSectorLinearObservable
        w hw base half coefficient).value
        (centralPhysicalFiniteStateAt w hw later half target) ≈
      centralPhysicalFiniteVacuumSectorCoefficientExtension
        w hw base later half coefficient target := by
  unfold centralPhysicalFiniteVacuumSectorLinearObservable
    centralPhysicalFiniteVacuumSectorCoefficientExtension
  refine Q'.eqv_trans _
    (listQSum
      (fun source =>
        if labellingsAgreeOnB (centralLowerFaceIds half)
            (centralPhysicalFiniteStateAt w hw later half target)
            (centralPhysicalFiniteStateAt w hw base half source)
        then coefficient source else 0)
      (centralPhysicalFiniteVacuumSectorIndices w hw base half)) _ ?_ ?_
  · exact centralPhysicalStateCylinderLinearCombination_value
      half (centralPhysicalFiniteStateAt w hw base half)
      coefficient
      (centralPhysicalFiniteStateAt w hw later half target)
      (centralPhysicalFiniteVacuumSectorIndices w hw base half)
  · apply listQSum_congr_on
    intro source hsource
    have hiff := centralPhysicalStateCylinder_agrees_iff_cutoffIndexMap_eq
      hcutoff hsource htarget
    by_cases hmap : centralPhysicalFiniteCutoffIndexMap
        w hw base later half source = target
    · have hagree := hiff.mpr hmap
      simp only [hagree, hmap, if_true]
      exact Q'.eqv_refl _
    · have hagree : labellingsAgreeOnB (centralLowerFaceIds half)
          (centralPhysicalFiniteStateAt w hw later half target)
          (centralPhysicalFiniteStateAt w hw base half source) = false := by
        cases hvalue : labellingsAgreeOnB (centralLowerFaceIds half)
            (centralPhysicalFiniteStateAt w hw later half target)
            (centralPhysicalFiniteStateAt w hw base half source) with
        | false => rfl
        | true => exact False.elim (hmap (hiff.mp hvalue))
      simp only [hagree, hmap, Bool.false_eq_true, if_false]
      exact Q'.eqv_refl 0

/-- The indexed coefficient of the dense observable is the sector zero
extension at every in-range later index. -/
theorem centralPhysicalFiniteCoefficient_linearObservable_eqv_extension
    {w : Q'} {hw : (0 : Q') ≤ w}
    {base later half target : Nat} (hcutoff : base ≤ later)
    (coefficient : Nat → Q')
    (htarget : target <
      centralPhysicalFiniteCarrierSize w hw later half) :
    centralPhysicalFiniteCoefficient w hw later half
        (centralPhysicalFiniteVacuumSectorLinearObservable
          w hw base half coefficient).value target ≈
      centralPhysicalFiniteVacuumSectorCoefficientExtension
        w hw base later half coefficient target :=
  centralPhysicalFiniteVacuumSectorLinearObservable_value_eqv_extension
    hcutoff coefficient htarget

/-- The physical norm of the realized dense observable is exactly the pulled
vacuum-sector diagonal quadratic at every later cutoff. -/
theorem centralPhysicalFiniteVacuumSectorLinearObservable_diagonal_eqv_pulled
    {w : Q'} {hw : (0 : Q') ≤ w}
    {base later half : Nat} (hcutoff : base ≤ later)
    (coefficient : Nat → Q') :
    centralPhysicalWeightedInner w hw later half
        (centralPhysicalFiniteVacuumSectorLinearObservable
          w hw base half coefficient).value
        (centralPhysicalFiniteVacuumSectorLinearObservable
          w hw base half coefficient).value ≈
      centralPhysicalFinitePulledVacuumSectorDiagonalQuadratic
        w hw base later half coefficient := by
  let observable := centralPhysicalFiniteVacuumSectorLinearObservable
    w hw base half coefficient
  refine Q'.eqv_trans _
    (finiteDiagonalQuadratic
      (centralPhysicalFiniteCarrierSize w hw later half)
      (centralPhysicalFiniteWeight w hw later half)
      (centralPhysicalFiniteCoefficient w hw later half observable.value)) _
      ?_ ?_
  · exact Q'.eqv_symm
      (centralPhysicalFiniteDiagonalQuadratic_eqv_weightedInner
        w hw later half observable.value)
  refine Q'.eqv_trans _
    (finiteDiagonalQuadratic
      (centralPhysicalFiniteCarrierSize w hw later half)
      (centralPhysicalFiniteWeight w hw later half)
      (centralPhysicalFiniteVacuumSectorCoefficientExtension
        w hw base later half coefficient)) _ ?_ ?_
  · apply finiteDiagonalQuadratic_coefficient_congr
    intro target htarget
    exact centralPhysicalFiniteCoefficient_linearObservable_eqv_extension
      hcutoff coefficient htarget
  · exact centralPhysicalFiniteFullCarrierCoefficientExtensionDiagonal_eqv_pulled
      hcutoff coefficient

/-- The physical transfer quadratic of the realized dense observable is
exactly the pulled vacuum-sector matrix quadratic at every later cutoff. -/
theorem centralPhysicalFiniteVacuumSectorLinearObservable_matrix_eqv_pulled
    {w : Q'} {hw : (0 : Q') ≤ w}
    {base later half : Nat} (hcutoff : base ≤ later)
    (coefficient : Nat → Q') :
    centralPhysicalJointQuadratic w hw later half
        (centralPhysicalFiniteVacuumSectorLinearObservable
          w hw base half coefficient).value ≈
      centralPhysicalFinitePulledVacuumSectorMatrixQuadratic
        w hw base later half coefficient := by
  let observable := centralPhysicalFiniteVacuumSectorLinearObservable
    w hw base half coefficient
  refine Q'.eqv_trans _
    (finiteMatrixQuadratic
      (centralPhysicalFiniteCarrierSize w hw later half)
      (centralPhysicalFiniteKernel w hw later half)
      (centralPhysicalFiniteCoefficient w hw later half observable.value)) _
      ?_ ?_
  · exact Q'.eqv_symm
      (centralPhysicalFiniteMatrixQuadratic_eqv_jointQuadratic
        w hw later half observable.value)
  refine Q'.eqv_trans _
    (finiteMatrixQuadratic
      (centralPhysicalFiniteCarrierSize w hw later half)
      (centralPhysicalFiniteKernel w hw later half)
      (centralPhysicalFiniteVacuumSectorCoefficientExtension
        w hw base later half coefficient)) _ ?_ ?_
  · apply finiteMatrixQuadratic_coefficient_congr
    intro target htarget
    exact centralPhysicalFiniteCoefficient_linearObservable_eqv_extension
      hcutoff coefficient htarget
  · exact centralPhysicalFiniteFullCarrierCoefficientExtensionMatrix_eqv_pulled
      hcutoff coefficient

