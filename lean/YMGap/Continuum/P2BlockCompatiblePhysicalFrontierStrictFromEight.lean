/-
Track 11.7-fusion / R4c -- install both checked `k=7` theta head cells.

The exact physical fine reserve and trapezoid exchange are now proved at
`k=7`.  This module removes both discharged cells from the honest input:

* trapezoid exchange is requested only for `k>=8`;
* fine reserve is requested only for `k>=8`;
* weighted-box strong Turan remains the independent coefficient input.

The strict carrier still compiles to the actual all-cutoff `pGamma=2`
canonical control family and the genuine `BlockingStep.Phi` quotient defect.
No `Classical`, `native_decide`, `sorry`, custom axiom, or noncomputable
declaration.
-/

import YMGap.Continuum.P2BlockCompatibleThetaTrapezoidSevenFixedPoint
import YMGap.Continuum.P2BlockCompatiblePhysicalFrontierFromEight

namespace YMGap.Continuum.P2BlockCompatiblePhysicalFrontierStrictFromEight

open YMGap.Constructive
open YMGap.Continuum
open YMGap.Continuum.ArbitraryTruncationRetuneCorr
open YMGap.Continuum.BlockingStepFrontier
open YMGap.Continuum.CanonicalFusionSpectrumFamily
open YMGap.Continuum.P2BlockCompatiblePhysicalFrontierFromEight
open YMGap.Continuum.P2BlockCompatibleSchedule
open YMGap.Continuum.P2BlockCompatibleStrongTuranBridge
open YMGap.Continuum.P2BlockCompatibleThetaClearedCertificate
open YMGap.Continuum.P2BlockCompatibleThetaParityTransport
open YMGap.Continuum.P2BlockCompatibleThetaTrapezoidExchange
open YMGap.Continuum.P2BlockCompatibleThetaTrapezoidSevenFixedPoint
open YMGap.Continuum.P2RetunedBlockingDictionary
open YMGap.Continuum.P2RetunedFusionDefectPower
open YMGap.Continuum.RGTransport

/-- Honest post-certificate theta frontier after both exact `k=7` cells have
been installed. -/
structure BlockCompatibleP2PostRadialTailStrictFromEight : Type where
  trapezoidExchange : forall k, 8 <= k ->
    let w0 := blockWeight k
    let w4 := qpow (blockWeight (k + 1)) 4
    fixedCutoffTrapezoidCross w0 w4 (blockNcut k) <= (0 : Q')
  fineReserve : forall k, 8 <= k ->
    let w1 := blockWeight (k + 1)
    let w4 := qpow w1 4
    let D1 := coordNormSq w1 (blockNcut (k + 1))
    let D4 := coordNormSq w4 (blockNcut k)
    let T1 := coefficientDeficit w1 (blockNcut (k + 1))
    let T4 := coefficientDeficit w4 (blockNcut k)
    Q'.ofNat 2 * (D4 * T1) +
        blockParityDebt k * (D1 * D4) <= D1 * T4

/-- Insert the checked `k=7` trapezoid cell and recover the preceding carrier,
whose fine-reserve head was already theorem-generated. -/
def BlockCompatibleP2PostRadialTailStrictFromEight.toPostRadialTailFromEight
    (T : BlockCompatibleP2PostRadialTailStrictFromEight) :
    BlockCompatibleP2PostRadialTailFromEight where
  trapezoidExchange := fun k hk => by
    by_cases h7 : k = 7
    · subst k
      exact blockTrapezoidExchange_seven
    · exact T.trapezoidExchange k (by omega)
  fineReserve := T.fineReserve

/-- Complete current Bucket-1 analytic boundary with no caller-supplied
`k=7` theta field. -/
structure BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight : Type where
  coefficient : BlockCompatibleP2BoxStrongTuranData
  theta : BlockCompatibleP2PostRadialTailStrictFromEight

def BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight.toFrontierFromEight
    (A : BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight) :
    BlockCompatibleP2PhysicalFrontierAtomsFromEight where
  coefficient := A.coefficient
  theta := A.theta.toPostRadialTailFromEight

/-- The strict frontier constructs the actual all-cutoff `pGamma=2` family. -/
def BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight.toCanonicalFamily
    (A : BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight) :
    CanonicalBulkControlFamily :=
  A.toFrontierFromEight.toCanonicalFamily

theorem BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight.pGamma_ge_two
    (A : BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight) (k : Nat) :
    2 <= A.toCanonicalFamily.pGamma k :=
  A.toFrontierFromEight.pGamma_ge_two k

/-- The fine separator pin is generated by the selected canonical spectrum. -/
theorem BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight.finePin
    (A : BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight)
    (mode : Nat -> Nat) (k : Nat) :
    CReal.Equiv
      (canonicalFusionSeparator A.toCanonicalFamily mode (k + 1))
      (FusionSpectrumBlockingIdentification.fusionModeCReal
        (A.toCanonicalFamily.control (k + 1)) (mode (k + 1))) :=
  A.toFrontierFromEight.finePin mode k

/-- The image pin is the symmetric law of the actual physical blocking step. -/
theorem BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight.imagePin
    (A : BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight)
    (mode : Nat -> Nat)
    (B : BlockingStep (canonicalFusionSeparator A.toCanonicalFamily mode))
    (k : Nat) :
    CReal.Equiv
      (B.Φ (canonicalFusionSeparator A.toCanonicalFamily mode (k + 1)))
      (FusionSpectrumBlockingIdentification.fusionModeCReal
        (A.toCanonicalFamily.control k) (mode k)) :=
  A.toFrontierFromEight.imagePin mode B k

/-- The strict frontier reaches the genuine `BlockingStep.Phi` defect-power
identity through the mode-one quotient compiler. -/
theorem BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight.blockDefectPowerOnTrajectory
    (A : BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight)
    {B : BlockingStep
      (fusionSeparator
        A.toFrontierFromEight.toFrontierFromSeven.toPhysicalFrontierAtoms.coeffTailData.toControlFamily
        P2RetunedFusionPhysicalMode.modeOne)} :
    IsBlockDefectPowerOnTrajectory 1
      (fusionSeparator
        A.toFrontierFromEight.toFrontierFromSeven.toPhysicalFrontierAtoms.coeffTailData.toControlFamily
        P2RetunedFusionPhysicalMode.modeOne) B.Φ
      (A.toFrontierFromEight.toFrontierFromSeven.toPhysicalFrontierAtoms.modeOneTailMonotonicity
        |>.toQuotientData
          A.toFrontierFromEight.toFrontierFromSeven.toPhysicalFrontierAtoms.coeffTailData
          (B := B)
        |>.toCrossMul.factor) :=
  A.toFrontierFromEight.blockDefectPowerOnTrajectory

/-- The quotient factors retain the constructive half-loss gate. -/
theorem BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight.factorLossLeHalf
    (A : BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight)
    {B : BlockingStep
      (fusionSeparator
        A.toFrontierFromEight.toFrontierFromSeven.toPhysicalFrontierAtoms.coeffTailData.toControlFamily
        P2RetunedFusionPhysicalMode.modeOne)} (k : Nat) :
    (1 : Q') -
        (A.toFrontierFromEight.toFrontierFromSeven.toPhysicalFrontierAtoms.modeOneTailMonotonicity
          |>.toQuotientData
            A.toFrontierFromEight.toFrontierFromSeven.toPhysicalFrontierAtoms.coeffTailData
            (B := B)
          |>.toCrossMul.factor k) <=
      YMGap.Constructive.HalfPow.half :=
  A.toFrontierFromEight.factorLossLeHalf k

#print axioms BlockCompatibleP2PostRadialTailStrictFromEight.toPostRadialTailFromEight
#print axioms BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight.toCanonicalFamily
#print axioms BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight.finePin
#print axioms BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight.imagePin
#print axioms BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight.blockDefectPowerOnTrajectory
#print axioms BlockCompatibleP2PhysicalFrontierAtomsStrictFromEight.factorLossLeHalf

end YMGap.Continuum.P2BlockCompatiblePhysicalFrontierStrictFromEight
