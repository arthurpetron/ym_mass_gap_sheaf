/-
Track 11.7-fusion / R2n -- running-coupling defect cells and mode separation.

The fixed-weight N=2 to N=3 ladder cannot satisfy exact non-vacuum square
self-similarity.  The physically relevant repair runs both heat weight and
cutoff.  This module first certifies a bulk-localized step:

    coarse : N=2, w=11/12, mode=4
    fine   : N=4, w=23/24, mode=4.

Both endpoints have genuine reflected `CanonicalBulkControl`, mode four is
supported and bulk at both endpoints, and

    half * fine^2 <= coarse <= fine^2.

The generic quotient compiler therefore constructs the exact defect-power
cell with a contraction factor in `[1/2,1]`; no giant per-cell rational or
cross-product proof is stored.

The next dyadic bulk-mode step is then exactly refuted.  The repair is not to
move the physical gap edge into the tail: the physical separator and the
auxiliary bulk witness are independent.  At the three running endpoints
`N=2,4,8`, mode one is checked against every displayed non-vacuum mode, and the
first two mode-one dyadic quotient factors lie in `[1/2,1]`.

No `Classical`, `native_decide`, `sorry`, custom axiom, or noncomputable
declaration.
-/

import YMGap.Continuum.P2RetunedFusionDefectPower
import YMGap.Continuum.P2RetunedRatioCertificate

namespace YMGap.Continuum.P2RetunedFusionRunningCell

open YMGap.Constructive
open YMGap.Continuum
open YMGap.Continuum.RGTransport
open YMGap.Continuum.BulkModeCrux
open YMGap.Continuum.FusionKernelStatement
open YMGap.Continuum.RebasedBulkLocalizationBridge
open YMGap.Continuum.P2RetunedRatioCompiler
open YMGap.Continuum.P2RetunedRatioCertificate
open YMGap.Continuum.P2RetunedFusionDefectPower

set_option maxHeartbeats 4000000
set_option maxRecDepth 30000

/-- Fine-scale heat weight with half the coarse heat-time margin. -/
def runningFineW : Q' := Q'.mkPos 23 24 (by decide)

theorem runningFineW_nonneg : (0 : Q') <= runningFineW := by decide
theorem runningFineW_le_one : runningFineW <= (1 : Q') := by decide
theorem runningFineW_near_continuum :
    (1 : Q') - runningFineW <= SpectralLocalizationCrux.q112 := by decide

/-- The fine cutoff-four p=2 tail is checked exactly. -/
theorem runningFineTailRatioCheckN4 :
    p2TailRatioCheck 4 runningFineW runningFineW_nonneg
      runningFineW_le_one = true := by decide

/-- Genuine canonical fine endpoint. -/
def runningFineControlN4 : CanonicalBulkControl 4 runningFineW 2 :=
  canonicalBulkControl_p2_of_check (by decide)
    runningFineW_nonneg runningFineW_le_one
    runningFineW_near_continuum runningFineTailRatioCheckN4

/-- Coarse and fine mode-four eigenvalues before constructive-real embedding. -/
def runningCoarseModeFourQ : Q' :=
  fusionEig 2 fenceW 2 4 (fenceRetunedControlN2.denomPos 4)

def runningFineModeFourQ : Q' :=
  fusionEig 4 runningFineW 2 4 (runningFineControlN4.denomPos 4)

/-- Mode four is supported and lies in the effective bulk at both endpoints. -/
theorem runningCoarseModeFour_support : 4 <= 2 * 2 := by decide
theorem runningFineModeFour_support : 4 <= 2 * 4 := by decide

theorem runningCoarseModeFour_bulk :
    q12 <= Q'.ofNat (c4 4) *
      ((1 : Q') - fenceRetunedControlN2.weff) := by decide

theorem runningFineModeFour_bulk :
    q12 <= Q'.ofNat (c4 4) *
      ((1 : Q') - runningFineControlN4.weff) := by decide

/-- Positivity guard for the quotient compiler. -/
theorem runningFineModeFour_sq_pos :
    (0 : Q') < RGTransport.qpow runningFineModeFourQ 2 := by decide

theorem runningCoarseModeFour_nonneg :
    (0 : Q') <= runningCoarseModeFourQ := by decide

/-- **The exact running spectral sandwich.** -/
theorem runningModeFour_coarse_le_fine_sq :
    runningCoarseModeFourQ <= RGTransport.qpow runningFineModeFourQ 2 := by decide

theorem runningModeFour_half_fine_sq_le_coarse :
    HalfPow.half * RGTransport.qpow runningFineModeFourQ 2 <=
      runningCoarseModeFourQ := by decide

/-- Canonical quotient factor for the running step. -/
def runningModeFourFactor : Q' :=
  canonicalDefectFactor runningCoarseModeFourQ runningFineModeFourQ 2
    runningFineModeFour_sq_pos

theorem runningModeFourFactor_nonneg :
    (0 : Q') <= runningModeFourFactor :=
  canonicalDefectFactor_nonneg runningFineModeFour_sq_pos
    runningCoarseModeFour_nonneg

theorem runningModeFourFactor_le_one :
    runningModeFourFactor <= (1 : Q') :=
  canonicalDefectFactor_le_one runningFineModeFour_sq_pos
    runningModeFour_coarse_le_fine_sq

theorem runningModeFourFactor_loss_le_half :
    (1 : Q') - runningModeFourFactor <= HalfPow.half :=
  one_sub_le_half_of_half_le
    (half_le_canonicalDefectFactor runningFineModeFour_sq_pos
      runningModeFour_half_fine_sq_le_coarse)

/-- The exact defect-power identity, generated by rational division
cancellation rather than a per-cell computation. -/
def runningModeFourCell :
    QDefectPowerCell runningCoarseModeFourQ runningFineModeFourQ
      runningModeFourFactor 2 :=
  canonicalDefectPowerCell runningCoarseModeFourQ runningFineModeFourQ 2
    runningFineModeFour_sq_pos

/-- The executable checker agrees, by generic completeness. -/
theorem runningModeFourCell_check :
    qDefectPowerCellCheck runningCoarseModeFourQ runningFineModeFourQ
      runningModeFourFactor 2 = true :=
  (qDefectPowerCellCheck_eq_true_iff _ _ _ _).2 runningModeFourCell.eqv

/-! ## The physical mode-one branch -/

/-- The candidate physical gap edge at the first two running endpoints. -/
def runningCoarseModeOneQ : Q' :=
  fusionEig 2 fenceW 2 1 (fenceRetunedControlN2.denomPos 1)

def runningFineModeOneQ : Q' :=
  fusionEig 4 runningFineW 2 1 (runningFineControlN4.denomPos 1)

theorem runningCoarseModeOne_support : 1 <= 2 * 2 := by decide
theorem runningFineModeOne_support : 1 <= 2 * 4 := by decide

/-- Mode one is the exact largest displayed non-vacuum eigenvalue at the
coarse endpoint. -/
theorem runningCoarseModeOne_dominates (s : Nat) (hs : 1 <= s)
    (hsupport : s <= 2 * 2) :
    fusionEig 2 fenceW 2 s (fenceRetunedControlN2.denomPos s) <=
      runningCoarseModeOneQ := by
  have hcases : s = 1 \/ s = 2 \/ s = 3 \/ s = 4 := by omega
  clear hs hsupport
  rcases hcases with rfl | rfl | rfl | rfl <;> decide

/-- Mode one is likewise the exact largest displayed non-vacuum eigenvalue at
the first fine endpoint. -/
theorem runningFineModeOne_dominates (s : Nat) (hs : 1 <= s)
    (hsupport : s <= 2 * 4) :
    fusionEig 4 runningFineW 2 s (runningFineControlN4.denomPos s) <=
      runningFineModeOneQ := by
  have hcases :
      s = 1 \/ s = 2 \/ s = 3 \/ s = 4 \/
      s = 5 \/ s = 6 \/ s = 7 \/ s = 8 := by omega
  clear hs hsupport
  rcases hcases with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    decide

theorem runningFineModeOne_sq_pos :
    (0 : Q') < RGTransport.qpow runningFineModeOneQ 2 := by decide

theorem runningCoarseModeOne_nonneg :
    (0 : Q') <= runningCoarseModeOneQ := by decide

theorem runningModeOneFirst_coarse_le_fine_sq :
    runningCoarseModeOneQ <= RGTransport.qpow runningFineModeOneQ 2 := by decide

theorem runningModeOneFirst_half_fine_sq_le_coarse :
    HalfPow.half * RGTransport.qpow runningFineModeOneQ 2 <=
      runningCoarseModeOneQ := by decide

/-- The physical mode-one quotient for `N=2 -> N=4`. -/
def runningModeOneFirstFactor : Q' :=
  canonicalDefectFactor runningCoarseModeOneQ runningFineModeOneQ 2
    runningFineModeOne_sq_pos

theorem runningModeOneFirstFactor_nonneg :
    (0 : Q') <= runningModeOneFirstFactor :=
  canonicalDefectFactor_nonneg runningFineModeOne_sq_pos
    runningCoarseModeOne_nonneg

theorem runningModeOneFirstFactor_le_one :
    runningModeOneFirstFactor <= (1 : Q') :=
  canonicalDefectFactor_le_one runningFineModeOne_sq_pos
    runningModeOneFirst_coarse_le_fine_sq

theorem runningModeOneFirstFactor_loss_le_half :
    (1 : Q') - runningModeOneFirstFactor <= HalfPow.half :=
  one_sub_le_half_of_half_le
    (half_le_canonicalDefectFactor runningFineModeOne_sq_pos
      runningModeOneFirst_half_fine_sq_le_coarse)

def runningModeOneFirstCell :
    QDefectPowerCell runningCoarseModeOneQ runningFineModeOneQ
      runningModeOneFirstFactor 2 :=
  canonicalDefectPowerCell runningCoarseModeOneQ runningFineModeOneQ 2
    runningFineModeOne_sq_pos

/-! ## The natural dyadic continuation is not automatic -/

/-- Next dyadic heat weight. -/
def runningNextW : Q' := Q'.mkPos 47 48 (by decide)

theorem runningNextW_nonneg : (0 : Q') <= runningNextW := by decide
theorem runningNextW_le_one : runningNextW <= (1 : Q') := by decide
theorem runningNextW_near_continuum :
    (1 : Q') - runningNextW <= SpectralLocalizationCrux.q112 := by decide

theorem runningNextTailRatioCheckN8 :
    p2TailRatioCheck 8 runningNextW runningNextW_nonneg
      runningNextW_le_one = true := by decide

def runningNextControlN8 : CanonicalBulkControl 8 runningNextW 2 :=
  canonicalBulkControl_p2_of_check (by decide)
    runningNextW_nonneg runningNextW_le_one
    runningNextW_near_continuum runningNextTailRatioCheckN8

def runningNextModeQ (s : Nat) : Q' :=
  fusionEig 8 runningNextW 2 s (runningNextControlN8.denomPos s)

/-- The next physical mode-one endpoint. -/
def runningNextModeOneQ : Q' := runningNextModeQ 1

theorem runningNextModeOne_support : 1 <= 2 * 8 := by decide

theorem runningNextModeOne_dominates (s : Nat) (hs : 1 <= s)
    (hsupport : s <= 2 * 8) :
    runningNextModeQ s <= runningNextModeOneQ := by
  have hcases :
      s = 1 \/ s = 2 \/ s = 3 \/ s = 4 \/ s = 5 \/ s = 6 \/
      s = 7 \/ s = 8 \/ s = 9 \/ s = 10 \/ s = 11 \/ s = 12 \/
      s = 13 \/ s = 14 \/ s = 15 \/ s = 16 := by omega
  clear hs hsupport
  rcases hcases with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
      rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide

theorem runningNextModeOne_sq_pos :
    (0 : Q') < RGTransport.qpow runningNextModeOneQ 2 := by decide

theorem runningFineModeOne_nonneg :
    (0 : Q') <= runningFineModeOneQ := by decide

theorem runningModeOneSecond_coarse_le_fine_sq :
    runningFineModeOneQ <= RGTransport.qpow runningNextModeOneQ 2 := by decide

theorem runningModeOneSecond_half_fine_sq_le_coarse :
    HalfPow.half * RGTransport.qpow runningNextModeOneQ 2 <=
      runningFineModeOneQ := by decide

/-- The physical mode-one quotient for `N=4 -> N=8`. -/
def runningModeOneSecondFactor : Q' :=
  canonicalDefectFactor runningFineModeOneQ runningNextModeOneQ 2
    runningNextModeOne_sq_pos

theorem runningModeOneSecondFactor_nonneg :
    (0 : Q') <= runningModeOneSecondFactor :=
  canonicalDefectFactor_nonneg runningNextModeOne_sq_pos
    runningFineModeOne_nonneg

theorem runningModeOneSecondFactor_le_one :
    runningModeOneSecondFactor <= (1 : Q') :=
  canonicalDefectFactor_le_one runningNextModeOne_sq_pos
    runningModeOneSecond_coarse_le_fine_sq

theorem runningModeOneSecondFactor_loss_le_half :
    (1 : Q') - runningModeOneSecondFactor <= HalfPow.half :=
  one_sub_le_half_of_half_le
    (half_le_canonicalDefectFactor runningNextModeOne_sq_pos
      runningModeOneSecond_half_fine_sq_le_coarse)

def runningModeOneSecondCell :
    QDefectPowerCell runningFineModeOneQ runningNextModeOneQ
      runningModeOneSecondFactor 2 :=
  canonicalDefectPowerCell runningFineModeOneQ runningNextModeOneQ 2
    runningNextModeOne_sq_pos

/-- At the next endpoint every bulk mode is at least six. -/
theorem runningNext_bulk_mode_ge_six (s : Nat)
    (hbulk : q12 <= Q'.ofNat (c4 s) *
      ((1 : Q') - runningNextControlN8.weff)) :
    6 <= s := by
  by_cases hs : 6 <= s
  · exact hs
  · have hcases : s = 0 \/ s = 1 \/ s = 2 \/ s = 3 \/ s = 4 \/ s = 5 := by
      omega
    rcases hcases with rfl | rfl | rfl | rfl | rfl | rfl
    all_goals
      exfalso
      revert hbulk
      decide

/-- **Second-step no-go for the naive dyadic iteration.**  Starting from the
fine endpoint's mode four, no supported bulk mode at `(N=8,w=47/48)` satisfies
the upper spectral sandwich.  Thus the one-step cell cannot simply be iterated
with the minimal dyadic cutoff/weight schedule. -/
theorem runningSecondStep_no_supported_bulk_upperSandwich
    (fineMode : Nat) (hfineSupport : fineMode <= 16)
    (hfineBulk : q12 <= Q'.ofNat (c4 fineMode) *
      ((1 : Q') - runningNextControlN8.weff)) :
    ¬ (runningFineModeFourQ <= RGTransport.qpow (runningNextModeQ fineMode) 2) := by
  have hfineMin : 6 <= fineMode := runningNext_bulk_mode_ge_six fineMode hfineBulk
  have hcases :
      fineMode = 6 \/ fineMode = 7 \/ fineMode = 8 \/ fineMode = 9 \/
      fineMode = 10 \/ fineMode = 11 \/ fineMode = 12 \/ fineMode = 13 \/
      fineMode = 14 \/ fineMode = 15 \/ fineMode = 16 := by
    omega
  clear hfineMin hfineSupport hfineBulk
  rcases hcases with rfl | rfl | rfl | rfl | rfl | rfl |
      rfl | rfl | rfl | rfl | rfl <;> decide

end YMGap.Continuum.P2RetunedFusionRunningCell

