import YMGap.Continuum.Z4FiniteBoxPacketState

/-!
# Gauge-closed heat-kernel packets on the finite Z4 box geometry

This file replaces the identity amplitude of `Z4FiniteBoxPacketState` by the
derived SU(2) heat-kernel character coefficient `coeffW coupling` on every
plaquette edge.  Internal trivalent fusion edges carry the exact all-ones
packet, while the base identifier reserved for an open link terminator
carries the vacuum packet.

The first non-vacuity witness is a genuine closed surface.  In the size-two
box, six explicitly derived plaquette identifiers form the boundary of a
unit three-dimensional cube.  Auxiliary labels are generated by parity of
the selected incident-plaquette prefix.  The kernel checks every trivalent
fusion guard and derives the nonzero projected amplitude
`729 / 281474976710656 = 729 / 2^48`.

Every state in the finite box family retains the universal `(1/8)^2`
support-pruned separator, and the number of used graph edges is unbounded.
The packet cutoff is still two and the coupling is the current exact
strong-coupling anchor.  This is not yet the full character tail, an
adjacent-volume correlator identity, or a thermodynamic/continuum limit.
-/

namespace YMGap.Continuum.Z4FiniteBoxHeatKernelPacketState

set_option maxRecDepth 100000
set_option maxHeartbeats 2000000

open YMGap.Constructive
open YMGap.Continuum
open YMGap.Continuum.BondMovingStep
open YMGap.Continuum.SpectralGap
open YMGap.Continuum.Z4FiniteBoxTrivalentResolution
open YMGap.Continuum.Z4FiniteBoxPacketState
open YMGap.Continuum.SU2CharacterVacuumHaar
open YMGap.Continuum.SU2FundamentalPentagonFiniteGraph
open YMGap.Continuum.SU2FiniteTrivalentPacketGraphActualOperator
open YMGap.Continuum.SU2FiniteTrivalentPacketGraphIdentityRefinementAmplitude
open YMGap.Continuum.SU2FiniteTrivalentPacketGraphCompensatedRefinementPath
open YMGap.Continuum.SU2FiniteTrivalentPacketGraphSupportedRefinementPath
open YMGap.Continuum.SU2FiniteTrivalentPacketGraphWeightedGapTransport
open YMGap.Continuum.SU2PeterWeylWilsonBlock

local infix:50 " ≈ " => Q'.eqv

/-- Auxiliary identifiers actually used by trivalent vertices.  Physical
plaquette identifiers are filtered out, and repeated vertex occurrences are
removed before they enter the transfer product. -/
def usedAuxiliaryEdges (n : Nat) : List Nat :=
  (((resolutionVertices n).flatMap vertexEdgeIds).filter
    fun edge => decide (plaquetteEdgeCount n ≤ edge)).eraseDups

/-- One occurrence of every plaquette representation edge, followed by the
deduplicated auxiliary identifiers actually used by the resolution. -/
def usedResolutionEdges (n : Nat) : List Nat :=
  List.range (plaquetteEdgeCount n) ++ usedAuxiliaryEdges n

/-- Exact finite SU(2) heat-kernel character packet. -/
def heatKernelPacket (K : Nat) (w : Q') : CharacterPacket K where
  coeff spin := coeffW w spin

theorem coeffAt_heatKernelPacket {K spin : Nat} {w : Q'}
    (hspin : spin < K + 1) :
    coeffAt (heatKernelPacket K w) spin = coeffW w spin := by
  rw [coeffAt_of_lt _ hspin]
  rfl

/-- Reserved base identifiers, one for every distinct physical lattice link. -/
def vacuumBaseEdgeIds (n : Nat) : List Nat :=
  (enumerate (distinctBoxLinks n)).map fun indexed =>
    linkBlockBase n indexed.1

/-- Heat-kernel packets on plaquettes, vacuum packets on open-link
terminators, and identity packets on internal fusion carriers. -/
def gaugeHeatKernelBoxPackets (n : Nat) : Nat → CharacterPacket 2 :=
  fun edge => if edge < plaquetteEdgeCount n
    then heatKernelPacket 2 coupling
    else if edge ∈ vacuumBaseEdgeIds n
      then vacuumPacket 2
      else allOnesPacket 2

/-- The gauge-closed cutoff-two heat-kernel packet state on box `n`. -/
def gaugeHeatKernelBoxState (n : Nat) : CompensatedGraphState 2 where
  edges := usedResolutionEdges n
  vertices := resolutionVertices n
  packet := gaugeHeatKernelBoxPackets n
  copiedEdges := []
  copied_mem := by intro edge h; cases h

/-- The same exact strong-coupling separator holds at every finite volume. -/
theorem gaugeHeatKernelBoxState_gap (n : Nat) :
    SpectralGapBound
      (supportedGraphSpectralModel (gaugeHeatKernelBoxState n))
      (eighth * eighth) :=
  path_supported_gap_from_uncompensated (.refl _) rfl

/-- The used heat-kernel graph edge counts are unbounded. -/
theorem usedResolutionEdges_unbounded (bound : Nat) :
    ∃ n : Nat, bound ≤ (usedResolutionEdges n).length := by
  obtain ⟨n, hn⟩ :=
    YMGap.Continuum.Z4FiniteBoxExhaustion.boxPlaquetteCount_unbounded bound
  refine ⟨n, ?_⟩
  unfold usedResolutionEdges
  rw [List.length_append, List.length_range]
  unfold plaquetteEdgeCount
  omega

/-! ## A closed elementary-cube surface -/

/-- The six oriented plaquettes forming the boundary of the unit cube in
coordinate directions zero, one, and two, at fourth coordinate zero. -/
def unitCubeSurface : List YMGap.Continuum.ClusterCount4DProgress.Z4Plaq :=
  [((0, 0, 0, 0), .p01), ((0, 0, 1, 0), .p01),
   ((0, 0, 0, 0), .p02), ((0, 1, 0, 0), .p02),
   ((0, 0, 0, 0), .p12), ((1, 0, 0, 0), .p12)]

/-- Numerical identifiers of the cube faces present in box `n`. -/
def unitCubeSurfaceIds (n : Nat) : List Nat :=
  ((enumerate (YMGap.Continuum.Z4FiniteBoxExhaustion.boxPlaquettes n)).filter
    fun indexed => decide (indexed.2 ∈ unitCubeSurface)).map Prod.fst

/-- Incident plaquette identifiers for the link with enumeration index
`linkId`. -/
def incidentPlaqIdsByLinkId (n linkId : Nat) : List Nat :=
  match (enumerate (distinctBoxLinks n))[linkId]? with
  | none => []
  | some indexed => incidentPlaqIds n indexed.2

/-- Number of selected cube faces in an initial segment of one link's
incident plaquette list. -/
def selectedPrefixCount (n linkId prefixLength : Nat) : Nat :=
  (((incidentPlaqIdsByLinkId n linkId).take prefixLength).filter
    fun plaquetteId => decide (plaquetteId ∈ unitCubeSurfaceIds n)).length

/-- Label the selected cube faces by spin one, propagate their parity through
each trivalent fusion chain, and set every reserved vacuum terminator to zero.
The outer membership guard fixes every unlisted identifier to zero. -/
def unitCubeSurfaceLabel (n : Nat) : EdgeLabelling :=
  fun edge =>
    if edge ∈ usedResolutionEdges n then
      if edge < plaquetteEdgeCount n then
        if edge ∈ unitCubeSurfaceIds n then 2 else 0
      else
        let delta := edge - plaquetteEdgeCount n
        let offset := delta % 8
        if offset = 0 then 0
        else if selectedPrefixCount n (delta / 8) (offset + 1) % 2 = 1
          then 2 else 0
    else 0

/-- The exact six plaquette identifiers obtained from the box enumeration. -/
theorem unitCubeSurfaceIds_two :
    unitCubeSurfaceIds 2 = [0, 1, 3, 12, 25, 51] := by decide

theorem unitCubeSurfaceLabel_mem_bounded :
    unitCubeSurfaceLabel 2 ∈ boundedEdgeLabellings 2
      (usedResolutionEdges 2) := by
  apply boundedEdgeLabellings_complete
  · intro edge he
    simp only [unitCubeSurfaceLabel, if_pos he]
    split
    · split <;> omega
    · split
      · omega
      · split <;> omega
  · intro edge he
    simp [unitCubeSurfaceLabel, he]

/-- The parity-propagated cube boundary satisfies every exact trivalent
fusion guard and is globally nonvacuum. -/
theorem unitCubeSurfaceLabel_physical :
    GraphPhysical (usedResolutionEdges 2) (resolutionVertices 2)
      (unitCubeSurfaceLabel 2) := by decide

theorem unitCubeSurfaceLabel_mem_physical :
    unitCubeSurfaceLabel 2 ∈ physicalEdgeLabellings 2
      (usedResolutionEdges 2) (resolutionVertices 2) := by
  exact List.mem_filter.mpr
    ⟨unitCubeSurfaceLabel_mem_bounded, unitCubeSurfaceLabel_physical⟩

/-- The exact six-face heat-kernel amplitude at the strong-coupling anchor. -/
def unitCubeHeatKernelAmplitude : Q' :=
  Q'.mkPos 729 281474976710656 (by decide)

theorem unitCubeHeatKernelAmplitude_pos :
    (0 : Q') < unitCubeHeatKernelAmplitude := by decide

/-- Direct character-product evaluation of the closed cube surface. -/
theorem unitCube_heatKernel_amplitude_exact :
    packetGraphProjectedAmplitude (usedResolutionEdges 2)
      (resolutionVertices 2) (gaugeHeatKernelBoxPackets 2)
      (unitCubeSurfaceLabel 2) ≈ unitCubeHeatKernelAmplitude := by decide

/-- The derived heat-kernel spectral model contains a positive-weight closed
surface mode. -/
theorem unitCube_heatKernel_nonzero_mode :
    ∃ i, i < (physicalEdgeLabellings 2 (usedResolutionEdges 2)
        (resolutionVertices 2)).length ∧
      packetGraphModeWeight (usedResolutionEdges 2) (resolutionVertices 2)
        (gaugeHeatKernelBoxPackets 2) i ≈
          unitCubeHeatKernelAmplitude * unitCubeHeatKernelAmplitude := by
  obtain ⟨i, hi, hget⟩ :=
    List.getElem_of_mem unitCubeSurfaceLabel_mem_physical
  refine ⟨i, hi, ?_⟩
  have hlabel : physicalModeLabel 2 (usedResolutionEdges 2)
      (resolutionVertices 2) i = unitCubeSurfaceLabel 2 := by
    unfold physicalModeLabel supportLabel
    rw [List.getElem?_eq_getElem hi, Option.getD_some, hget]
  unfold packetGraphModeWeight
  rw [hlabel]
  exact Q'.eqv_trans _
    (unitCubeHeatKernelAmplitude *
      packetGraphProjectedAmplitude (usedResolutionEdges 2)
        (resolutionVertices 2) (gaugeHeatKernelBoxPackets 2)
        (unitCubeSurfaceLabel 2)) _
    (Q'.mul_eqv_congr_right _ _ _ unitCube_heatKernel_amplitude_exact)
    (Q'.mul_eqv_congr_left _ _ _ unitCube_heatKernel_amplitude_exact)

end YMGap.Continuum.Z4FiniteBoxHeatKernelPacketState

