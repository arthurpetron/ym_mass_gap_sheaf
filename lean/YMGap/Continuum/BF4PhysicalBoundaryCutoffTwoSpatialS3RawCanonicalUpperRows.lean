    {row column : Fin 65} (hupper : row.val ≤ column.val) :
    YMGap.Continuum.BF4PhysicalBoundaryCutoffTwoSectorRawKernelCertificate.cutoffTwoSectorRawKernel
        row.val column.val ≈
      YMGap.Continuum.BF4PhysicalBoundaryCutoffTwoSectorRawKernelCertificate.cutoffTwoSectorRawKernel
