/-! ## 0. Small `Q'` helpers (nonnegativity of a sum; strict/loose contradiction). -/

/-- `0 ≤ a → 0 ≤ b → 0 ≤ a + b` (pure `Q'`). -/
theorem q_add_nonneg {a b : Q'} (ha : (0 : Q') ≤ a) (hb : (0 : Q') ≤ b) :
    (0 : Q') ≤ a + b := by
  have h := q_add_le_add ha hb
  rw [Q'.add_zero'] at h
  exact h

/-- `a < b` and `b ≤ a` is impossible (unfold to `Int` cross-products, `omega`). -/
theorem q_lt_le_false {a b : Q'} (h1 : a < b) (h2 : b ≤ a) : False := by
  have hlt : a.num * (b.den : Int) < b.num * (a.den : Int) := h1
  have hle : b.num * (a.den : Int) ≤ a.num * (b.den : Int) := h2
  omega

/-! ## 1. The induced 2-plaquette coupling and its strong-coupling suppression. -/

/-- **The leading induced 2-plaquette coupling** generated by one block-spin step:
`(coeffW w 1)² = (2·w³)² = 4·w⁶`, the connected two-plaquette Ursell activity on the
common excited rep `r = 1` (`MayerTwoPlaquette.connectedActivity2` at `|X| = 2`). -/
def inducedCoupling (w : Q') : Q' := coeffW w 1 * coeffW w 1

/-- The induced coupling is nonnegative. -/
theorem inducedCoupling_nonneg {w : Q'} (hw0 : (0 : Q') ≤ w) :
    (0 : Q') ≤ inducedCoupling w :=
  Q'.mul_nonneg _ _ (coeffW_nonneg hw0 1) (coeffW_nonneg hw0 1)

/-- `coeffW w 1 ≤ 1` on strong coupling `0 ≤ w ≤ 1/2` (from `coeffW1_le_quarter`). -/
theorem coeffW_one_le_one {w : Q'} (hw0 : (0 : Q') ≤ w)
    (hw12 : w ≤ FusionCoreStepRoundA.wH) : coeffW w 1 ≤ (1 : Q') := by
  refine Q'.le_trans' _ _ _ (FusionCoreStepRoundB.coeffW1_le_quarter hw0 hw12) ?_
  decide

/-- **FORM-PRESERVATION CORE (strong coupling).**  At `0 ≤ w ≤ 1/2` the induced
2-plaquette coupling is dominated by the single-coupling gap term:
`inducedCoupling w ≤ coeffW w 1`.  The effective action stays single-coupling-dominated —
the induced coupling carries the small activity factor `coeffW w 1 = 2·w³`. -/
theorem inducedCoupling_le_single {w : Q'} (hw0 : (0 : Q') ≤ w)
    (hw12 : w ≤ FusionCoreStepRoundA.wH) : inducedCoupling w ≤ coeffW w 1 := by
  have hc0 : (0 : Q') ≤ coeffW w 1 := coeffW_nonneg hw0 1
  have hc1 : coeffW w 1 ≤ (1 : Q') := coeffW_one_le_one hw0 hw12
  have h : coeffW w 1 * coeffW w 1 ≤ coeffW w 1 * (1 : Q') :=
    Q'.mul_le_mul_of_nonneg_left (coeffW w 1) 1 (coeffW w 1) hc1 hc0
  exact Q'.le_trans' _ _ _ h (Q'.le_of_eqv (Q'.mul_one_eqv (coeffW w 1)))

/-- **Sharp form-preservation.**  At `0 ≤ w ≤ 1/2` the induced coupling is at most a
QUARTER of the single term: `inducedCoupling w ≤ coeffW w 1 · (1/4)` (activity
`2·w³ ≤ 1/4`). -/
theorem inducedCoupling_le_quarter_single {w : Q'} (hw0 : (0 : Q') ≤ w)
    (hw12 : w ≤ FusionCoreStepRoundA.wH) :
    inducedCoupling w ≤ coeffW w 1 * Q'.mkPos 1 4 (by decide) := by
  have hc0 : (0 : Q') ≤ coeffW w 1 := coeffW_nonneg hw0 1
  have hcq : coeffW w 1 ≤ Q'.mkPos 1 4 (by decide) :=
    FusionCoreStepRoundB.coeffW1_le_quarter hw0 hw12
  exact Q'.mul_le_mul_of_nonneg_left (coeffW w 1) _ (coeffW w 1) hcq hc0

/-! ## 2. The cluster-activity convergence gate (named residual, Rule 6a). -/

/-- **`ClusterActivityBound afr` — the named cluster-expansion convergence input.**
At every RG scale `k` the connected-cluster ACTIVITY `coeffW (w_k) 1 = 2·w_k³` is bounded
by the SUMMABLE model defect `afDefectSeq afr k` (the deep-UV `1/k²` + finite-middle
sequence with a PROVED positive product floor, `afFloorEps_le_afPhysGapSeq`).  This is the
precise Kotecký–Preiss / small-activity condition that makes the induced-coupling polymer
expansion converge — the genuine remaining analytic content of form-preservation. -/
structure ClusterActivityBound (afr : AFRateModulus) : Type where
  /-- The per-scale induced-cluster activity is dominated by the summable model defect. -/
  activityBound : ∀ k, coeffW (afr.w (afCutoff afr + k)) 1 ≤ afDefectSeq afr k

/-- **THE REDUCTION.**  Under the cluster-activity gate and strong coupling at every scale,
the induced 2-plaquette coupling per block step is bounded by the SUMMABLE model defect:
`inducedCoupling (w_k) ≤ afDefectSeq afr k`.  Since `Σ afDefectSeq < ∞` (proved), the
induced-coupling sum converges: the effective action stays single-coupling-dominated to
all orders — form is preserved.  Reduces `SingleCouplingFormPreservation` to
`ClusterActivityBound` + strong coupling (both genuine, guard-safe, uninhabited for the
full 4D flow). -/
theorem inducedCoupling_le_afDefect {afr : AFRateModulus} (C : ClusterActivityBound afr)
    (hstrong : ∀ k, afr.w (afCutoff afr + k) ≤ FusionCoreStepRoundA.wH) (k : Nat) :
    inducedCoupling (afr.w (afCutoff afr + k)) ≤ afDefectSeq afr k := by
  have h1 : inducedCoupling (afr.w (afCutoff afr + k))
      ≤ coeffW (afr.w (afCutoff afr + k)) 1 :=
    inducedCoupling_le_single (afr.w_nonneg (afCutoff afr + k)) (hstrong k)
  exact Q'.le_trans' _ _ _ h1 (C.activityBound k)

/-! ## 3. Guard-safe conditional producer of `SingleCouplingFormPreservation`. -/

/-- **`formPreservation_of_afStep` — the guard-safe conditional producer.**  From the
AF β-step (for the monotone flow giving `eigShift ≥ 0`) and the Route-E large-field data,
build `SingleCouplingFormPreservation afr` in its REABSORBED form: the real per-step
erosion is `eigShiftSeq + largeFieldDefect`, with the non-abelian induced back-reaction
carried NO separate additive term.  Open binders on `AFBetaStep`/`LargeFieldSuppression`,
so this does NOT unconditionally inhabit the structure (guard-safe).  As the structure's
own docstring flags, it is the free-field reabsorbed form; the GENUINE content is the
induced-coupling analysis of §1–2 and the adversarial refutation of §4. -/
def formPreservation_of_afStep {afr : AFRateModulus} (S : AFBetaStep afr)
    (Ld : LargeFieldSuppression afr) : SingleCouplingFormPreservation afr where
  L := Ld
  realErosion k := eigShiftSeq afr.w (afCutoff afr + k) + Ld.largeFieldDefect k
  realErosion_nonneg k :=
    q_add_nonneg
      (AnchorDominance.eigShift_nonneg afr.w afr.w_nonneg S.mono (afCutoff afr + k))
      (Ld.lf_nonneg k)
  formPreserved _k := Q'.le_refl' _

/-! ## 4. ADVERSARIAL crux — the cluster gate is UNSATISFIABLE at weak coupling. -/

/-- The induced-cluster activity EXCEEDS one at weak coupling: `coeffW (9/10) 1 =
2·(9/10)³ = 1458/1000 > 1`.  (Closed decidable `Q'` fact.)  Past `w = 2^{-1/3} ≈ 0.7937`
the activity `2·w³` exceeds `1` and the polymer/cluster expansion diverges. -/
theorem coeffW_weak_gt_one : (1 : Q') < coeffW (Q'.mkPos 9 10 (by decide)) 1 := by decide

/-- **THE BAŁABAN CRUX (adversarial).**  The cluster-activity gate is PROVABLY
unsatisfiable at any scale whose coupling is weak: if `coeffW (w_k) 1 > 1` then
`ClusterActivityBound` is contradictory, because it forces
`coeffW (w_k) 1 ≤ afDefectSeq afr k ≤ 1`.  Since the AF flow runs `w_k → 1` (deep UV),
`coeffW (w_k) 1 = 2·w_k³ → 2 > 1`, so the character/cluster expansion does NOT reach the
continuum: form-preservation via this expansion holds only at strong coupling. -/
theorem cluster_gate_excludes_weak {afr : AFRateModulus} (C : ClusterActivityBound afr)
    (k : Nat) (hweak : (1 : Q') < coeffW (afr.w (afCutoff afr + k)) 1) : False := by
  have hle : coeffW (afr.w (afCutoff afr + k)) 1 ≤ afDefectSeq afr k := C.activityBound k
  have hle1 : afDefectSeq afr k ≤ (1 : Q') := afDefectSeq_le_one afr k
  have hchain : coeffW (afr.w (afCutoff afr + k)) 1 ≤ (1 : Q') :=
    Q'.le_trans' _ _ _ hle hle1
  exact q_lt_le_false hweak hchain

/-! ## 5. Honest verdict (AGENTS.md Rule 6 / Rule 9). -/

/-- **PROVED (axiom-clean):** `inducedCoupling_le_single` /
`inducedCoupling_le_quarter_single` (strong-coupling form-preservation core: the induced
2-plaquette coupling is dominated by the single term with activity `2·w³ ≤ 1/4`);
