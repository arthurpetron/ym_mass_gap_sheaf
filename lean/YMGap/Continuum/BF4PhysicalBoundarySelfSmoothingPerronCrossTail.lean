/-! ## One uniform proof-carrying contract -/

/-- Physical boundary self-smoothing data with the terminal spread supplied
in the stronger AF/Faraut Perron form.  The exact depth arithmetic is no
longer a field of the downstream cross-tail interface. -/
structure MatchedPhysicalBoundarySelfSmoothingPerronCrossTailRows
    (family : MatchedBlockFamily)
    (law : CubicMarginLaw family)
    (_spacing : PhysicalSpacingEnvelope law.g₁)
    (coupling : Nat → Q')
    (halfExtent diagonalOrder bits depth : Nat → Nat)
    (nonlinearRate : Nat → Q') : Type where
  coupling_pos :
    ∀ scale, (0 : Q') < coupling scale
  coupling_le_window :
    ∀ scale, coupling scale ≤ law.g₁
  calibrated_harnack :
    ∀ scale,
      CalibratedEmptyProfileHarnackData
        (matchedAllSpinWeight family coupling scale)
        (matchedAllSpinWeight_nonnegative family coupling scale)
        (matchedAllSpinCutoff family coupling scale)
        (halfExtent scale) (diagonalOrder scale) 0
  terminal :
    ∀ _scale, EdgeLabelling → EdgeLabelling → Q'
  terminalCertificate :
    ∀ scale,
      FiniteCrossRatioDiameterCertificate
        (terminal scale)
        (centralBoundaryChannels
          (matchedAllSpinCutoff family coupling scale)
          (halfExtent scale))
        (centralBoundaryChannels
          (matchedAllSpinCutoff family coupling scale)
          (halfExtent scale))
  nonlinearRate_nonnegative :
    ∀ scale, (0 : Q') ≤ nonlinearRate scale
  nonlinearRate_le_quarter :
    ∀ scale, nonlinearRate scale ≤ quarter
  depth_available :
    ∀ scale,
      farautTerminalSplitRequiredDepth (bits scale) ≤
        depth scale
  projectivePerron :
    ∀ scale,
      (terminalCertificate scale).spread *
          (terminalCertificate scale).spread ≤
        (1 : Q') +
          farautPerronSquare (bits scale) *
            nonlinearRate scale ^ (depth scale - 2)
  errorMajorant : Nat → Q'
  action_defect_le :
    ∀ scale source,
      source ∈
          centralPositiveHalfStates
            (matchedAllSpinWeight family coupling scale)
            (matchedAllSpinWeight_nonnegative family coupling scale)
            (matchedAllSpinCutoff family coupling scale)
            (halfExtent scale) →
        ∀ boundary,
          boundary ∈
              centralBoundaryChannels
                (matchedAllSpinCutoff family coupling scale)
                (halfExtent scale) →
            centralHalfAmplitudeBoundaryActionDefect
                (matchedAllSpinWeight family coupling scale)
                (matchedAllSpinCutoff family coupling scale)
                (halfExtent scale)
                (terminal scale) source boundary ≤
              errorMajorant scale
  errorTail :
    PositiveFloorErrorCrossTail
      errorMajorant
      (centralBoundaryActionFiniteFloor
        coupling halfExtent terminal terminalCertificate)
      physicalRelativeErrorTolerance

namespace MatchedPhysicalBoundarySelfSmoothingPerronCrossTailRows

/-- The AF/Faraut terminal estimate discharges the complete terminal-spread
budget and constructs the direct physical cross-tail package. -/
def toCrossTailRows
    {family : MatchedBlockFamily}
    {law : CubicMarginLaw family}
    {spacing : PhysicalSpacingEnvelope law.g₁}
    {coupling : Nat → Q'}
    {halfExtent diagonalOrder bits depth : Nat → Nat}
    {nonlinearRate : Nat → Q'}
    (data :
      MatchedPhysicalBoundarySelfSmoothingPerronCrossTailRows
        family law spacing coupling halfExtent diagonalOrder
        bits depth nonlinearRate) :
    MatchedPhysicalBoundarySelfSmoothingCrossTailRows
      family law spacing coupling halfExtent diagonalOrder where
  coupling_pos := data.coupling_pos
  coupling_le_window := data.coupling_le_window
  calibrated_harnack := data.calibrated_harnack
  terminal := data.terminal
  terminalCertificate := data.terminalCertificate
  terminal_spread_square_le_split :=
    terminal_spread_square_le_split_family
      data.terminalCertificate bits depth nonlinearRate
      data.nonlinearRate_nonnegative
      data.nonlinearRate_le_quarter
      data.depth_available
      data.projectivePerron
  errorMajorant := data.errorMajorant
  action_defect_le := data.action_defect_le
  errorTail := data.errorTail

/-- The Perron/cross-tail package reaches the generic computed-floor
physical-error interface without any separately assumed spread budget. -/
def toComputedFloorErrorRows
    {family : MatchedBlockFamily}
    {law : CubicMarginLaw family}
    {spacing : PhysicalSpacingEnvelope law.g₁}
    {coupling : Nat → Q'}
    {halfExtent diagonalOrder bits depth : Nat → Nat}
    {nonlinearRate : Nat → Q'}
    (data :
      MatchedPhysicalBoundarySelfSmoothingPerronCrossTailRows
        family law spacing coupling halfExtent diagonalOrder
        bits depth nonlinearRate) :
    MatchedPhysicalHalfAmplitudeComputedFloorErrorRows
      (fun _ => EdgeLabelling)
      family law spacing coupling halfExtent diagonalOrder :=
  data.toCrossTailRows.toComputedFloorErrorRows

end MatchedPhysicalBoundarySelfSmoothingPerronCrossTailRows

end YMGap.Continuum.BF4PhysicalBoundarySelfSmoothingPerronCrossTail

