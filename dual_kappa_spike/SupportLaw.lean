/-- **Every kappa-odd certificate configuration is branched**
(kernel-checked): the anomaly lives on branched double covers. -/
theorem kappa_odd_all_branched :
    kappaOddConfigs.all hasBranch = true := by decide

/-- Sanity: branch edges do exist to be found — the detector is not
vacuous (the all-zero configuration is unbranched). -/
theorem detector_not_vacuous :
    hasBranch (List.replicate 24 0) = false := by decide

