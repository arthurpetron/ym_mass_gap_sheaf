/-
  SupportLaw.lean — the branch locus of the kappa anomaly,
  kernel-checked on a 100+100-config certificate.

  The support law (notes P7/P10; exhaustive at spins <= 2, 38,151
  admissible configs, moment-arbitrated):
    * every configuration in the 2-surface cone is POSITIVE
      (8,128/8,128);
    * every kappa-odd configuration (6,704/6,704) carries a BRANCH
      EDGE: an edge of the 4-cube boundary whose three incident face
      spins form the pattern {1,1,2} — the locus where a doubled
      sheet splits.  kappa lives on branched double covers.

  This file makes the branch DETECTOR itself a Lean function (from the
  literal edge-face incidence of the 4-cube boundary) and kernel-checks
  it on 100 kappa-odd sample configurations: every one is branched.
  The 100 decomposable samples are carried as data (their
  kappa-evenness is engine provenance; making kappa Lean-computable is
  the 6j wiring TODO shared with DualKappa.lean).

  Axiom budget: {propext, Quot.sound} at most.  No Mathlib.
-/

set_option maxHeartbeats 4000000
set_option maxRecDepth 10000

namespace SupportLaw

/-- Edge-face incidence of the 4-cube boundary: each of the 32
trivalent edges lists its three incident faces (0..23).  Literal
transport of `computations/kappa_system._EDGE_FACES`. -/
def edgeFaces : List (Nat × Nat × Nat) :=
  [ (0, 1, 2),
    (0, 3, 4),
    (1, 3, 5),
    (2, 4, 5),
    (2, 6, 7),
    (4, 6, 8),
    (5, 7, 8),
    (1, 9, 10),
    (3, 9, 11),
    (5, 10, 11),
    (7, 10, 12),
    (8, 11, 12),
    (0, 13, 14),
    (3, 13, 15),
    (4, 14, 15),
    (6, 14, 16),
    (8, 15, 16),
    (9, 13, 17),
    (11, 15, 17),
    (12, 16, 17),
    (0, 18, 19),
    (1, 18, 20),
    (2, 19, 20),
    (6, 19, 21),
    (7, 20, 21),
    (9, 18, 22),
    (10, 20, 22),
    (12, 21, 22),
    (13, 18, 23),
    (14, 19, 23),
    (16, 21, 23),
    (17, 22, 23) ]

def spinOf (spins : List Nat) (i : Nat) : Nat := spins.getD i 0

/-- An edge is a branch edge iff its incident spins form {1,1,2}.
For spins ≤ 2 this is equivalent to sum = 4 and product = 2. -/
def isBranch (spins : List Nat) : Nat × Nat × Nat → Bool
  | (f1, f2, f3) =>
    let a := spinOf spins f1
    let b := spinOf spins f2
    let c := spinOf spins f3
    (a + b + c == 4) && (a * b * c == 2)

def hasBranch (spins : List Nat) : Bool :=
  edgeFaces.any (isBranch spins)

