{
  "_comment": "Template: one Batch job per (beta,L) point, run as TASK_COUNT independent shards on Spot VMs. launch.sh substitutes the __PLACEHOLDERS__. Each shard checkpoints to the GCS mount, so Spot preemption -> Batch retry -> resume (not restart).",
  "taskGroups": [
    {
      "taskCount": __TASK_COUNT__,
      "parallelism": __PARALLELISM__,
      "taskCountPerNode": 1,
      "taskSpec": {
        "runnables": [
          { "container": { "imageUri": "__IMAGE_URI__" } }
        ],
        "environment": {
          "variables": {
            "OUT_DIR": "/mnt/disks/out",
            "POINT_ROW": "__POINT_ROW__",
            "TAG": "__TAG__",
            "CKPT_SECS": "300",
            "MEAS_OVERRIDE": "__MEAS_OVERRIDE__",
            "THERM_OVERRIDE": "__THERM_OVERRIDE__"
          }
        },
        "volumes": [
          { "gcs": { "remotePath": "__BUCKET_NAME__/runs" }, "mountPath": "/mnt/disks/out" }
        ],
        "computeResource": { "cpuMilli": __CPU_MILLI__, "memoryMib": __MEM_MIB__ },
        "maxRunDuration": "86400s",
        "maxRetryCount": 10
      }
    }
  ],
  "allocationPolicy": {
    "instances": [
      {
        "policy": {
          "machineType": "__MACHINE_TYPE__",
          "provisioningModel": "__PROVISIONING__",
          "bootDisk": { "type": "pd-standard", "sizeGb": 30 }
        }
      }
    ]__NETWORK_BLOCK__
  },
  "logsPolicy": { "destination": "CLOUD_LOGGING" }
}
