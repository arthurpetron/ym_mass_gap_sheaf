{
  "taskGroups": [
    {
      "taskCount": 2,
      "parallelism": 2,
      "taskCountPerNode": 1,
      "taskSpec": {
        "runnables": [
          { "container": { "imageUri": "IMAGE_URI" } }
        ],
        "environment": { "variables": { "OUT_DIR": "/mnt/disks/out", "ROW_OFFSET": "4" } },
        "volumes": [
          { "gcs": { "remotePath": "BUCKET_NAME/runs" }, "mountPath": "/mnt/disks/out" }
        ],
        "computeResource": { "cpuMilli": 60000, "memoryMib": 32768 },
        "maxRunDuration": "172800s",
        "maxRetryCount": 1
      }
    }
  ],
  "allocationPolicy": {
    "instances": [
      {
        "policy": {
          "machineType": "c2d-standard-60",
          "provisioningModel": "STANDARD"
        }
      }
    ]
  },
  "logsPolicy": { "destination": "CLOUD_LOGGING" }
}
