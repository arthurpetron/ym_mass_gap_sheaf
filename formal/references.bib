}

@article{Balaban1988convergent,
  author  = {Ba{\l}aban, Tadeusz},
  title   = {Convergent renormalization expansions for lattice gauge theories},
  journal = {Communications in Mathematical Physics},
  volume  = {119},
  number  = {2},
  pages   = {243--285},
  year    = {1988},
  publisher = {Springer},
  doi     = {10.1007/BF01217741},
  url     = {https://link.springer.com/article/10.1007/BF01217741},
  note    = {Inductive description of complete effective densities including
             large-field domains; establishes that RG transformations preserve
             density form.  Used as a shape source for the sigma-hat-transport
             polymer-residual factor in computations/sigma_hat_trajectory.py;
             the BALABAN_POLYMER_RESIDUAL = 2.0 value is HEURISTIC, NOT
             directly extracted.}
}

% =============================================================================
% Brydges-Federbush cluster-expansion convergence
% =============================================================================

@article{BrydgesFederbush1978,
  author  = {Brydges, David C. and Federbush, Paul},
  title   = {A new form of the {M}ayer expansion in classical statistical mechanics},
  journal = {Journal of Mathematical Physics},
  volume  = {19},
  number  = {10},
  pages   = {2064--2067},
  year    = {1978},
  month   = oct,
  publisher = {AIP Publishing},
  note    = {Polymer-cluster-expansion convergence theorem.  Source for the
             ``rho > log mu'' convergence threshold used as the basis for
             both K_sf (3.1) and K_lf (3.2) cluster-expansion residual
             bounds.  Directly used (in shape) by both small_field_kp.py
             and large_field_kp.py.}
}

