% block-spin-2cell.tikz
%
% The block-spin step T_b : I_k -> I_{k+1} with the four per-step
% budget conditions S1-S4, and the 2-cell Theta_k as a separate
% typed object on the S4 leg.
%
% To preview standalone:
%   pdflatex \
%     "\documentclass{standalone}\usepackage{tikz,amsmath,amssymb}\usetikzlibrary{positioning,arrows.meta,calc}\begin{document}\input{block-spin-2cell.tikz}\end{document}"
%
% Intended use: \input{visualizations/structure/block-spin-2cell.tikz}.

\begin{tikzpicture}[
    boxk/.style={
      draw=black!70, fill=blue!8, thick, rounded corners=4pt,
      inner sep=8pt, align=left, minimum width=5.4cm, minimum height=3.4cm,
    },
    boxnext/.style={
      draw=black!50, fill=gray!10, thick, rounded corners=4pt, dashed,
      inner sep=8pt, align=left, minimum width=5.4cm, minimum height=3.4cm,
    },
    boxtheta/.style={
      draw=purple!60!black, fill=purple!10, thick, rounded corners=4pt,
      inner sep=8pt, align=left, minimum width=6.5cm,
    },
    stepArr/.style={->, very thick, >=stealth, blue!60!black},
    thetaArr/.style={->, thick, >=stealth, purple!60!black, dashed},
  ]

  %==================================================================
  % Top row: I_k (left), I_{k+1} (right).  Spaced clearly apart with
  % a wide gap for the T_b arrow + label.
  %==================================================================
  \node[boxk] (Ik) at (0,0) {%
    \begin{minipage}{5.0cm}\raggedright
      {\bfseries $\mathcal{I}_k$}\;
      {\footnotesize\color{green!40!black}$\mathrm{Valid}_k$}\\[3pt]
      $k,\; g_k$\\
      $\widehat{\sigma}_k$\\
      $c^{\mathrm{sf}}_k = (\rho_{\mathrm{sf},k}, K_{\mathrm{sf},k})$\\
      $c^{\mathrm{lf}}_k = (\rho_{\mathrm{lf},k}, K_{\mathrm{lf},k})$\\
      $c^{\cap}_k = (\rho_{\cap,k}, K_{\cap,k})$\\
      $\mathcal{P}_k$
    \end{minipage}
  };

  \node[boxnext] (Ik1) at (10,0) {%
    \begin{minipage}{5.0cm}\raggedright
      {\bfseries $\mathcal{I}_{k+1}$}\;
      {\footnotesize\color{green!40!black}$\mathrm{Valid}_{k+1}$}\\[3pt]
      $k\!+\!1,\; g_{k+1}$\\
      $\widehat{\sigma}_{k+1}$\\
      $c^{\mathrm{sf}}_{k+1} = (\rho_{\mathrm{sf},k+1}, K_{\mathrm{sf},k+1})$\\
      $c^{\mathrm{lf}}_{k+1} = (\rho_{\mathrm{lf},k+1}, K_{\mathrm{lf},k+1})$\\
      $c^{\cap}_{k+1} = (\rho_{\cap,k+1}, K_{\cap,k+1})$\\
      $\mathcal{P}_{k+1}$
    \end{minipage}
  };

  %==================================================================
  % Step arrow between the two state boxes (T_b, block-spin step).
  %==================================================================
  \draw[stepArr] (Ik.east) -- (Ik1.west)
    node[font=\small, midway, above=4pt]{$T_b$ \;(block-spin step)};

  %==================================================================
  % Theta_k box centered below, well clear of the state boxes.
  %==================================================================
  \node[boxtheta] (Theta) at (5,-4.0) {%
    \begin{minipage}{6.2cm}\raggedright
      {\bfseries $\Theta_k$}\;
      {\footnotesize(separate typed object, S4 obligation)}\\[3pt]
      $\sigma_{\mathrm{in}} = \widehat{\sigma}_k$,\quad
      $\eta_k = \eta(b, g_k)$,\quad
      $\sigma_{\mathrm{out}} = \widehat{\sigma}_{k+1}$\\[2pt]
      {\footnotesize\color{purple!50!black}(S4)\;
       $\sigma_{\mathrm{in}} - \eta_k \le \sigma_{\mathrm{out}}$}
    \end{minipage}
  };

  % 2-cells: dashed curves from each state box's bottom-INNER corner
  % down to Theta's top corners.
  \draw[thetaArr] (Ik.south east) to[out=-70,in=160] (Theta.north west);
  \draw[thetaArr] (Ik1.south west) to[out=-110,in=20] (Theta.north east);

  %==================================================================
  % Per-step budget conditions S1-S3 as a clean text block at the
  % bottom, fully separated from the diagram above.
  %==================================================================
  \node[font=\footnotesize, text width=14cm, align=left,
        color=blue!50!black,
        below=12pt of Theta.south, anchor=north] {%
    \textbf{Per-step budget conditions} (each at scale $k$ via $(b, g_k)$):\quad
    (S1)\; $\rho_{\mathrm{sf},k+1} \ge \rho_{\mathrm{sf},k} - \varepsilon_{\mathrm{sf}}^k$,\quad
    (S2)\; $\rho_{\mathrm{lf},k+1} \ge \rho_{\mathrm{lf},k} - \varepsilon_{\mathrm{lf}}^k$,\quad
    (S3)\; $K_{\cap,k+1} \le K_{\cap,k} + \Delta_{\cap}^k$.
  };

\end{tikzpicture}
