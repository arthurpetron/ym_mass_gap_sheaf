% inductive-state.tikz
%
% The inductive state I_k as a labeled tuple, with an outgoing arrow
% to I_{k+1} labeled by the block-spin step T_b.
%
% To preview standalone:
%   pdflatex -shell-escape \
%     "\documentclass{standalone}\usepackage{tikz,amsmath,amssymb}\usetikzlibrary{positioning,arrows.meta}\begin{document}\input{inductive-state.tikz}\end{document}"
%
% Intended use: \input{visualizations/structure/inductive-state.tikz}.

\begin{tikzpicture}[
    boxk/.style={
      draw=black!70, fill=blue!8, thick, rounded corners=4pt,
      inner sep=8pt, align=left, minimum width=5.4cm,
    },
    boxnext/.style={
      draw=black!50, fill=gray!10, thick, rounded corners=4pt, dashed,
      inner sep=8pt, align=left, minimum width=5.4cm,
    },
    stepArrow/.style={->, very thick, >=stealth, blue!60!black},
  ]

  %==================================================================
  % I_k box (the current scale)
  %==================================================================
  \node[boxk] (Ik) at (0,0) {%
    \begin{minipage}{5.0cm}\raggedright
      {\bfseries $\mathcal{I}_k$ \;=\; state at scale $k$}\\[3pt]
      $k \in \mathbb{N}$\\
      $\widehat{\sigma}_k \in V$
        \,{\footnotesize\color{green!40!black}(V1: $>0$)}\\
      $g_k \in V$\\[2pt]
      $c^{\mathrm{sf}}_k = (\rho_{\mathrm{sf}}, K_{\mathrm{sf}}, \mathrm{sat})$\\
      $c^{\mathrm{lf}}_k = (\rho_{\mathrm{lf}}, K_{\mathrm{lf}}, \mathrm{sat})$\\
      $c^{\cap}_k\; = (\rho_{\cap}, K_{\cap}, \mathrm{sat})$\\
      {\footnotesize\color{green!40!black}V3:
        $\rho_{\cap} = \min(\rho_{\mathrm{sf}}, \rho_{\mathrm{lf}})$,\;
        $K_{\cap} \le K_{\mathrm{sf}} + K_{\mathrm{lf}}$}\\[2pt]
      $\mathcal{P}_k$
        \;{\footnotesize\itshape\color{green!40!black}(polymer atlas)}
    \end{minipage}
  };

  %==================================================================
  % I_{k+1} placeholder box at the next scale, well separated.
  %==================================================================
  \node[boxnext] (Ik1) at (10.5,0) {%
    \begin{minipage}{5.0cm}\raggedright
      {\bfseries $\mathcal{I}_{k+1}$ \;=\; state at scale $k\!+\!1$}\\[3pt]
      $k\!+\!1$\\
      $\widehat{\sigma}_{k+1} \ge \widehat{\sigma}_k - \eta(b, g_k)$
        \,{\footnotesize\color{blue!60!black}(S4)}\\
      $g_{k+1}$\\[2pt]
      $\rho_{\mathrm{sf}, k+1} \ge \rho_{\mathrm{sf}, k} - \varepsilon_{\mathrm{sf}}$
        \,{\footnotesize\color{blue!60!black}(S1)}\\
      $\rho_{\mathrm{lf}, k+1} \ge \rho_{\mathrm{lf}, k} - \varepsilon_{\mathrm{lf}}$
        \,{\footnotesize\color{blue!60!black}(S2)}\\
      $K_{\cap, k+1} \le K_{\cap, k} + \Delta_{\cap}$
        \,{\footnotesize\color{blue!60!black}(S3)}\\[2pt]
      $\mathcal{P}_{k+1}$
    \end{minipage}
  };

  %==================================================================
  % Step arrow: I_k -> I_{k+1}
  %==================================================================
  \draw[stepArrow] (Ik.east) -- (Ik1.west)
    node[font=\small, midway, above=3pt]
      {$T_b$ \;(block-spin step)}
    node[font=\footnotesize\itshape, midway, below=3pt, color=blue!60!black]
      {type only};

\end{tikzpicture}
